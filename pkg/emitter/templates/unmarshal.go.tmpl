{{define "unmarshal"}}
{{- $struct := . -}}
{{- $recv := receiverName .Name -}}

// UnmarshalJSON replaces {{$recv}} with the value the document holds. See
// decodeJSONAt.
func ({{$recv}} *{{$struct.Name}}) UnmarshalJSON(data []byte) error {
	_d, _sp, _err := jsonOpenDoc(data)
	if _err != nil {
		return jsonDecodeRefusal(_err)
	}
	return _d.finish({{$recv}}.decodeJSONAt(_d, _sp))
}

// decodeJSONAt decodes the value at _sp into {{$recv}}, in place, and hands each
// member's value to the member's own type in turn. See jsonDoc.
//
// The value is replaced, not merged into: whatever {{$recv}} held before is gone,
// so a value decoded twice is exactly the second document, as one decoded once
// would be. encoding/json's own decode merges -- a member the second document
// leaves out keeps what the first one put there -- and a value that reported one
// document's verdict while holding another's fields is what that left behind.
func ({{$recv}} *{{$struct.Name}}) decodeJSONAt(_d *jsonDoc, _sp jsonSpan) error {
	*{{$recv}} = {{$struct.Name}}{}
	{{- if $struct.NeedsDoc}}
	{{$recv}}._doc = _d
	{{- end}}
	{{- if $struct.StrictReadWrite}}
	{{- /* --strict-read-write's refusal is decided over the document's own bytes
	       and applied once the value is whole, rather than returned from the
	       middle of the decode.

	       Two things need that. The refusal has to win over whatever else the
	       document is wrong about -- a readOnly property written as null is
	       present, which is what the keyword is about, and the null rule must not
	       report first. And a Validate check that decodes raw JSON into this type
	       has to be able to ignore the refusal and still get a fully populated
	       value: readOnly is an annotation and constrains no document, so a
	       verdict that consulted one would answer a question the schema did not
	       ask. That was issue #219's middle group -- `patternProperties ^k: key
	       "k1": ro: read-only property may not be set` came back from Validate().

	       The refusal is recorded on the document rather than returned (see
	       jsonDoc.finish), so a nested type that raises one goes on decoding and
	       so does everything around it. See _decodeIgnoringReadOnly and
	       _accessRefuseReadOnly. */}}
	_bodyErr := func() error {
	{{- end}}
	{{- if $struct.NeedsNullCheck}}
	{{- /* A sentence about this value, with no name of its own in it: the
	       container that holds it is what knows the path, and puts it in front.
	       Naming the Go type here instead was what left an array element and a
	       map value reporting `null is not allowed for type T` -- a type the
	       caller never wrote and cannot find, in place of the position they can.
	       Issues #276 and #282. */}}
	if _d.isNull(_sp) {
		return jsonValueErrorf("null is not allowed")
	}
	{{- end}}
	{{- if $struct.RejectObject}}
	// The fields below describe the object this schema would admit, but its own
	// "type" admits no object at all, so no document reaches them. Refused here
	// rather than left to the constraints: an object decodes into the fields and
	// never reaches the non-object block, which is where the type is checked.
	if _d.data[_sp.start] == '{' {
		return jsonValueErrorf("object is not allowed")
	}
	{{- end}}
	{{- if $struct.AcceptNonObject}}
	// The schema admits a document that is not an object, so object constraints
	// are type-conditional. Non-object JSON data is accepted here and judged by
	// Validate; raw bytes are preserved for roundtrip.
	if _d.data[_sp.start] != '{' {
		{{$recv}}._nonObject = true
		{{$recv}}._rawNonObject = _d.keep(_sp)
		return nil
	}
	{{- end}}
	{{- if $struct.OneOfIsWholeValue}}
	{{- /* The union is the whole document, so there is no struct to decode it
	       into first -- and attempting one would refuse every scalar the schema
	       allows before a branch was tried. See OneOfIsWholeValue. */}}
	{{- else}}
	{{- /* A null decodes into no member at all, as it did through
	       encoding/json, and leaves the record of the document's keys empty
	       rather than absent: a value decoded from a null was decoded from
	       JSON, and its required members are missing. */}}
	switch _d.data[_sp.start] {
	case '{', 'n':
	default:
		return jsonDecodeRefusal(jsonTypeErrorFor(_d, _sp, (*{{$struct.Name}})(nil)))
	}
	// The object's members, by key. A key is matched exactly: JSON Schema
	// property names are case-sensitive, and "NAME" is not "name" -- it is an
	// additional property, and "name" is absent (issue #245). A key written
	// twice means its last value, as it does everywhere a document is read.
	_raw := make(map[string]jsonSpan)
	if _d.data[_sp.start] == '{' {
		_it := _d.iter(_sp)
		for {
			_k, _v, _ok := _it.member()
			if !_ok {
				break
			}
			_raw[_k] = _v
		}
	}
	{{- /* Each declared member is decoded by its own type, in the order the
	       schema declares them, and the first that refuses is the refusal: its
	       position is known, so the message names it (see jsonPathError), and a
	       document with two faults fails the same way every time. Issue #282. */}}
	{{- range $struct.Fields}}
	{{- if and (not .ManualJSON) .JSONName}}
	if _v, _ok := _raw[{{printf "%q" .JSONName}}]; _ok {
		{{- if .LeafDecode}}
		{{- if .LeafDecode.Integers}}
		// A number written 1.0 is the integer 1 from draft 6 on; the shadow is
		// what lets it through. A null leaves the field as it is.
		{{- end}}
		{{- if .LeafDecode.Numbers}}
		// A number held exactly is a json.Number, which is a string underneath
		// and would take a JSON string for a number; the shadow is what refuses
		// one. A null leaves the field as it is.
		{{- end}}
		{{- if .LeafDecode.DateTimes}}
		// A date-time may be spelled with a lower case "t" or "z", which RFC
		// 3339 permits and time.Time's parse layout refuses; the shadow is what
		// lets one through. A null leaves the field as it is.
		{{- end}}
		if !_d.isNull(_v) {
			var _iv {{goType .LeafDecode.ShadowType}}
			if _err := {{.MemberDecoder}}(&_iv, _d, _v); _err != nil {
				return jsonPathf(_err, "%s", {{printf "%q" .JSONName}})
			}
			{{$recv}}.{{.Name}} = {{.LeafDecode.Convert}}
		}
		{{- else}}
		if _err := {{.MemberDecoder}}(&{{$recv}}.{{.Name}}, _d, _v); _err != nil {
			return jsonPathf(_err, "%s", {{printf "%q" .JSONName}})
		}
		{{- end}}
	}
	{{- end}}
	{{- end}}
	{{- if hasManualFields $struct.Fields}}

	// Fields with JSON names that cannot be represented in struct tags. They are
	// decoded after every tagged member, which is the order they have always
	// been refused in.
	{{- range $struct.Fields}}
	{{- if .ManualJSON}}
	if _v, _ok := _raw[{{printf "%q" .JSONName}}]; _ok {
		{{- if .LeafDecode}}
		{{- if .LeafDecode.Integers}}
		// Decoded through the shadow for the reason the tagged members are: a
		// property name that cannot go in a struct tag is decoded by hand, but
		// its integers are the same integers.
		{{- end}}
		{{- if .LeafDecode.Numbers}}
		// Decoded through the shadow for the reason the tagged members are: a
		// property name that cannot go in a struct tag is decoded by hand, but
		// its numbers are the same numbers.
		{{- end}}
		{{- if .LeafDecode.DateTimes}}
		// Decoded through the shadow for the reason the tagged members are: a
		// property name that cannot go in a struct tag is decoded by hand, but
		// its date-times are the same date-times.
		{{- end}}
		var _iv {{goType .LeafDecode.ShadowType}}
		if _err := {{.ValueDecoder}}(&_iv, _d, _v); _err != nil {
			return jsonPathf(jsonDecodeRefusal(_err), "%s", {{printf "%q" .JSONName}})
		}
		{{$recv}}.{{.Name}} = {{.LeafDecode.Convert}}
		{{- else}}
		{{- /* Named by the property the document wrote rather than by the Go
		       field it lands in: this block exists precisely because that name
		       cannot be spelled in a struct tag, and `unmarshaling Root.AB1`
		       is a name the caller has no way to find. Issue #282. */}}
		if _err := {{.ValueDecoder}}(&{{$recv}}.{{.Name}}, _d, _v); _err != nil {
			return jsonPathf(jsonDecodeRefusal(_err), "%s", {{printf "%q" .JSONName}})
		}
		{{- end}}
	}
	{{- end}}
	{{- end}}
	{{- end}}
	{{- end}}
	{{- range $oof := $struct.OneOfs}}

	{
		{{- if $oof.IsProperty}}
		_ov, _has := _raw[{{printf "%q" $oof.JSONName}}]
		// Every refusal this union raises is a sentence about the value the union
		// holds, and the property that reaches it goes in front of that sentence
		// by the rule every other message is joined by (see jsonPathError).
		//
		// What used to go in front was a Go type and a Go field pasted in by hand:
		// {{$struct.Name}}.{{$oof.FieldName}}
		// A caller cannot find either in the document they sent, and at any depth
		// but the first the pair does not even resemble the path. Issue #289.
		oneofErrf := func(format string, args ...any) error {
			return jsonPathf(jsonValueErrorf(format, args...), "%s", {{printf "%q" $oof.JSONName}})
		}
		// oneofWrapf is oneofErrf for a sentence that ends with a branch's own
		// refusal, which is kept as a step of the message rather than written
		// into it (see jsonValueWrapf): at every level of a recursive document
		// that refuses at the bottom, each union puts its words in front of the
		// words of the one below it.
		oneofWrapf := func(err error, prefix string) error {
			return jsonPathf(jsonValueWrapf(err, prefix), "%s", {{printf "%q" $oof.JSONName}})
		}
		{{- else}}
		// Top-level oneOf: the entire JSON value is the variant data.
		_ov, _has := _sp, true
		// The union is the whole of this value, so it has no name of its own to
		// report under and its refusals are sentences about the value; whatever
		// contains it puts the path in front. Issue #289.
		oneofErrf := func(format string, args ...any) error {
			return jsonValueErrorf(format, args...)
		}
		// oneofWrapf is oneofErrf for a sentence that ends with a branch's own
		// refusal; see the property spelling above.
		oneofWrapf := jsonValueWrapf
		{{- end}}
		{{- if $oof.RejectNull}}
		// The schema behind this union excludes a JSON null, and the loop below
		// steps over one rather than judging it -- which at the top level, where
		// the union is the whole value and no parent check runs first, is an
		// acceptance. See OneOfDef.RejectNull.
		if _has && _d.isNull(_ov) {
			return oneofErrf("null is not allowed")
		}
		{{- end}}
		if _has && !_d.isNull(_ov) {
			{{- if $oof.HasDiscriminator}}
			// Discriminator-based dispatch on "{{$oof.DiscriminatorField}}"
			discVal, discErr := oneofDiscriminatorValue(_d, _ov, {{printf "%q" $oof.DiscriminatorField}})
			if discErr != nil {
				return oneofErrf("%w", discErr)
			}
			switch discVal {
			{{- range $i, $v := $oof.Variants}}
			{{- if $v.DiscriminatorValues}}
			case {{requiredFieldsList $v.DiscriminatorValues}}:
				var candidate {{goType $v.Type}}
				{{- if $v.LeafDecode}}
				var _iv {{goType $v.LeafDecode.ShadowType}}
				if err := {{$v.Decoder}}(&_iv, _d, _ov); err != nil {
					return oneofWrapf(err, "variant {{$v.FieldName}}: ")
				}
				candidate = {{$v.LeafDecode.Convert}}
				{{- else}}
				if err := {{$v.Decoder}}(&candidate, _d, _ov); err != nil {
					return oneofWrapf(err, "variant {{$v.FieldName}}: ")
				}
				{{- end}}
				{{$recv}}.{{$oof.FieldName}} = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
			{{- end}}
			{{- end}}
			default:
				{{- /* The property is named the way the document names it, and by the
				       same word the discriminator's own refusals next door use, so
				       one message does not carry two vocabularies: it used to read
				       `for field "kind"` behind a Go-spelled prefix. Passed as an
				       argument rather than pasted into the format string, so a name
				       carrying a quote cannot break the literal. Issue #289. */}}
				return oneofErrf("unknown discriminator value %s for property %q", _schemagenQuote(discVal), {{printf "%q" $oof.DiscriminatorField}})
			}
			{{- else}}
			var oneofMatched int
			var oneofLastErr error
			{{- if $oof.HasVariantChecks}}
			// A branch whose Go type accepted the value but whose own
			// constraints rejected it is the near miss worth reporting, so it
			// outranks a decode failure from a branch of some other type.
			var oneofCheckErr error
			{{- end}}
			{{- if $oof.HasValidatableVariants}}
			// A second tally: branches actually satisfied, not merely decoded.
			// An object branch keeps its constraints inside the variant type, so
			// two branches whose required keys are both present both decode even
			// when only one holds. oneofOpaque counts branches neither this
			// tally nor the checks above can speak for. Read once, below.
			var oneofStrict int
			var oneofOpaque int
			var oneofStrictSel {{$oof.InterfaceName}}
			var oneofStrictErr error
			{{- range $i, $v := $oof.Variants}}
			{{- if $v.Validatable}}
			// The candidate this branch decoded, held for the tally below. Its
			// Validate is asked only if more than one branch matched, which is
			// the only case the tally is read in: asked here, it was run over
			// the whole of the value at every level of a recursive document.
			var _vc{{$i}} {{goType $v.Type}}
			var _vcOK{{$i}} bool
			{{- end}}
			{{- end}}
			{{- end}}
			// Every branch below is a trial, and one that holds the value's
			// members as raw JSON takes views of the document rather than
			// copies of them; see jsonDoc.copyOf.
			_d.trial++
			{{- range $i, $v := $oof.Variants}}

			// Try variant: {{$v.FieldName}}
			{
				{{- if $v.RequiredFields}}
				if oneofHasRequiredFields(_d, _ov, {{requiredFieldsList $v.RequiredFields}}) {
				{{- end}}
					var candidate {{goType $v.Type}}
					{{- if $v.LeafDecode}}
					// Selection gates on whether the branch decodes, so an
					// integer branch has to read a number the same way the rest
					// of the file does -- otherwise a document this branch
					// accepts is reported as matching no branch at all.
					var _iv {{goType $v.LeafDecode.ShadowType}}
					{{- if $struct.StrictReadWrite}}
					_ivErr := jsonAttempt(_d, func() error { return {{$v.Decoder}}(&_iv, _d, _ov) })
					{{- else}}
					_ivErr := {{$v.Decoder}}(&_iv, _d, _ov)
					{{- end}}
					if _ivErr == nil {
						candidate = {{$v.LeafDecode.Convert}}
					}
					if err := _ivErr; err == nil {
					{{- else if $struct.StrictReadWrite}}
					if err := jsonAttempt(_d, func() error { return {{$v.Decoder}}(&candidate, _d, _ov) }); err == nil {
					{{- else}}
					if err := {{$v.Decoder}}(&candidate, _d, _ov); err == nil {
					{{- end}}
						{{- if $v.Checks}}
						// The branch's own constraints decide the match too: decoding
						// into the variant's Go type is not on its own a match.
						oneofOK := true
						{{- range $v.Checks}}
						{{- if eq .RuleType "minLength"}}
						if utf8.RuneCountInString(candidate) < {{countExpr .Value}} { oneofOK = false }
						{{- end}}
						{{- if eq .RuleType "maxLength"}}
						if utf8.RuneCountInString(candidate) > {{countExpr .Value}} { oneofOK = false }
						{{- end}}
						{{- if eq .RuleType "pattern"}}
						if _matched, _mErr := {{patternVar .Value}}.matches(string(candidate)); _mErr != nil {
							// With no verdict on this branch there is no
							// telling which one the document selects.
							_d.trial--
							return oneofErrf("oneOf: %w", _mErr)
						} else if !_matched {
							oneofOK = false
						}
						{{- end}}
						{{- if eq .RuleType "minimum"}}
						{{- if .ExactCompare}}
						if {{numOperand . "candidate"}} < {{numBound .}} { oneofOK = false }
						{{- else}}
						if float64(candidate) < {{countExpr .Value}} { oneofOK = false }
						{{- end}}
						{{- end}}
						{{- if eq .RuleType "maximum"}}
						{{- if .ExactCompare}}
						if {{numOperand . "candidate"}} > {{numBound .}} { oneofOK = false }
						{{- else}}
						if float64(candidate) > {{countExpr .Value}} { oneofOK = false }
						{{- end}}
						{{- end}}
						{{- if eq .RuleType "exclusiveMinimum"}}
						{{- if .ExactCompare}}
						if {{numOperand . "candidate"}} <= {{numBound .}} { oneofOK = false }
						{{- else}}
						if float64(candidate) <= {{countExpr .Value}} { oneofOK = false }
						{{- end}}
						{{- end}}
						{{- if eq .RuleType "exclusiveMaximum"}}
						{{- if .ExactCompare}}
						if {{numOperand . "candidate"}} >= {{numBound .}} { oneofOK = false }
						{{- else}}
						if float64(candidate) >= {{countExpr .Value}} { oneofOK = false }
						{{- end}}
						{{- end}}
						{{- if eq .RuleType "multipleOf"}}
						{{- if .ExactCompare}}
						if !{{exactMultipleOf . "candidate"}} { oneofOK = false }
						{{- else}}
						{
							_q := float64(candidate) / {{numLit .Value}}
							if math.Abs(_q - math.Round(_q)) > 1e-9 { oneofOK = false }
						}
						{{- end}}
						{{- end}}
						{{- if eq .RuleType "minItems"}}
						if len(candidate) < {{countExpr .Value}} { oneofOK = false }
						{{- end}}
						{{- if eq .RuleType "maxItems"}}
						if len(candidate) > {{countExpr .Value}} { oneofOK = false }
						{{- end}}
						{{- end}}
						if oneofOK {
							{{$recv}}.{{$oof.FieldName}} = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
							oneofMatched++
							{{- if $oof.HasValidatableVariants}}
							{{- if $v.FullyChecked}}
							oneofStrict++
							oneofStrictSel = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
							{{- else}}
							oneofOpaque++
							{{- end}}
							{{- end}}
						} else {
							oneofCheckErr = fmt.Errorf("variant {{$v.FieldName}}: value does not satisfy the variant's constraints")
						}
						{{- else}}
						{{$recv}}.{{$oof.FieldName}} = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
						oneofMatched++
						{{- if $oof.HasValidatableVariants}}
						{{- if $v.Validatable}}
						{{- if $v.Type.IsPointer}}
						if candidate != nil {
							_vc{{$i}}, _vcOK{{$i}} = candidate, true
						} else {
							oneofOpaque++
						}
						{{- else}}
						_vc{{$i}}, _vcOK{{$i}} = candidate, true
						{{- end}}
						{{- else if $v.FullyChecked}}
						// Nothing this branch says is left for a Validate to
						// carry, so matching it is satisfying it.
						oneofStrict++
						oneofStrictSel = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
						{{- else}}
						// This variant's type has no Validate and the branch
						// says more than selection tests, so the stricter tally
						// cannot speak for it.
						oneofOpaque++
						{{- end}}
						{{- end}}
						{{- end}}
					} else if _schemagenUndecided(err) {
						_d.trial--
						return oneofErrf("variant {{$v.FieldName}}: %w", err)
					} else {
						oneofLastErr = err
					}
				{{- if $v.RequiredFields}}
				}
				{{- end}}
			}
			{{- end}}
			_d.trial--

			if oneofMatched == 0 {
				{{- if $oof.HasVariantChecks}}
				if oneofCheckErr != nil {
					oneofLastErr = oneofCheckErr
				}
				{{- end}}
				// A branch is only put to a decode once the keys it selects on are
				// present, so a value that answers none of them leaves no branch
				// reason behind at all -- and the %w below then had nothing to
				// wrap and printed "%!w(<nil>)", which says nothing true about
				// anything. The refusal stands on its own in that case. Issue #289.
				if oneofLastErr == nil {
					return oneofErrf("no matching oneOf variant")
				}
				return oneofWrapf(oneofLastErr, "no matching oneOf variant: ")
			}
			{{- if $oof.HasValidatableVariants}}
			if oneofMatched > 1 && oneofOpaque == 0 {
				{{- range $i, $v := $oof.Variants}}
				{{- if $v.Validatable}}
				if _vcOK{{$i}} {
					if _vErr := _vc{{$i}}.Validate(); _vErr == nil {
						oneofStrict++
						oneofStrictSel = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: _vc{{$i}}}
					} else if _schemagenUndecided(_vErr) {
						// No verdict on this branch, so no telling which one
						// the document selects.
						return oneofErrf("variant {{$v.FieldName}}: %w", _vErr)
					} else {
						oneofStrictErr = jsonValueWrapf(_vErr, "variant {{$v.FieldName}}: ")
					}
				}
				{{- end}}
				{{- end}}
				// Several branches decoded and every one can be judged, so the
				// branches' own constraints settle which of them the value
				// really satisfies. Ambiguity is already a rejection here, so
				// this can only let through a document the schema allows.
				switch {
				case oneofStrict == 1:
					{{$recv}}.{{$oof.FieldName}} = oneofStrictSel
					oneofMatched = 1
				case oneofStrict > 1:
					oneofMatched = oneofStrict
				case oneofStrictErr != nil:
					// Not ambiguity but a value no branch accepts: report the
					// branch's own reason rather than a count.
					return oneofWrapf(oneofStrictErr, "no matching oneOf variant: ")
				}
			}
			{{- end}}
			if oneofMatched > 1 {
				return oneofErrf("multiple oneOf variants matched (%d), expected exactly 1", oneofMatched)
			}
			{{- end}}
		}
	}
	{{- end}}

	{{- if not $struct.OneOfIsWholeValue}}
	{{- if $struct.ReadOnlyKeys}}
	// --strict-read-write. The schema marks these "readOnly", which JSON
	// Schema section 9.4 says an owning authority is expected to ignore or
	// reject when an application sets them; this configuration rejects.
	//
	// A rejection here rather than in Validate is the whole of the
	// distinction. readOnly is an annotation in every draft that defines it
	// and constrains no document, so a Validate that refused one of these
	// would be answering a question the schema did not ask. Refusing to
	// *decode* is this program declining to accept input, which is the
	// caller's decision and is what the flag asked for.
	if _d.refusal == nil {
		for _, _roKey := range []string{
			{{- range $struct.ReadOnlyKeys}}
			{{printf "%q" .}},
			{{- end}}
		} {
			if _, ok := _raw[_roKey]; ok {
				_d.refusal = &_readOnlyRefusal{Path: _roKey}
				break
			}
		}
	}
	{{- end}}
	{{- if $struct.FlatNullNames}}
	// A property the schema gives a type to may not be written as null. By
	// the time the decode above has run there is nothing left to see: a null
	// leaves a nil pointer, a nil collection, or a scalar at its zero, which
	// is exactly what an absent property leaves, so the verdict has to be
	// taken from the document's own keys. See jsonNullRule for the nested
	// spelling of the same rule.
	for _, _nullKey := range []string{
		{{- range $struct.FlatNullNames}}
		{{printf "%q" .}},
		{{- end}}
	} {
		if _v, ok := _raw[_nullKey]; ok && _d.isNull(_v) {
			return jsonPathf(jsonValueErrorf("null is not allowed"), "%s", _nullKey)
		}
	}
	{{- end}}
	{{- range $struct.NestedNullChecks}}
	if _v, ok := _raw[{{printf "%q" .JSONName}}]; ok {
		if err := checkJSONNullsAt(_d, _v, {{template "nullrule" .}}); err != nil {
			return jsonPathf(err, "%s", {{printf "%q" .JSONName}})
		}
	}
	{{- end}}
	{{- if $struct.NeedsJSONKeys}}
	{{$recv}}._jsonKeys = make(map[string]bool, len(_raw))
	{{- /* maporder: fills a set; the same members end up in it in any order. */}}
	for _k := range _raw {
		{{$recv}}._jsonKeys[_k] = true
	}
	{{- end}}
	{{- if $struct.NeedsRawProps}}
	// The members a Validate check reads back as JSON. Each is a view of the
	// document's own copy rather than a copy of its own: at every depth of a
	// recursive document these hold the member below, and a copy each was the
	// whole subtree held once per level. See jsonDoc.keep.
	if _d.data[_sp.start] == '{' {
		{{$recv}}._jsonRawProps = make(map[string]json.RawMessage, len(_raw))
		{{- /* maporder: files each member under its own key, which are distinct. */}}
		for _k, _v := range _raw {
			{{$recv}}._jsonRawProps[_k] = _d.keep(_v)
		}
	}
	{{- end}}
	{{- if $struct.NeedsJSONNulls}}
	// The properties whose schema permits a null. The decode above has
	// already turned one into a nil pointer, a nil collection or an
	// untouched zero -- the same state an absent property leaves -- so the
	// document's own bytes are the only place the difference still exists.
	// Validate reads this to pass over the keywords a null satisfies
	// vacuously, and MarshalJSON to write the null back. See issue #110.
	for _, _nullKey := range []string{
		{{- range $struct.NullPresenceKeys}}
		{{printf "%q" .}},
		{{- end}}
	} {
		if _v, ok := _raw[_nullKey]; ok && _d.isNull(_v) {
			if {{$recv}}._jsonNulls == nil {
				{{$recv}}._jsonNulls = make(map[string]bool, 1)
			}
			{{$recv}}._jsonNulls[_nullKey] = true
		}
	}
	{{- end}}
	{{- if or $struct.AdditionalProperties $struct.HasPatternProperties}}
	{{- /* Where a member can be refused -- a null the schema forbids, a value
	       that does not decode, a key no pattern match could be decided for
	       -- in least-key terms rather than map order: the refusal is for
	       the least key, not for whichever member the randomised map order
	       reached first. See least_key_open. Where nothing can be refused
	       the loop only files each member under its own key, and stays a
	       plain loop. */}}
	{{- $refuses := or $struct.OverflowNullCheck (and $struct.AdditionalProperties (not (isRawMessage $struct.AdditionalProperties.ValueType))) $struct.HasPatternProperties}}
	{{- $lk := leastKey "rawKey" "rawVal" "_raw" "_failed"}}
	{{- if $refuses}}
	{{- template "least_key_open" $lk}}
	{{- else}}
	{{- /* maporder: files each member under its own key, which are distinct, and refuses none. */}}
	for rawKey, rawVal := range _raw {
	{{- end}}
		{{- /* Only parent-level properties are "known" for additionalProperties
		       routing when the struct tracks them: properties merged from allOf
		       sub-schemas are NOT known -- they must be routed to
		       additionalProperties per the JSON Schema spec (section 10.2). */}}
		{{- $known := $struct.KnownPropertyNames}}
		{{- if $known}}
		switch rawKey {
		case {{requiredFieldsList $known}}:
			{{if $refuses}}return nil{{else}}continue{{end}}
		}
		{{- end}}
		{{- if $struct.HasPatternProperties}}
		{{- /* Which bucket a member is filed in is itself a pattern match,
		       so a key no match could be decided for has nowhere to go:
		       the decode reports it rather than guessing. */}}
		matchesPattern := false
		{{- range $struct.PatternProperties}}
		if !matchesPattern {
			_ppMatched, _ppErr := {{patternVar .Pattern}}.matches(rawKey)
			if _ppErr != nil {
				return jsonElemPathf(jsonValueErrorf("%w", _ppErr), "[%s]", _schemagenQuote(rawKey))
			}
			matchesPattern = _ppMatched
		}
		{{- end}}
		if matchesPattern {
			if {{$recv}}.PatternProperties == nil {
				{{$recv}}.PatternProperties = make(map[string]json.RawMessage)
			}
			{{$recv}}.PatternProperties[rawKey] = _d.copyOf(rawVal)
			{{if $refuses}}return nil{{else}}continue{{end}}
		}
		{{- end}}
		{{- with $struct.OverflowNullCheck}}
		{{- /* A schema-valued additionalProperties governs every key that
		       reaches here, and the hand-written decode below cannot see a
		       null: json.Unmarshal of `null` into a string leaves "" and
		       reports no error at all. */}}
		{{- if .Nested}}
		if err := checkJSONNullsAt(_d, rawVal, {{template "nullrule" .}}); err != nil {
			return jsonElemPathf(err, "[%s]", _schemagenQuote(rawKey))
		}
		{{- else}}
		if _d.isNull(rawVal) {
			return jsonElemPathf(jsonValueErrorf("null is not allowed"), "[%s]", _schemagenQuote(rawKey))
		}
		{{- end}}
		{{- end}}
		{{- if $struct.AdditionalProperties}}
		if {{$recv}}.AdditionalProperties == nil {
			{{$recv}}.AdditionalProperties = make(map[string]{{goType $struct.AdditionalProperties.ValueType}})
		}
		{{- if isRawMessage $struct.AdditionalProperties.ValueType}}
		{{$recv}}.AdditionalProperties[rawKey] = _d.copyOf(rawVal)
		{{- else if $struct.AdditionalProperties.LeafDecode}}
		var _iv {{goType $struct.AdditionalProperties.LeafDecode.ShadowType}}
		if err := {{$struct.AdditionalProperties.ValueDecoder}}(&_iv, _d, rawVal); err != nil {
			return jsonElemPathf(jsonDecodeRefusal(err), "[%s]", _schemagenQuote(rawKey))
		}
		{{$recv}}.AdditionalProperties[rawKey] = {{$struct.AdditionalProperties.LeafDecode.Convert}}
		{{- else}}
		var val {{goType $struct.AdditionalProperties.ValueType}}
		if err := {{$struct.AdditionalProperties.ValueDecoder}}(&val, _d, rawVal); err != nil {
			return jsonElemPathf(jsonDecodeRefusal(err), "[%s]", _schemagenQuote(rawKey))
		}
		{{$recv}}.AdditionalProperties[rawKey] = val
		{{- end}}
		{{- end}}
	{{- if $refuses}}
		return nil
	{{- template "least_key_close" $lk}}
	{{- else}}
	}
	{{- end}}
	{{- end}}
	{{- end}}

	return nil
	{{- if $struct.StrictReadWrite}}
	}()
	{{- if $struct.AccessRules}}
	// The locations below this struct's own members, which no Go field answers
	// for: a tuple slot, a contains element, a patternProperties value. See
	// _accessRefuseReadOnly.
	if _d.refusal == nil {
		if _err := _accessRefuseReadOnly(_d, _sp, {{$struct.AccessRulesVar}}); _err != nil {
			_d.refusal = _err
		}
	}
	{{- end}}
	return _bodyErr
	{{- end}}
}
{{- end}}
