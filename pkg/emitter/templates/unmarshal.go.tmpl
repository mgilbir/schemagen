{{define "unmarshal"}}
{{- $struct := . -}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} *{{$struct.Name}}) UnmarshalJSON(data []byte) error {
	{{- if $struct.StrictReadWrite}}
	{{- /* --strict-read-write's refusal is decided over the document's own bytes
	       and applied once the value is whole, rather than returned from the
	       middle of the decode.

	       Two things need that. The refusal has to win over whatever else the
	       document is wrong about -- a readOnly property written as null is
	       present, which is what the keyword is about, and the null rule must not
	       report first. And a Validate check that decodes raw JSON into this type
	       has to be able to ignore the refusal and still get a fully populated
	       value: readOnly is an annotation and constrains no document, so a
	       verdict that consulted one would answer a question the schema did not
	       ask. That was issue #219's middle group -- `patternProperties ^k: key
	       "k1": ro: read-only property may not be set` came back from Validate().

	       See _decodeIgnoringReadOnly and _accessRefuseReadOnly. */}}
	var _roErr error
	_bodyErr := func() error {
	{{- end}}
	{{- /* Reset synthesized state first so reusing a value across Unmarshal
	       calls does not resurrect overflow maps, presence tracking, or the
	       sticky non-object flag from a previous document. */}}
	{{- if $struct.AdditionalProperties}}
	{{$recv}}.AdditionalProperties = nil
	{{- end}}
	{{- if $struct.HasPatternProperties}}
	{{$recv}}.PatternProperties = nil
	{{- end}}
	{{- if $struct.NeedsJSONKeys}}
	{{$recv}}._jsonKeys = nil
	{{- end}}
	{{- if $struct.NeedsRawProps}}
	{{$recv}}._jsonRawProps = nil
	{{- end}}
	{{- if $struct.NeedsJSONNulls}}
	{{$recv}}._jsonNulls = nil
	{{- end}}
	{{- if $struct.AcceptNonObject}}
	{{$recv}}._nonObject = false
	{{$recv}}._rawNonObject = nil
	{{- end}}
	{{- range $struct.OneOfs}}
	{{$recv}}.{{.FieldName}} = nil
	{{- end}}
	{{- if $struct.NeedsNullCheck}}
	if string(data) == "null" {
		return fmt.Errorf("null is not allowed for type {{$struct.Name}}")
	}
	{{- end}}
	{{- if $struct.AcceptNonObject}}
	// Schema has no explicit "type":"object" — object constraints are type-conditional.
	// Non-object JSON data is silently accepted; raw bytes are preserved for roundtrip.
	{{- if $struct.NeedsNullCheck}}
	if len(data) == 0 || (data[0] != '{' && string(data) != "null") {
	{{- else}}
	if len(data) == 0 || data[0] != '{' {
	{{- end}}
		{{$recv}}._nonObject = true
		{{$recv}}._rawNonObject = append({{$recv}}._rawNonObject[:0], data...)
		return nil
	}
	{{- end}}
	{{- if $struct.OneOfIsWholeValue}}
	{{- /* The union is the whole document, so there is no struct to decode it
	       into first -- and attempting one would refuse every scalar the schema
	       allows before a branch was tried. See OneOfIsWholeValue. */}}
	{{- else}}
	{{- if $struct.NeedsExactPropertyDecode}}
	// The decode below is handed the document cut down to the properties this
	// schema declares, because encoding/json matches a key that matches no field
	// exactly a second time case-insensitively, and would fill "name" from a
	// "NAME" the schema never gave it. See jsonExactProperties and issue #245.
	//
	// The object is parsed once here and read again by the blocks below, so this
	// costs no parse that was not already being paid. Its error is held rather
	// than returned, so that a document which is not an object is still refused
	// by the decode that always refused it, in the words it always used.
	var raw map[string]json.RawMessage
	_rawErr := json.Unmarshal(data, &raw)
	_decodeData := data
	if _rawErr == nil {
		if _exact := jsonExactProperties(raw,
			{{- range $struct.DecodeJSONNames}}
			{{printf "%q" .}},
			{{- end}}
		); _exact != nil {
			_decodeData = _exact
		}
	}
	{{- end}}
	type Alias {{$struct.Name}}
	aux := &struct {
		*Alias
		{{- range $struct.OneOfs}}
		{{- if .JSONName}}
		{{.FieldName}} json.RawMessage `json:"{{.JSONName}}"`
		{{- end}}
		{{- end}}
		{{- range $struct.Fields}}
		{{- if and .LeafDecode (not .ManualJSON)}}
		{{- /* Shadows the promoted field of the same name: an outer field wins
		       over an embedded one, so encoding/json fills this instead and the
		       declared int64, json.Number or time.Time is never the decode
		       destination. See jsonInteger, jsonNumber and jsonDateTime. */}}
		{{.Name}} *{{goType .LeafDecode.ShadowType}} `json:"{{.JSONName}}"`
		{{- end}}
		{{- end}}
	}{
		Alias: (*Alias)({{$recv}}),
	}

	if err := json.Unmarshal({{if $struct.NeedsExactPropertyDecode}}_decodeData{{else}}data{{end}}, aux); err != nil {
		{{- if $struct.StrictReadWrite}}
		// A refusal arriving from a nested type is held rather than returned.
		// encoding/json records an Unmarshaler's error and goes on filling the
		// rest of the value, so what is in hand here is complete; returning at
		// once would leave the presence maps unset and a Validate check reading
		// this value would under-enforce.
		if !_isReadOnlyRefusal(err) {
			return err
		}
		if _roErr == nil {
			_roErr = err
		}
		{{- else}}
		return err
		{{- end}}
	}
	{{- end}}
	{{- if $struct.HasLeafDecodes}}
	{{- if $struct.HasIntegerLeafDecodes}}

	// A number written 1.0 is the integer 1 from draft 6 on, and the shadows
	// above are what let encoding/json see it. Each outer pointer is nil when
	// the property was absent or null, both of which leave the field as it was.
	{{- end}}
	{{- if $struct.HasNumberLeafDecodes}}

	// A number held exactly is a json.Number, which is a string underneath and
	// would take a JSON string for a number; the shadows above are what refuse
	// one. Each outer pointer is nil when the property was absent or null, both
	// of which leave the field as it was.
	{{- end}}
	{{- if $struct.HasDateTimeLeafDecodes}}

	// A date-time may be spelled with a lower case "t" or "z", which RFC 3339
	// permits and time.Time's parse layout refuses; the shadows above are what
	// let encoding/json see one. Each outer pointer is nil when the property was
	// absent or null, both of which leave the field as it was.
	{{- end}}
	{{- range $struct.Fields}}
	{{- if and .LeafDecode (not .ManualJSON)}}
	if aux.{{.Name}} != nil {
		_iv := *aux.{{.Name}}
		{{$recv}}.{{.Name}} = {{.LeafDecode.Convert}}
	}
	{{- end}}
	{{- end}}
	{{- end}}
	{{- if hasManualFields $struct.Fields}}

	// Extract fields with JSON names that cannot be represented in struct tags.
	{
		{{- if $struct.NeedsExactPropertyDecode}}
		if _rawErr != nil {
			return _rawErr
		}
		{{- else}}
		var raw map[string]json.RawMessage
		if err := json.Unmarshal(data, &raw); err != nil {
			return err
		}
		{{- end}}
		{{- range $struct.Fields}}
		{{- if .ManualJSON}}
		if v, ok := raw[{{printf "%q" .JSONName}}]; ok {
			{{- if .LeafDecode}}
			{{- if .LeafDecode.Integers}}
			// Decoded through the shadow for the reason the aux fields above are:
			// a property name that cannot go in a struct tag is decoded by hand,
			// but its integers are the same integers.
			{{- end}}
			{{- if .LeafDecode.Numbers}}
			// Decoded through the shadow for the reason the aux fields above are:
			// a property name that cannot go in a struct tag is decoded by hand,
			// but its numbers are the same numbers.
			{{- end}}
			{{- if .LeafDecode.DateTimes}}
			// Decoded through the shadow for the reason the aux fields above are:
			// a property name that cannot go in a struct tag is decoded by hand,
			// but its date-times are the same date-times.
			{{- end}}
			var _iv {{goType .LeafDecode.ShadowType}}
			if err := json.Unmarshal(v, &_iv); err != nil {
				return fmt.Errorf("unmarshaling {{$struct.Name}}.{{.Name}}: %w", err)
			}
			{{$recv}}.{{.Name}} = {{.LeafDecode.Convert}}
			{{- else}}
			if err := json.Unmarshal(v, &{{$recv}}.{{.Name}}); err != nil {
				return fmt.Errorf("unmarshaling {{$struct.Name}}.{{.Name}}: %w", err)
			}
			{{- end}}
		}
		{{- end}}
		{{- end}}
	}
	{{- end}}
	{{- range $oof := $struct.OneOfs}}

	{
		{{- if $oof.JSONName}}
		oneofData := aux.{{$oof.FieldName}}
		{{- else}}
		// Top-level oneOf: the entire JSON object is the variant data.
		oneofData := json.RawMessage(data)
		{{- end}}
		{{- if $oof.RejectNull}}
		// The schema behind this union excludes a JSON null, and the loop below
		// steps over one rather than judging it -- which at the top level, where
		// the union is the whole value and no parent check runs first, is an
		// acceptance. See OneOfDef.RejectNull.
		if string(oneofData) == "null" {
			return fmt.Errorf("{{$struct.Name}}.{{$oof.FieldName}}: null is not allowed")
		}
		{{- end}}
		if len(oneofData) > 0 && string(oneofData) != "null" {
			{{- if $oof.HasDiscriminator}}
			// Discriminator-based dispatch on "{{$oof.DiscriminatorField}}"
			discVal, discErr := oneofDiscriminatorValue(oneofData, "{{$oof.DiscriminatorField}}")
			if discErr != nil {
				return fmt.Errorf("{{$struct.Name}}.{{$oof.FieldName}}: %w", discErr)
			}
			switch discVal {
			{{- range $i, $v := $oof.Variants}}
			{{- if $v.DiscriminatorValues}}
			case {{requiredFieldsList $v.DiscriminatorValues}}:
				var candidate {{goType $v.Type}}
				{{- if $v.LeafDecode}}
				var _iv {{goType $v.LeafDecode.ShadowType}}
				if err := json.Unmarshal(oneofData, &_iv); err != nil {
					return fmt.Errorf("{{$struct.Name}}.{{$oof.FieldName}} (variant {{$v.FieldName}}): %w", err)
				}
				candidate = {{$v.LeafDecode.Convert}}
				{{- else}}
				if err := json.Unmarshal(oneofData, &candidate); err != nil {
					return fmt.Errorf("{{$struct.Name}}.{{$oof.FieldName}} (variant {{$v.FieldName}}): %w", err)
				}
				{{- end}}
				{{$recv}}.{{$oof.FieldName}} = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
			{{- end}}
			{{- end}}
			default:
				return fmt.Errorf("{{$struct.Name}}.{{$oof.FieldName}}: unknown discriminator value %q for field \"{{$oof.DiscriminatorField}}\"", discVal)
			}
			{{- else}}
			var oneofMatched int
			var oneofLastErr error
			{{- if $oof.HasVariantChecks}}
			// A branch whose Go type accepted the value but whose own
			// constraints rejected it is the near miss worth reporting, so it
			// outranks a decode failure from a branch of some other type.
			var oneofCheckErr error
			{{- end}}
			{{- if $oof.HasValidatableVariants}}
			// A second tally: branches actually satisfied, not merely decoded.
			// An object branch keeps its constraints inside the variant type, so
			// two branches whose required keys are both present both decode even
			// when only one holds. oneofOpaque counts branches neither this
			// tally nor the checks above can speak for. Read once, below.
			var oneofStrict int
			var oneofOpaque int
			var oneofStrictSel {{$oof.InterfaceName}}
			var oneofStrictErr error
			{{- end}}
			{{- range $i, $v := $oof.Variants}}

			// Try variant: {{$v.FieldName}}
			{
				{{- if $v.RequiredFields}}
				if oneofHasRequiredFields(oneofData, {{requiredFieldsList $v.RequiredFields}}) {
				{{- end}}
					var candidate {{goType $v.Type}}
					{{- if $v.LeafDecode}}
					// Selection gates on whether the branch decodes, so an
					// integer branch has to read a number the same way the rest
					// of the file does -- otherwise a document this branch
					// accepts is reported as matching no branch at all.
					var _iv {{goType $v.LeafDecode.ShadowType}}
					_ivErr := json.Unmarshal(oneofData, &_iv)
					if _ivErr == nil {
						candidate = {{$v.LeafDecode.Convert}}
					}
					if err := _ivErr; err == nil {
					{{- else}}
					if err := json.Unmarshal(oneofData, &candidate); err == nil {
					{{- end}}
						{{- if $v.Checks}}
						// The branch's own constraints decide the match too: decoding
						// into the variant's Go type is not on its own a match.
						oneofOK := true
						{{- range $v.Checks}}
						{{- if eq .RuleType "minLength"}}
						if utf8.RuneCountInString(candidate) < {{.Value}} { oneofOK = false }
						{{- end}}
						{{- if eq .RuleType "maxLength"}}
						if utf8.RuneCountInString(candidate) > {{.Value}} { oneofOK = false }
						{{- end}}
						{{- if eq .RuleType "pattern"}}
						if matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, candidate); !matched { oneofOK = false }
						{{- end}}
						{{- if eq .RuleType "minimum"}}
						{{- if .ExactCompare}}
						if {{numOperand . "candidate"}} < {{numBound .}} { oneofOK = false }
						{{- else}}
						if float64(candidate) < {{.Value}} { oneofOK = false }
						{{- end}}
						{{- end}}
						{{- if eq .RuleType "maximum"}}
						{{- if .ExactCompare}}
						if {{numOperand . "candidate"}} > {{numBound .}} { oneofOK = false }
						{{- else}}
						if float64(candidate) > {{.Value}} { oneofOK = false }
						{{- end}}
						{{- end}}
						{{- if eq .RuleType "exclusiveMinimum"}}
						{{- if .ExactCompare}}
						if {{numOperand . "candidate"}} <= {{numBound .}} { oneofOK = false }
						{{- else}}
						if float64(candidate) <= {{.Value}} { oneofOK = false }
						{{- end}}
						{{- end}}
						{{- if eq .RuleType "exclusiveMaximum"}}
						{{- if .ExactCompare}}
						if {{numOperand . "candidate"}} >= {{numBound .}} { oneofOK = false }
						{{- else}}
						if float64(candidate) >= {{.Value}} { oneofOK = false }
						{{- end}}
						{{- end}}
						{{- if eq .RuleType "multipleOf"}}
						{{- if .ExactCompare}}
						if !{{exactMultipleOf . "candidate"}} { oneofOK = false }
						{{- else}}
						{
							_q := float64(candidate) / {{.Value}}
							if math.Abs(_q - math.Round(_q)) > 1e-9 { oneofOK = false }
						}
						{{- end}}
						{{- end}}
						{{- if eq .RuleType "minItems"}}
						if len(candidate) < {{.Value}} { oneofOK = false }
						{{- end}}
						{{- if eq .RuleType "maxItems"}}
						if len(candidate) > {{.Value}} { oneofOK = false }
						{{- end}}
						{{- end}}
						if oneofOK {
							{{$recv}}.{{$oof.FieldName}} = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
							oneofMatched++
							{{- if $oof.HasValidatableVariants}}
							{{- if $v.FullyChecked}}
							oneofStrict++
							oneofStrictSel = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
							{{- else}}
							oneofOpaque++
							{{- end}}
							{{- end}}
						} else {
							oneofCheckErr = fmt.Errorf("variant {{$v.FieldName}}: value does not satisfy the variant's constraints")
						}
						{{- else}}
						{{$recv}}.{{$oof.FieldName}} = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
						oneofMatched++
						{{- if $oof.HasValidatableVariants}}
						{{- if $v.Validatable}}
						{{- if $v.Type.IsPointer}}
						if candidate != nil {
							if _vErr := candidate.Validate(); _vErr == nil {
								oneofStrict++
								oneofStrictSel = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
							} else {
								oneofStrictErr = fmt.Errorf("variant {{$v.FieldName}}: %w", _vErr)
							}
						} else {
							oneofOpaque++
						}
						{{- else}}
						if _vErr := candidate.Validate(); _vErr == nil {
							oneofStrict++
							oneofStrictSel = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
						} else {
							oneofStrictErr = fmt.Errorf("variant {{$v.FieldName}}: %w", _vErr)
						}
						{{- end}}
						{{- else if $v.FullyChecked}}
						// Nothing this branch says is left for a Validate to
						// carry, so matching it is satisfying it.
						oneofStrict++
						oneofStrictSel = &{{$v.WrapperName}}{{"{"}}{{$v.FieldName}}: candidate}
						{{- else}}
						// This variant's type has no Validate and the branch
						// says more than selection tests, so the stricter tally
						// cannot speak for it.
						oneofOpaque++
						{{- end}}
						{{- end}}
						{{- end}}
					} else {
						oneofLastErr = err
					}
				{{- if $v.RequiredFields}}
				}
				{{- end}}
			}
			{{- end}}

			if oneofMatched == 0 {
				{{- if $oof.HasVariantChecks}}
				if oneofCheckErr != nil {
					oneofLastErr = oneofCheckErr
				}
				{{- end}}
				return fmt.Errorf("{{$struct.Name}}.{{$oof.FieldName}}: no matching oneOf variant: %w", oneofLastErr)
			}
			{{- if $oof.HasValidatableVariants}}
			if oneofMatched > 1 && oneofOpaque == 0 {
				// Several branches decoded and every one can be judged, so the
				// branches' own constraints settle which of them the value
				// really satisfies. Ambiguity is already a rejection here, so
				// this can only let through a document the schema allows.
				switch {
				case oneofStrict == 1:
					{{$recv}}.{{$oof.FieldName}} = oneofStrictSel
					oneofMatched = 1
				case oneofStrict > 1:
					oneofMatched = oneofStrict
				case oneofStrictErr != nil:
					// Not ambiguity but a value no branch accepts: report the
					// branch's own reason rather than a count.
					return fmt.Errorf("{{$struct.Name}}.{{$oof.FieldName}}: no matching oneOf variant: %w", oneofStrictErr)
				}
			}
			{{- end}}
			if oneofMatched > 1 {
				return fmt.Errorf("{{$struct.Name}}.{{$oof.FieldName}}: multiple oneOf variants matched (%d), expected exactly 1", oneofMatched)
			}
			{{- end}}
		}
	}
	{{- end}}

	{{- if or $struct.AdditionalProperties $struct.HasPatternProperties $struct.HasRequiredFields $struct.NeedsJSONKeys $struct.NeedsRawProps $struct.HasNullChecks $struct.NeedsJSONNulls $struct.ReadOnlyKeys}}
	{
		{{- if $struct.NeedsExactPropertyDecode}}
		if _rawErr != nil {
			return _rawErr
		}
		{{- else}}
		var raw map[string]json.RawMessage
		if err := json.Unmarshal(data, &raw); err != nil {
			return err
		}
		{{- end}}
		{{- if $struct.ReadOnlyKeys}}
		// --strict-read-write. The schema marks these "readOnly", which JSON
		// Schema section 9.4 says an owning authority is expected to ignore or
		// reject when an application sets them; this configuration rejects.
		//
		// A rejection here rather than in Validate is the whole of the
		// distinction. readOnly is an annotation in every draft that defines it
		// and constrains no document, so a Validate that refused one of these
		// would be answering a question the schema did not ask. Refusing to
		// *decode* is this program declining to accept input, which is the
		// caller's decision and is what the flag asked for.
		for _, _roKey := range []string{
			{{- range $struct.ReadOnlyKeys}}
			{{printf "%q" .}},
			{{- end}}
		} {
			if _, ok := raw[_roKey]; ok {
				if _roErr == nil {
					_roErr = &_readOnlyRefusal{Path: _roKey}
				}
				break
			}
		}
		{{- end}}
		{{- if $struct.FlatNullNames}}
		// A property the schema gives a type to may not be written as null. By
		// the time the decode above has run there is nothing left to see: a null
		// leaves a nil pointer, a nil collection, or a scalar at its zero, which
		// is exactly what an absent property leaves, so the verdict has to be
		// taken from the document's own keys. See jsonNullRule for the nested
		// spelling of the same rule.
		for _, _nullKey := range []string{
			{{- range $struct.FlatNullNames}}
			{{printf "%q" .}},
			{{- end}}
		} {
			if _v, ok := raw[_nullKey]; ok && string(_v) == "null" {
				return fmt.Errorf("%s: null is not allowed", _nullKey)
			}
		}
		{{- end}}
		{{- range $struct.NestedNullChecks}}
		if _v, ok := raw[{{printf "%q" .JSONName}}]; ok {
			if err := checkJSONNulls(_v, {{printf "%q" .JSONName}}, {{template "nullrule" .}}); err != nil {
				return err
			}
		}
		{{- end}}
		{{- if $struct.NeedsJSONKeys}}
		{{$recv}}._jsonKeys = make(map[string]bool, len(raw))
		for _k := range raw {
			{{$recv}}._jsonKeys[_k] = true
		}
		{{- end}}
		{{- if $struct.NeedsRawProps}}
		{{$recv}}._jsonRawProps = raw
		{{- end}}
		{{- if $struct.NeedsJSONNulls}}
		// The properties whose schema permits a null. The decode above has
		// already turned one into a nil pointer, a nil collection or an
		// untouched zero -- the same state an absent property leaves -- so the
		// document's own bytes are the only place the difference still exists.
		// Validate reads this to pass over the keywords a null satisfies
		// vacuously, and MarshalJSON to write the null back. See issue #110.
		for _, _nullKey := range []string{
			{{- range $struct.NullPresenceKeys}}
			{{printf "%q" .}},
			{{- end}}
		} {
			if _v, ok := raw[_nullKey]; ok && string(_v) == "null" {
				if {{$recv}}._jsonNulls == nil {
					{{$recv}}._jsonNulls = make(map[string]bool, 1)
				}
				{{$recv}}._jsonNulls[_nullKey] = true
			}
		}
		{{- end}}
		{{- if or $struct.AdditionalProperties $struct.HasPatternProperties}}
		knownFields := map[string]bool{
			{{- if $struct.HasOwnPropertyNames}}
			{{- /* Only parent-level properties are "known" for additionalProperties routing.
			       Properties merged from allOf sub-schemas are NOT known — they must be
			       routed to additionalProperties per the JSON Schema spec (section 10.2). */}}
			{{- range $struct.OwnPropertyNames}}
			{{printf "%q" .}}: true,
			{{- end}}
			{{- else}}
			{{- range $struct.Fields}}
			{{printf "%q" .JSONName}}: true,
			{{- end}}
			{{- end}}
			{{- range $struct.OneOfs}}
			{{- if .JSONName}}
			{{printf "%q" .JSONName}}: true,
			{{- end}}
			{{- end}}
		}
		{{- if $struct.HasPatternProperties}}
		patternRegexps := []*ecma262.Regexp{
			{{- range $struct.PatternProperties}}
			ecma262.MustCompile({{ecmaPattern .Pattern}}, ecmaflags.Unicode),
			{{- end}}
		}
		{{- end}}
		for rawKey, rawVal := range raw {
			if knownFields[rawKey] {
				continue
			}
			{{- if $struct.HasPatternProperties}}
			matchesPattern := false
			for _, re := range patternRegexps {
				if re.MatchString(rawKey) {
					matchesPattern = true
					break
				}
			}
			if matchesPattern {
				if {{$recv}}.PatternProperties == nil {
					{{$recv}}.PatternProperties = make(map[string]json.RawMessage)
				}
				{{$recv}}.PatternProperties[rawKey] = rawVal
				continue
			}
			{{- end}}
			{{- with $struct.OverflowNullCheck}}
			{{- /* A schema-valued additionalProperties governs every key that
			       reaches here, and the hand-written decode below cannot see a
			       null: json.Unmarshal of `null` into a string leaves "" and
			       reports no error at all. */}}
			{{- if .Nested}}
			if err := checkJSONNulls(rawVal, fmt.Sprintf("additionalProperties[%q]", rawKey), {{template "nullrule" .}}); err != nil {
				return err
			}
			{{- else}}
