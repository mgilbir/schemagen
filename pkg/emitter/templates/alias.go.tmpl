{{define "alias"}}
{{- template "type_doc" .}}
{{- if .Unenforced}}
// {{.Name}} is NOT VALIDATED, and its schema does state constraints:
//	{{.Unenforced}}
//
// schemagen could not compile those into a check it could carry here. The
// underlying type is an interface, Go forbids methods on those, so this type has
// no Validate method and json.Unmarshal into it cannot fail -- every document
// reaches your code unexamined, including the ones the schema forbids.
{{- end}}
{{- template "annotation_comment" mkAnnotationCtx .Annotations "" (or .HasProse (ne .Unenforced ""))}}
type {{.Name}} {{goType .Underlying}}
{{- if and .CanHaveMethods .DecodeAt}}
{{template "alias_decode_at" .}}
{{- else if and .CanHaveMethods (or .NeedsNullCheck .IsIntegerType .UnmarshalAs .LeafDecode .NullCheck)}}
{{template "alias_unmarshal" .}}
{{- end}}
{{- if and .CanHaveMethods .MarshalAs}}
{{template "alias_marshal" .}}
{{- end}}
{{- if and .CanHaveMethods .EncodeTo}}
{{template "alias_encode" .}}
{{- end}}
{{- if and .CanHaveMethods .HasIdentity}}
{{template "alias_identity" .}}
{{- end}}
{{- if .CanHaveMethods}}
{{template "alias_validate" .}}
{{- end}}
{{- end}}

{{define "alias_unmarshal"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	{{- /* Replaced rather than merged into, as every generated type is: a
	       document refused below leaves the zero value, not the one before. */}}
	var _zero {{.Name}}
	*{{$recv}} = _zero
	{{- if .NeedsNullCheck}}
	if string(data) == "null" {
		return jsonValueErrorf("null is not allowed")
	}
	{{- end}}
	{{- with .NullCheck}}
	{{- /* The elements this container holds. The check above answers for the
	       container itself; a null *inside* one is erased by the decode below --
	       []string turns [null] into [""] and reports nothing. A container
	       alias decodes in place (see alias_decode_at) and makes this check
	       there; this arm is for a shape that reaches it here all the same. */}}
	if _d, _sp, _err := jsonOpenDoc(data); _err != nil {
		return jsonDecodeRefusal(_err)
	} else if _err := checkJSONNullsAt(_d, _sp, {{template "nullrule" .}}); _err != nil {
		return _err
	}
	{{- end}}
	{{- if .UnmarshalAs}}
	var _target {{.UnmarshalAs}}
	if _err := json.Unmarshal(data, &_target); _err != nil {
		return jsonDecodeRefusal(_err)
	}
	*{{$recv}} = {{.Name}}(_target)
	return nil
	{{- else if .LeafDecode}}
	{{- if .LeafDecode.Integers}}
	// A named container of integers. Decoding through the shadow is what lets a
	// number written 1.0 reach the int64 the schema asked for -- encoding/json
	// decides from the destination type, and []int64 refuses it outright.
	{{- end}}
	{{- if .LeafDecode.Numbers}}
	// A named container of numbers held exactly. Decoding through the shadow is
	// what keeps a JSON string out of one -- encoding/json decides from the
	// destination type, and json.Number is a string underneath, so
	// []json.Number would take ["1.5"] for a list of numbers.
	{{- end}}
	{{- if .LeafDecode.DateTimes}}
	// A named container of date-times. Decoding through the shadow is what lets
	// the lower case spelling RFC 3339 permits reach a time.Time -- encoding/json
	// decides from the destination type, and []time.Time refuses
	// ["2020-01-02t03:04:05z"] outright.
	{{- end}}
	var _iv {{goType .LeafDecode.ShadowType}}
	if _err := json.Unmarshal(data, &_iv); _err != nil {
		return jsonDecodeRefusal(_err)
	}
	*{{$recv}} = {{.LeafDecode.Convert}}
	return nil
	{{- else if .IsIntegerType}}
	// Use json.Number to accept 1.0 as a valid integer (zero fractional part).
	// Reject JSON strings (e.g., "1") — json.Number would accept them since it is a string type.
	if len(data) > 0 && data[0] == '"' {
		return jsonValueErrorf("expected integer, got string")
	}
	var _n json.Number
	if _err := json.Unmarshal(data, &_n); _err != nil {
		return jsonDecodeRefusal(_err)
	}
	if _i, _iErr := _n.Int64(); _iErr == nil {
		*{{$recv}} = {{.Name}}(_i)
		return nil
	}
	{{- if .StrictInteger}}
	return jsonValueErrorf("value %s cannot be held as an integer", _n.String())
	{{- end}}
	// Float notation with nothing after the point (1.0, 1e2), read exactly.
	// See jsonIntegerFromLiteral: float64 holds 2^63 and 2^63-1 as one number,
	// so it cannot be asked whether a literal is an int64.
	if _i, _iOK := jsonIntegerFromLiteral(_n.String()); _iOK {
		*{{$recv}} = {{.Name}}(_i)
		return nil
	}
	return jsonValueErrorf("value %s cannot be held as an integer", _n.String())
	{{- else}}
	{{- /* The refusal is read for the schema's words before it leaves. What
	       encoding/json writes here names the shadow: `cannot unmarshal object
	       into Go value of type p.Alias` -- a type that exists for four lines
	       inside this function, qualified by whichever package the caller
	       generated into. Issue #282. */}}
	type Alias {{.Name}}
	return jsonDecodeRefusal(json.Unmarshal(data, (*Alias)({{$recv}})))
	{{- end}}
}
{{- end}}

{{/*
alias_decode_at is the decode of an alias whose value is a struct, a raw-JSON
wrapper, a slice or a map: in place, over a span of one indexed document, like
every type that can hold another of this package's types (see jsonDoc and
decodeplan.go). The arms are alias_unmarshal's, in its order, and refuse in its
words; the decode under them is composed rather than handed to encoding/json.
*/}}
{{define "alias_decode_at"}}
{{- $recv := receiverName .Name -}}
{{- if and .NeedsNullCheck (not .NullCheck) (not .UnmarshalAs) (not .LeafDecode) (not .UnderlyingDecoder)}}
{{- /* encoding/json decodes the whole value, and the one arm of the alias's
       own is its null. decodeJSONAt below says so over a span; handed the
       document itself, there is nothing to index -- json.Unmarshal checks the
       bytes and refuses what is not JSON in the words jsonOpenDoc would -- so
       the entry decodes without opening one, and costs what it did before
       the in-place decode. */}}

// UnmarshalJSON replaces {{$recv}} with the value the document holds.
func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	var _zero {{.Name}}
	*{{$recv}} = _zero
	if jsonIsNullDocument(data) {
		return jsonValueErrorf("null is not allowed")
	}
	type Alias {{.Name}}
	return jsonDecodeRefusal(json.Unmarshal(data, (*Alias)({{$recv}})))
}
{{- else}}

// UnmarshalJSON replaces {{$recv}} with the value the document holds. See
// decodeJSONAt.
func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	_d, _sp, _err := jsonOpenDoc(data)
	if _err != nil {
		return jsonDecodeRefusal(_err)
	}
	return _d.finish({{$recv}}.decodeJSONAt(_d, _sp))
}
{{- end}}

// decodeJSONAt decodes the value at _sp into {{$recv}}, in place. The value is
// replaced rather than merged into: a slice is decoded into an array of its
// own rather than over the one {{$recv}} held, which a copy of the value made
// earlier still shares, and a map loses the members an earlier document gave
// it.
func ({{$recv}} *{{.Name}}) decodeJSONAt(_d *jsonDoc, _sp jsonSpan) error {
	var _zero {{.Name}}
	*{{$recv}} = _zero
	{{- if .NeedsNullCheck}}
	if _d.isNull(_sp) {
		return jsonValueErrorf("null is not allowed")
	}
	{{- end}}
	{{- with .NullCheck}}
	{{- /* The elements this container holds. The check above answers for the
	       container itself; a null *inside* one is erased by the decode below --
	       []string turns [null] into [""] and reports nothing. */}}
	if _err := checkJSONNullsAt(_d, _sp, {{template "nullrule" .}}); _err != nil {
		return _err
	}
	{{- end}}
	{{- if .UnmarshalAs}}
	var _target {{.UnmarshalAs}}
	if _err := {{.UnmarshalAsDecoder}}(&_target, _d, _sp); _err != nil {
		return jsonDecodeRefusal(_err)
	}
	*{{$recv}} = {{.Name}}(_target)
	return nil
	{{- else if .LeafDecode}}
	{{- if .LeafDecode.Integers}}
	// A named container of integers. Decoding through the shadow is what lets a
	// number written 1.0 reach the int64 the schema asked for -- encoding/json
	// decides from the destination type, and []int64 refuses it outright.
	{{- end}}
	{{- if .LeafDecode.Numbers}}
	// A named container of numbers held exactly. Decoding through the shadow is
	// what keeps a JSON string out of one -- encoding/json decides from the
	// destination type, and json.Number is a string underneath, so
	// []json.Number would take ["1.5"] for a list of numbers.
	{{- end}}
	{{- if .LeafDecode.DateTimes}}
	// A named container of date-times. Decoding through the shadow is what lets
	// the lower case spelling RFC 3339 permits reach a time.Time -- encoding/json
	// decides from the destination type, and []time.Time refuses
	// ["2020-01-02t03:04:05z"] outright.
	{{- end}}
	var _iv {{goType .LeafDecode.ShadowType}}
	if _err := jsonAtJSON(&_iv, _d, _sp); _err != nil {
		return jsonDecodeRefusal(_err)
	}
	*{{$recv}} = {{.LeafDecode.Convert}}
	return nil
	{{- else if or .NeedsNullCheck .NullCheck}}
	{{- /* The refusal is read for the schema's words before it leaves, as it is
	       where the alias decodes through encoding/json. Issue #282. */}}
	{{- if .UnderlyingDecoder}}
	return jsonDecodeRefusal({{.UnderlyingDecoder}}({{$recv}}, _d, _sp))
	{{- else}}
	{{- /* Nothing under the value decodes in place, so encoding/json decodes it
	       whole, into a type that has none of this one's methods. */}}
	type Alias {{.Name}}
	{{- if .LazyItems}}
	return jsonDecodeRefusal(jsonLazyItemsOr[Alias]((*Alias)({{$recv}}), _d, _sp, jsonAtJSON[Alias]))
	{{- else}}
	return jsonDecodeRefusal(jsonAtJSON[Alias]((*Alias)({{$recv}}), _d, _sp))
	{{- end}}
	{{- end}}
	{{- else}}
	{{- /* No arm of its own to answer for, so the refusal is the one
	       encoding/json gives for the underlying type, as it was when
	       encoding/json decoded the alias: a container reads it for the schema's
	       words, and a oneOf branch reports it as it stands. */}}
	{{- if .UnderlyingDecoder}}
	return {{.UnderlyingDecoder}}({{$recv}}, _d, _sp)
	{{- else}}
	{{- /* Nothing under the value decodes in place, so encoding/json decodes it
	       whole, into a type that has none of this one's methods. A value of
	       the wrong kind is refused first, under this type's own name, which is
	       the one encoding/json named when it decoded into this type directly. */}}
	if _err := jsonKindError[{{.Name}}](_d, _sp); _err != nil {
		return _err
	}
	type Alias {{.Name}}
	{{- if .LazyItems}}
	return jsonLazyItemsOr[Alias]((*Alias)({{$recv}}), _d, _sp, jsonAtJSON[Alias])
	{{- else}}
	return jsonAtJSON[Alias]((*Alias)({{$recv}}), _d, _sp)
	{{- end}}
	{{- end}}
	{{- end}}
}
{{- end}}

{{define "alias_marshal"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} {{.Name}}) MarshalJSON() ([]byte, error) {
	{{- if .EncodeTo}}
	_b, _err := {{$recv}}.appendJSON(nil)
	if _err != nil {
		return nil, _err
	}
	return _b, nil
	{{- else}}
	return json.Marshal({{.MarshalAs}}({{$recv}}))
	{{- end}}
}
{{- end}}

{{/*
alias_format_check emits a "format" assertion against the alias's own value.

It dispatches to the same shared helper the struct-field arm and the untyped
wrapper use, so the three positions cannot disagree about what a format means.
They did once: the rule reached this template's Validations and there was no arm
to emit it, so `type V4 netip.Addr` and `type Email string` both validated to
`return nil` while the identical schema inlined as a property was checked.

Which conversion is legal is settled before emission by aliasFormatCheckable:
the rule survives only for an alias whose underlying type is a string, since
that is the only shape the helpers take. An alias over netip.Addr or time.Time
was already refused at decode by anything the parser rejects, and the rule is
dropped there rather than emitted as a check that cannot fail.
*/}}
{{define "alias_format_check"}}
{{- $recv := .Recv}}
{{- template "string_format_check" (mkStringFormatCtx (formatValueExpr $recv .StringBacked) "" .Value .StringBacked)}}
{{- end}}

{{define "alias_validate"}}
{{- $recv := receiverName .Name -}}

// Validate checks {{.Name}} against its JSON Schema constraints.
{{- if .ValidateIn}}
func ({{$recv}} {{.Name}}) Validate() error { return {{$recv}}.validateIn(nil) }

// validateIn is Validate, sharing _vc with the values below it: the element
// identities a uniqueItems check keeps. See jsonValidation.
func ({{$recv}} {{.Name}}) validateIn(_vc *jsonValidation) error {
{{- else}}
func ({{$recv}} {{.Name}}) Validate() error {
{{- end}}
	{{- if .ValidateAs}}
	// Returned as it stands: the type this delegates to answers for the very same
	// value, so there is no step of path between the two and nothing to put in
	// front of its message. Wrapping it also lost what the message had recorded
	// about how a container must join it. See issue #279.
	if _err := ({{.ValidateAs}}({{$recv}})).{{if .ValidateAsIn}}validateIn(_vc){{else}}Validate(){{end}}; _err != nil {
		return _err
	}
	{{- end}}
	{{- range .Validations}}
	{{- if eq .RuleType "minLength"}}
	if utf8.RuneCountInString(string({{$recv}})) < {{countExpr .Value}} {
		return jsonValueErrorf("length %d is less than minimum {{fmtText .Value}}", utf8.RuneCountInString(string({{$recv}})))
	}
	{{- end}}
	{{- if eq .RuleType "maxLength"}}
	if utf8.RuneCountInString(string({{$recv}})) > {{countExpr .Value}} {
		return jsonValueErrorf("length %d exceeds maximum {{fmtText .Value}}", utf8.RuneCountInString(string({{$recv}})))
	}
	{{- end}}
	{{- /* The numeric keywords, written for the Go type the alias holds its
	       number as; see numViolatedFunc. */}}
	{{- if eq .RuleType "minimum"}}
	if {{numViolated . $recv}} {
		return jsonValueErrorf("%v is less than minimum {{numBoundMsg .}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "maximum"}}
	if {{numViolated . $recv}} {
		return jsonValueErrorf("%v exceeds maximum {{numBoundMsg .}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMinimum"}}
	if {{numViolated . $recv}} {
		return jsonValueErrorf("%v must be greater than {{numBoundMsg .}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMaximum"}}
	if {{numViolated . $recv}} {
		return jsonValueErrorf("%v must be less than {{numBoundMsg .}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "multipleOf"}}
	if {{numViolated . $recv}} {
		return jsonValueErrorf("%v is not a multiple of {{numBoundMsg .}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "pattern"}}
	if _matched, _mErr := {{patternVar .Value}}.matches(string({{$recv}})); _mErr != nil {
		return jsonValueErrorf("%w", _mErr)
	} else if !_matched {
		return jsonValueErrorf("%s does not match pattern %s", _schemagenQuote(string({{$recv}})), {{printf "%q" .Value}})
	}
	{{- end}}
	{{- if eq .RuleType "format"}}
	{{- template "alias_format_check" (mkAliasFormatCtx $recv .)}}
	{{- end}}
	{{- if eq .RuleType "content"}}
	{{- /* The alias's own value is the string: an alias over any other Go type
	       never carries this rule, because ruleVacuousForType drops a keyword
	       that speaks only about strings. */}}
	{{- template "string_content_check" (mkStringContentCtx (printf "string(%s)" $recv) "" .)}}
	{{- end}}
	{{- if eq .RuleType "minItems"}}
	if len({{$recv}}) < {{countExpr .Value}} {
		return jsonValueErrorf("has %d items, minimum is {{fmtText .Value}}", len({{$recv}}))
	}
	{{- end}}
	{{- if eq .RuleType "maxItems"}}
	if len({{$recv}}) > {{countExpr .Value}} {
		return jsonValueErrorf("has %d items, maximum is {{fmtText .Value}}", len({{$recv}}))
	}
	{{- end}}
	{{- if eq .RuleType "uniqueItems"}}
	{
		{{- /* Compared by identity; see the struct form in validation.go.tmpl. */}}
		{{- if .KeepIDs}}
		if _vc == nil {
			_vc = &jsonValidation{}
		}
		{{- end}}
		_ids, _at, _err := jsonIDsOf({{$recv}}, {{if .KeepIDs}}_vc{{else}}nil{{end}}, {{.Identifier}})
		if _err != nil {
			return jsonValueErrorf("uniqueItems check: marshal error at index %d: %w", _at, jsonMarshalError(&{{$recv}}[_at], _err))
		}
		if _at := jsonFirstDuplicate({{$recv}}, _ids, {{.Identifier}}); _at >= 0 {
			return jsonValueErrorf("items are not unique (duplicate at index %d)", _at)
		}
	}
	{{- end}}
	{{- end}}
	{{- if .HasTupleItems}}
	{{- template "tuple_items_check" (mkTupleCtx $recv "items" .TupleItems .TupleTail)}}
	{{- end}}
	{{- if .HasItemValidations}}
	{{- template "item_validations" (mkItemCtx $recv .ItemValidations)}}
	{{- end}}
	{{- if .AnyOfVariants}}
	// anyOf: at least one variant must be satisfied.
	{
		anyOfValid := false
		{{- range $vi, $variant := .AnyOfVariants}}
		if !anyOfValid {
			variantValid := true
			{{- range $variant}}
			{{- if eq .RuleType "never"}}
			// The branch's own "type" excludes every value this type can hold,
			// so the branch matches nothing.
			variantValid = false
			{{- end}}
			{{- if eq .RuleType "minLength"}}
			if utf8.RuneCountInString(string({{$recv}})) < {{countExpr .Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxLength"}}
			if utf8.RuneCountInString(string({{$recv}})) > {{countExpr .Value}} { variantValid = false }
			{{- end}}
			{{- /* Written for the alias's own Go type, as its Validations are:
			       float64(recv) did not compile over a json.Number, and
			       compared an int64 through a float64. */}}
			{{- if or (eq .RuleType "minimum") (eq .RuleType "maximum") (eq .RuleType "exclusiveMinimum") (eq .RuleType "exclusiveMaximum") (eq .RuleType "multipleOf")}}
			if {{numViolated . $recv}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "pattern"}}
			if _matched, _mErr := {{patternVar .Value}}.matches(string({{$recv}})); _mErr != nil {
				// A variant with no verdict leaves the count of matching
				// variants unknown.
				return jsonValueErrorf("%w", _mErr)
			} else if !_matched {
				variantValid = false
			}
			{{- end}}
			{{- if eq .RuleType "minItems"}}
			if len({{$recv}}) < {{countExpr .Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxItems"}}
			if len({{$recv}}) > {{countExpr .Value}} { variantValid = false }
			{{- end}}
			{{- end}}
			if variantValid { anyOfValid = true }
		}
		{{- end}}
		if !anyOfValid {
			return jsonValueErrorf("value does not match any anyOf variant")
		}
	}
	{{- end}}
	{{- if .OneOfVariants}}
	// oneOf: exactly one variant must be satisfied.
	{
		oneOfCount := 0
		{{- range $vi, $variant := .OneOfVariants}}
		{
			variantValid := true
			{{- range $variant}}
			{{- if eq .RuleType "never"}}
			// The branch's own "type" excludes every value this type can hold,
			// so the branch matches nothing.
			variantValid = false
			{{- end}}
			{{- if eq .RuleType "minLength"}}
			if utf8.RuneCountInString(string({{$recv}})) < {{countExpr .Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxLength"}}
			if utf8.RuneCountInString(string({{$recv}})) > {{countExpr .Value}} { variantValid = false }
			{{- end}}
			{{- /* Written for the alias's own Go type, as its Validations are:
			       float64(recv) did not compile over a json.Number, and
			       compared an int64 through a float64. */}}
			{{- if or (eq .RuleType "minimum") (eq .RuleType "maximum") (eq .RuleType "exclusiveMinimum") (eq .RuleType "exclusiveMaximum") (eq .RuleType "multipleOf")}}
			if {{numViolated . $recv}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "pattern"}}
			if _matched, _mErr := {{patternVar .Value}}.matches(string({{$recv}})); _mErr != nil {
				// A variant with no verdict leaves the count of matching
				// variants unknown.
				return jsonValueErrorf("%w", _mErr)
			} else if !_matched {
				variantValid = false
			}
			{{- end}}
			{{- if eq .RuleType "minItems"}}
			if len({{$recv}}) < {{countExpr .Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxItems"}}
			if len({{$recv}}) > {{countExpr .Value}} { variantValid = false }
			{{- end}}
			{{- end}}
			if variantValid { oneOfCount++ }
		}
		{{- end}}
		if oneOfCount != 1 {
			return jsonValueErrorf("value matches %d oneOf variants, expected exactly 1", oneOfCount)
		}
	}
	{{- end}}
	{{- if .HasContainsValidation}}
	{{- template "contains_check" (mkContainsCtx $recv "contains" .Contains .MinContains .MaxContains)}}
	{{- end}}
	{{- if .HasUnevaluatedItems}}
	{{- template "uneval_items_check" (mkUnevalItemsCtx $recv "unevaluatedItems" .UnevaluatedItems)}}
	{{- end}}
	return nil
}
{{- end}}
