{{define "alias"}}
{{- if .Description}}
// {{.Name}} - {{comment "" .Description}}
{{- end}}
{{- if .Unenforced}}
// {{.Name}} is NOT VALIDATED, and its schema does state constraints:
//	{{.Unenforced}}
//
// schemagen could not compile those into a check it could carry here. The
// underlying type is an interface, Go forbids methods on those, so this type has
// no Validate method and json.Unmarshal into it cannot fail -- every document
// reaches your code unexamined, including the ones the schema forbids.
{{- end}}
{{- template "annotation_comment" mkAnnotationCtx .Annotations "" (or (ne .Description "") (ne .Unenforced ""))}}
type {{.Name}} {{goType .Underlying}}
{{- if and .CanHaveMethods (or .NeedsNullCheck .IsIntegerType .UnmarshalAs .LeafDecode .NullCheck)}}
{{template "alias_unmarshal" .}}
{{- end}}
{{- if and .CanHaveMethods .MarshalAs}}
{{template "alias_marshal" .}}
{{- end}}
{{- if .CanHaveMethods}}
{{template "alias_validate" .}}
{{- end}}
{{- end}}

{{define "alias_unmarshal"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	{{- if .NeedsNullCheck}}
	if string(data) == "null" {
		return jsonValueErrorf("null is not allowed")
	}
	{{- end}}
	{{- with .NullCheck}}
	{{- /* The elements this container holds. The check above answers for the
	       container itself; a null *inside* one is erased by the decode below --
	       []string turns [null] into [""] and reports nothing. */}}
	if _err := checkJSONNullsAt(data, {{template "nullrule" .}}); _err != nil {
		return _err
	}
	{{- end}}
	{{- if .UnmarshalAs}}
	var _target {{.UnmarshalAs}}
	if _err := json.Unmarshal(data, &_target); _err != nil {
		return jsonDecodeRefusal(_err)
	}
	*{{$recv}} = {{.Name}}(_target)
	return nil
	{{- else if .LeafDecode}}
	{{- if .LeafDecode.Integers}}
	// A named container of integers. Decoding through the shadow is what lets a
	// number written 1.0 reach the int64 the schema asked for -- encoding/json
	// decides from the destination type, and []int64 refuses it outright.
	{{- end}}
	{{- if .LeafDecode.Numbers}}
	// A named container of numbers held exactly. Decoding through the shadow is
	// what keeps a JSON string out of one -- encoding/json decides from the
	// destination type, and json.Number is a string underneath, so
	// []json.Number would take ["1.5"] for a list of numbers.
	{{- end}}
	{{- if .LeafDecode.DateTimes}}
	// A named container of date-times. Decoding through the shadow is what lets
	// the lower case spelling RFC 3339 permits reach a time.Time -- encoding/json
	// decides from the destination type, and []time.Time refuses
	// ["2020-01-02t03:04:05z"] outright.
	{{- end}}
	var _iv {{goType .LeafDecode.ShadowType}}
	if _err := json.Unmarshal(data, &_iv); _err != nil {
		return jsonDecodeRefusal(_err)
	}
	*{{$recv}} = {{.LeafDecode.Convert}}
	return nil
	{{- else if .IsIntegerType}}
	// Use json.Number to accept 1.0 as a valid integer (zero fractional part).
	// Reject JSON strings (e.g., "1") — json.Number would accept them since it is a string type.
	if len(data) > 0 && data[0] == '"' {
		return jsonValueErrorf("expected integer, got string")
	}
	var _n json.Number
	if _err := json.Unmarshal(data, &_n); _err != nil {
		return jsonDecodeRefusal(_err)
	}
	if _i, _iErr := _n.Int64(); _iErr == nil {
		*{{$recv}} = {{.Name}}(_i)
		return nil
	}
	{{- if .StrictInteger}}
	return jsonValueErrorf("value %s cannot be held as an integer", _n.String())
	{{- end}}
	// Float notation with nothing after the point (1.0, 1e2), read exactly.
	// See jsonIntegerFromLiteral: float64 holds 2^63 and 2^63-1 as one number,
	// so it cannot be asked whether a literal is an int64.
	if _i, _iOK := jsonIntegerFromLiteral(_n.String()); _iOK {
		*{{$recv}} = {{.Name}}(_i)
		return nil
	}
	return jsonValueErrorf("value %s cannot be held as an integer", _n.String())
	{{- else}}
	{{- /* The refusal is read for the schema's words before it leaves. What
	       encoding/json writes here names the shadow: `cannot unmarshal object
	       into Go value of type p.Alias` -- a type that exists for four lines
	       inside this function, qualified by whichever package the caller
	       generated into. Issue #282. */}}
	type Alias {{.Name}}
	return jsonDecodeRefusal(json.Unmarshal(data, (*Alias)({{$recv}})))
	{{- end}}
}
{{- end}}

{{define "alias_marshal"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} {{.Name}}) MarshalJSON() ([]byte, error) {
	return json.Marshal({{.MarshalAs}}({{$recv}}))
}
{{- end}}

{{/*
alias_format_check emits a "format" assertion against the alias's own value.

It dispatches to the same shared helper the struct-field arm and the untyped
wrapper use, so the three positions cannot disagree about what a format means.
They did once: the rule reached this template's Validations and there was no arm
to emit it, so `type V4 netip.Addr` and `type Email string` both validated to
`return nil` while the identical schema inlined as a property was checked.

Which conversion is legal is settled before emission by aliasFormatCheckable:
the rule survives only for an alias whose underlying type is a string, since
that is the only shape the helpers take. An alias over netip.Addr or time.Time
was already refused at decode by anything the parser rejects, and the rule is
dropped there rather than emitted as a check that cannot fail.
*/}}
{{define "alias_format_check"}}
{{- $recv := .Recv}}
{{- template "string_format_check" (mkStringFormatCtx (formatValueExpr $recv .StringBacked) "" .Value .StringBacked)}}
{{- end}}

{{define "alias_validate"}}
{{- $recv := receiverName .Name -}}

// Validate checks {{.Name}} against its JSON Schema constraints.
func ({{$recv}} {{.Name}}) Validate() error {
	{{- if .ValidateAs}}
	// Returned as it stands: the type this delegates to answers for the very same
	// value, so there is no step of path between the two and nothing to put in
	// front of its message. Wrapping it also lost what the message had recorded
	// about how a container must join it. See issue #279.
	if _err := ({{.ValidateAs}}({{$recv}})).Validate(); _err != nil {
		return _err
	}
	{{- end}}
	{{- range .Validations}}
	{{- if eq .RuleType "minLength"}}
	if utf8.RuneCountInString(string({{$recv}})) < {{.Value}} {
		return jsonValueErrorf("length %d is less than minimum {{.Value}}", utf8.RuneCountInString(string({{$recv}})))
	}
	{{- end}}
	{{- if eq .RuleType "maxLength"}}
	if utf8.RuneCountInString(string({{$recv}})) > {{.Value}} {
		return jsonValueErrorf("length %d exceeds maximum {{.Value}}", utf8.RuneCountInString(string({{$recv}})))
	}
	{{- end}}
	{{- if eq .RuleType "minimum"}}
	if {{numOperand . $recv}} < {{numBound .}} {
		return jsonValueErrorf("%v is less than minimum {{numBoundMsg .}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "maximum"}}
	if {{numOperand . $recv}} > {{numBound .}} {
		return jsonValueErrorf("%v exceeds maximum {{numBoundMsg .}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMinimum"}}
	if {{numOperand . $recv}} <= {{numBound .}} {
		return jsonValueErrorf("%v must be greater than {{numBoundMsg .}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMaximum"}}
	if {{numOperand . $recv}} >= {{numBound .}} {
		return jsonValueErrorf("%v must be less than {{numBoundMsg .}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "multipleOf"}}
	{{- if .ExactCompare}}
	// Exact: the two decimals are lined up and one integer divided by the
	// other, rather than a float64 quotient compared against a tolerance.
	if !{{exactMultipleOf . $recv}} {
		return jsonValueErrorf("%v is not a multiple of {{numBoundMsg .}}", {{$recv}})
	}
	{{- else if .IntegerCompare}}
	// Exact: both operands are int64, so divisibility is a remainder rather
	// than a float64 quotient compared against a tolerance.
	if {{$recv}} % {{numBound .}} != 0 {
		return jsonValueErrorf("%v is not a multiple of {{numBoundMsg .}}", {{$recv}})
	}
	{{- else}}
	{
		q := float64({{$recv}}) / {{numBound .}}
		if math.Abs(q - math.Round(q)) > 1e-9 {
			return jsonValueErrorf("%v is not a multiple of {{numBoundMsg .}}", {{$recv}})
		}
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "pattern"}}
	if matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, string({{$recv}})); !matched {
		return jsonValueErrorf("%q does not match pattern %s", {{$recv}}, {{printf "%q" .Value}})
	}
	{{- end}}
	{{- if eq .RuleType "format"}}
	{{- template "alias_format_check" (mkAliasFormatCtx $recv .)}}
	{{- end}}
	{{- if eq .RuleType "content"}}
	{{- /* The alias's own value is the string: an alias over any other Go type
	       never carries this rule, because ruleVacuousForType drops a keyword
	       that speaks only about strings. */}}
	{{- template "string_content_check" (mkStringContentCtx (printf "string(%s)" $recv) "" .)}}
	{{- end}}
	{{- if eq .RuleType "minItems"}}
	if len({{$recv}}) < {{.Value}} {
		return jsonValueErrorf("has %d items, minimum is {{.Value}}", len({{$recv}}))
	}
	{{- end}}
	{{- if eq .RuleType "maxItems"}}
	if len({{$recv}}) > {{.Value}} {
		return jsonValueErrorf("has %d items, maximum is {{.Value}}", len({{$recv}}))
	}
	{{- end}}
	{{- if eq .RuleType "uniqueItems"}}
	{
		seen := make(map[string]bool, len({{$recv}}))
		for i, item := range {{$recv}} {
			b, err := json.Marshal(item)
			if err != nil {
				return jsonValueErrorf("uniqueItems check: marshal error at index %d: %w", i, err)
			}
			key := string(b)
			if seen[key] {
				return jsonValueErrorf("items are not unique (duplicate at index %d)", i)
			}
			seen[key] = true
		}
	}
	{{- end}}
	{{- end}}
	{{- if .HasTupleItems}}
	{{- template "tuple_items_check" (mkTupleCtx $recv "items" .TupleItems .TupleTail)}}
	{{- end}}
	{{- if .HasItemValidations}}
	{{- template "item_validations" (mkItemCtx $recv .ItemValidations)}}
	{{- end}}
	{{- if .AnyOfVariants}}
	// anyOf: at least one variant must be satisfied.
	{
		anyOfValid := false
		{{- range $vi, $variant := .AnyOfVariants}}
		if !anyOfValid {
			variantValid := true
			{{- range $variant}}
			{{- if eq .RuleType "never"}}
			// The branch's own "type" excludes every value this type can hold,
			// so the branch matches nothing.
			variantValid = false
			{{- end}}
			{{- if eq .RuleType "minLength"}}
			if utf8.RuneCountInString(string({{$recv}})) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxLength"}}
			if utf8.RuneCountInString(string({{$recv}})) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "minimum"}}
			if float64({{$recv}}) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maximum"}}
			if float64({{$recv}}) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "exclusiveMinimum"}}
			if float64({{$recv}}) <= {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "exclusiveMaximum"}}
			if float64({{$recv}}) >= {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "multipleOf"}}
			{
				q := float64({{$recv}}) / {{.Value}}
				if math.Abs(q - math.Round(q)) > 1e-9 { variantValid = false }
			}
			{{- end}}
			{{- if eq .RuleType "pattern"}}
			if matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, string({{$recv}})); !matched { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "minItems"}}
			if len({{$recv}}) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxItems"}}
			if len({{$recv}}) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- end}}
			if variantValid { anyOfValid = true }
		}
		{{- end}}
		if !anyOfValid {
			return jsonValueErrorf("value does not match any anyOf variant")
		}
	}
	{{- end}}
	{{- if .OneOfVariants}}
	// oneOf: exactly one variant must be satisfied.
	{
		oneOfCount := 0
		{{- range $vi, $variant := .OneOfVariants}}
		{
			variantValid := true
			{{- range $variant}}
			{{- if eq .RuleType "never"}}
			// The branch's own "type" excludes every value this type can hold,
			// so the branch matches nothing.
			variantValid = false
			{{- end}}
			{{- if eq .RuleType "minLength"}}
			if utf8.RuneCountInString(string({{$recv}})) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxLength"}}
			if utf8.RuneCountInString(string({{$recv}})) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "minimum"}}
			if float64({{$recv}}) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maximum"}}
			if float64({{$recv}}) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "exclusiveMinimum"}}
			if float64({{$recv}}) <= {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "exclusiveMaximum"}}
			if float64({{$recv}}) >= {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "multipleOf"}}
			{
				q := float64({{$recv}}) / {{.Value}}
				if math.Abs(q - math.Round(q)) > 1e-9 { variantValid = false }
			}
			{{- end}}
			{{- if eq .RuleType "pattern"}}
			if matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, string({{$recv}})); !matched { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "minItems"}}
			if len({{$recv}}) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxItems"}}
			if len({{$recv}}) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- end}}
			if variantValid { oneOfCount++ }
		}
		{{- end}}
		if oneOfCount != 1 {
			return jsonValueErrorf("value matches %d oneOf variants, expected exactly 1", oneOfCount)
		}
	}
	{{- end}}
	{{- if .HasContainsValidation}}
	{{- template "contains_check" (mkContainsCtx $recv "contains" .Contains .MinContains .MaxContains)}}
	{{- end}}
	{{- if .HasUnevaluatedItems}}
	{{- template "uneval_items_check" (mkUnevalItemsCtx $recv "unevaluatedItems" .UnevaluatedItems)}}
	{{- end}}
	return nil
}
{{- end}}
