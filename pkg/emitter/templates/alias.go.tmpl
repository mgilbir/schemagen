{{define "alias"}}
{{- if .Description}}
// {{.Name}} - {{comment "" .Description}}
{{- end}}
type {{.Name}} {{goType .Underlying}}
{{- if and .CanHaveMethods (or .NeedsNullCheck .IsIntegerType .UnmarshalAs .IntegerDecode .NullCheck)}}
{{template "alias_unmarshal" .}}
{{- end}}
{{- if and .CanHaveMethods .MarshalAs}}
{{template "alias_marshal" .}}
{{- end}}
{{- if .CanHaveMethods}}
{{template "alias_validate" .}}
{{- end}}
{{- end}}

{{define "alias_unmarshal"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	{{- if .NeedsNullCheck}}
	if string(data) == "null" {
		return fmt.Errorf("null is not allowed for type {{.Name}}")
	}
	{{- end}}
	{{- with .NullCheck}}
	{{- /* The elements this container holds. The check above answers for the
	       container itself; a null *inside* one is erased by the decode below --
	       []string turns [null] into [""] and reports nothing. */}}
	if _err := checkJSONNulls(data, "value", {{template "nullrule" .}}); _err != nil {
		return _err
	}
	{{- end}}
	{{- if .UnmarshalAs}}
	var _target {{.UnmarshalAs}}
	if _err := json.Unmarshal(data, &_target); _err != nil {
		return _err
	}
	*{{$recv}} = {{.Name}}(_target)
	return nil
	{{- else if .IntegerDecode}}
	// A named container of integers. Decoding through the shadow is what lets a
	// number written 1.0 reach the int64 the schema asked for -- encoding/json
	// decides from the destination type, and []int64 refuses it outright.
	var _iv {{goType .IntegerDecode.ShadowType}}
	if _err := json.Unmarshal(data, &_iv); _err != nil {
		return _err
	}
	*{{$recv}} = {{.IntegerDecode.Convert}}
	return nil
	{{- else if .IsIntegerType}}
	// Use json.Number to accept 1.0 as a valid integer (zero fractional part).
	// Reject JSON strings (e.g., "1") — json.Number would accept them since it is a string type.
	if len(data) > 0 && data[0] == '"' {
		return fmt.Errorf("cannot unmarshal string into Go value of type {{.Name}}")
	}
	var _n json.Number
	if _err := json.Unmarshal(data, &_n); _err != nil {
		return _err
	}
	if _i, _iErr := _n.Int64(); _iErr == nil {
		*{{$recv}} = {{.Name}}(_i)
		return nil
	}
	{{- if .StrictInteger}}
	return fmt.Errorf("value %s cannot be represented as int64", _n.String())
	{{- end}}
	// Try float with zero fractional part (e.g., 1.0).
	if _f, _fErr := _n.Float64(); _fErr == nil {
		if _f == math.Trunc(_f) && !math.IsInf(_f, 0) && _f >= -9.223372036854776e+18 && _f <= 9.223372036854776e+18 {
			*{{$recv}} = {{.Name}}(int64(_f))
			return nil
		}
	}
	return fmt.Errorf("value %s cannot be represented as int64", _n.String())
	{{- else}}
	type Alias {{.Name}}
	return json.Unmarshal(data, (*Alias)({{$recv}}))
	{{- end}}
}
{{- end}}

{{define "alias_marshal"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} {{.Name}}) MarshalJSON() ([]byte, error) {
	return json.Marshal({{.MarshalAs}}({{$recv}}))
}
{{- end}}

{{/*
alias_format_check emits a "format" assertion against the alias's own value.

It is the same set of checks the struct-field arm of the validation template
applies, written over the receiver instead of over a field, and it exists because
a format behind a $ref used to be enforced nowhere: the rule reached the alias's
Validations and the template had no arm to emit it, so `type V4 netip.Addr` and
`type Email string` both validated to `return nil` while the identical schema
inlined as a property was checked.

The string arms keep the field arm's `!= ""` guard deliberately. It is a
looseness -- "" is not a valid email -- but it is the same looseness the sibling
position has, and the two must agree: an alias that rejected "" where an inline
property accepted it would be a false rejection reachable by moving a subschema
behind a $ref. Changing the convention is a decision for both arms at once.

Which conversion is legal here is settled before emission by
aliasFormatCheckable, which keeps a format rule only when the alias's underlying
type is the one the check reads.
*/}}
{{define "alias_format_check"}}
{{- $recv := .Recv}}
{{- $v := printf "string(%s)" $recv}}
{{- if eq .Value "date"}}
if {{$v}} != "" {
	if _, _err := time.Parse("2006-01-02", {{$v}}); _err != nil {
		return fmt.Errorf("value: %q is not a valid date (YYYY-MM-DD): %w", {{$v}}, _err)
	}
}
{{- end}}
{{- if eq .Value "time"}}
if {{$v}} != "" {
	_valid := false
	for _, _layout := range []string{"15:04:05Z07:00", "15:04:05"} {
		if _, _err := time.Parse(_layout, {{$v}}); _err == nil {
			_valid = true
			break
		}
	}
	if !_valid {
		return fmt.Errorf("value: %q is not a valid time (HH:MM:SS or with offset)", {{$v}})
	}
}
{{- end}}
{{- if or (eq .Value "email") (eq .Value "idn-email")}}
if {{$v}} != "" {
	if _, _err := mail.ParseAddress({{$v}}); _err != nil {
		return fmt.Errorf("value: %q is not a valid email address: %w", {{$v}}, _err)
	}
}
{{- end}}
{{- if or (eq .Value "uri") (eq .Value "iri")}}
if {{$v}} != "" {
	if _u, _err := url.Parse({{$v}}); _err != nil || _u.Scheme == "" {
		return fmt.Errorf("value: %q is not a valid URI", {{$v}})
	}
}
{{- end}}
{{- if or (eq .Value "uri-reference") (eq .Value "iri-reference") (eq .Value "uri-template")}}
if {{$v}} != "" {
	if _, _err := url.Parse({{$v}}); _err != nil {
		return fmt.Errorf("value: %q is not a valid URI reference", {{$v}})
	}
}
{{- end}}
{{- if eq .Value "uuid"}}
if {{$v}} != "" {
	if !regexp.MustCompile(`^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$`).MatchString({{$v}}) {
		return fmt.Errorf("value: %q is not a valid UUID", {{$v}})
	}
}
{{- end}}
{{- if or (eq .Value "hostname") (eq .Value "idn-hostname")}}
if {{$v}} != "" {
	if !regexp.MustCompile(`^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)*$`).MatchString({{$v}}) {
		return fmt.Errorf("value: %q is not a valid hostname", {{$v}})
	}
}
{{- end}}
{{- if eq .Value "json-pointer"}}
if {{$v}} != "" {
	if !regexp.MustCompile(`^(/([^~/]|~0|~1)*)*$`).MatchString({{$v}}) {
		return fmt.Errorf("value: %q is not a valid JSON Pointer", {{$v}})
	}
}
{{- end}}
{{- if eq .Value "relative-json-pointer"}}
if {{$v}} != "" {
	if !regexp.MustCompile(`^(0|[1-9][0-9]*)(#|(/([^~/]|~0|~1)*)*)$`).MatchString({{$v}}) {
		return fmt.Errorf("value: %q is not a valid relative JSON Pointer", {{$v}})
	}
}
{{- end}}
{{- if eq .Value "regex"}}
if {{$v}} != "" {
	if _, _err := regexp.Compile({{$v}}); _err != nil {
		return fmt.Errorf("value: %q is not a valid regex: %w", {{$v}}, _err)
	}
}
{{- end}}
{{- if eq .Value "duration"}}
if {{$v}} != "" {
	if !regexp.MustCompile(`^P(\d+Y)?(\d+M)?(\d+W)?(\d+D)?(T(\d+H)?(\d+M)?(\d+(\.\d+)?S)?)?$`).MatchString({{$v}}) {
		return fmt.Errorf("value: %q is not a valid ISO 8601 duration", {{$v}})
	}
}
{{- end}}
{{- if eq .Value "ipv4"}}
if _a := netip.Addr({{$recv}}); _a.IsValid() && !_a.Is4() {
	return fmt.Errorf("value: %q is not a valid IPv4 address", _a)
}
{{- end}}
{{- if eq .Value "ipv6"}}
if _a := netip.Addr({{$recv}}); _a.IsValid() && !_a.Is6() {
	return fmt.Errorf("value: %q is not a valid IPv6 address", _a)
}
{{- end}}
{{- end}}

{{define "alias_validate"}}
{{- $recv := receiverName .Name -}}

// Validate checks {{.Name}} against its JSON Schema constraints.
func ({{$recv}} {{.Name}}) Validate() error {
	{{- if .ValidateAs}}
	if _err := ({{.ValidateAs}}({{$recv}})).Validate(); _err != nil {
		return fmt.Errorf("value: %w", _err)
	}
	{{- end}}
	{{- range .Validations}}
	{{- if eq .RuleType "minLength"}}
	if utf8.RuneCountInString(string({{$recv}})) < {{.Value}} {
		return fmt.Errorf("value: length %d is less than minimum {{.Value}}", utf8.RuneCountInString(string({{$recv}})))
	}
	{{- end}}
	{{- if eq .RuleType "maxLength"}}
	if utf8.RuneCountInString(string({{$recv}})) > {{.Value}} {
		return fmt.Errorf("value: length %d exceeds maximum {{.Value}}", utf8.RuneCountInString(string({{$recv}})))
	}
	{{- end}}
	{{- if eq .RuleType "minimum"}}
	if float64({{$recv}}) < {{.Value}} {
		return fmt.Errorf("value: %v is less than minimum {{.Value}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "maximum"}}
	if float64({{$recv}}) > {{.Value}} {
		return fmt.Errorf("value: %v exceeds maximum {{.Value}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMinimum"}}
	if float64({{$recv}}) <= {{.Value}} {
		return fmt.Errorf("value: %v must be greater than {{.Value}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMaximum"}}
	if float64({{$recv}}) >= {{.Value}} {
		return fmt.Errorf("value: %v must be less than {{.Value}}", {{$recv}})
	}
	{{- end}}
	{{- if eq .RuleType "multipleOf"}}
	{
		q := float64({{$recv}}) / {{.Value}}
		if math.Abs(q - math.Round(q)) > 1e-9 {
			return fmt.Errorf("value: %v is not a multiple of {{.Value}}", {{$recv}})
		}
	}
	{{- end}}
	{{- if eq .RuleType "pattern"}}
	if matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, string({{$recv}})); !matched {
		return fmt.Errorf("value: %q does not match pattern %s", {{$recv}}, {{printf "%q" .Value}})
	}
	{{- end}}
	{{- if eq .RuleType "format"}}
	{{- template "alias_format_check" (mkAliasFormatCtx $recv .)}}
	{{- end}}
	{{- if eq .RuleType "minItems"}}
	if len({{$recv}}) < {{.Value}} {
		return fmt.Errorf("value: has %d items, minimum is {{.Value}}", len({{$recv}}))
	}
	{{- end}}
	{{- if eq .RuleType "maxItems"}}
	if len({{$recv}}) > {{.Value}} {
		return fmt.Errorf("value: has %d items, maximum is {{.Value}}", len({{$recv}}))
	}
	{{- end}}
	{{- if eq .RuleType "uniqueItems"}}
	{
		seen := make(map[string]bool, len({{$recv}}))
		for i, item := range {{$recv}} {
			b, err := json.Marshal(item)
			if err != nil {
				return fmt.Errorf("value: uniqueItems check: marshal error at index %d: %w", i, err)
			}
			key := string(b)
			if seen[key] {
				return fmt.Errorf("value: items are not unique (duplicate at index %d)", i)
			}
			seen[key] = true
		}
	}
	{{- end}}
	{{- end}}
	{{- if .HasTupleItems}}
	{{- template "tuple_items_check" (mkTupleCtx $recv "items" .TupleItems .TupleTail)}}
	{{- end}}
	{{- if .HasItemValidations}}
	{{- template "item_validations" (mkItemCtx $recv .ItemValidations)}}
	{{- end}}
	{{- if .AnyOfVariants}}
	// anyOf: at least one variant must be satisfied.
	{
		anyOfValid := false
		{{- range $vi, $variant := .AnyOfVariants}}
		if !anyOfValid {
			variantValid := true
			{{- range $variant}}
			{{- if eq .RuleType "never"}}
			// The branch's own "type" excludes every value this type can hold,
			// so the branch matches nothing.
			variantValid = false
			{{- end}}
			{{- if eq .RuleType "minLength"}}
			if utf8.RuneCountInString(string({{$recv}})) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxLength"}}
			if utf8.RuneCountInString(string({{$recv}})) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "minimum"}}
			if float64({{$recv}}) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maximum"}}
			if float64({{$recv}}) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "exclusiveMinimum"}}
			if float64({{$recv}}) <= {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "exclusiveMaximum"}}
			if float64({{$recv}}) >= {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "multipleOf"}}
			{
				q := float64({{$recv}}) / {{.Value}}
				if math.Abs(q - math.Round(q)) > 1e-9 { variantValid = false }
			}
			{{- end}}
			{{- if eq .RuleType "pattern"}}
			if matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, string({{$recv}})); !matched { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "minItems"}}
			if len({{$recv}}) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxItems"}}
			if len({{$recv}}) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- end}}
			if variantValid { anyOfValid = true }
		}
		{{- end}}
		if !anyOfValid {
			return fmt.Errorf("value does not match any anyOf variant")
		}
	}
	{{- end}}
	{{- if .OneOfVariants}}
	// oneOf: exactly one variant must be satisfied.
	{
		oneOfCount := 0
		{{- range $vi, $variant := .OneOfVariants}}
		{
			variantValid := true
			{{- range $variant}}
			{{- if eq .RuleType "never"}}
			// The branch's own "type" excludes every value this type can hold,
			// so the branch matches nothing.
			variantValid = false
			{{- end}}
			{{- if eq .RuleType "minLength"}}
			if utf8.RuneCountInString(string({{$recv}})) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxLength"}}
			if utf8.RuneCountInString(string({{$recv}})) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "minimum"}}
			if float64({{$recv}}) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maximum"}}
			if float64({{$recv}}) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "exclusiveMinimum"}}
			if float64({{$recv}}) <= {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "exclusiveMaximum"}}
			if float64({{$recv}}) >= {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "multipleOf"}}
			{
				q := float64({{$recv}}) / {{.Value}}
				if math.Abs(q - math.Round(q)) > 1e-9 { variantValid = false }
			}
			{{- end}}
			{{- if eq .RuleType "pattern"}}
			if matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, string({{$recv}})); !matched { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "minItems"}}
			if len({{$recv}}) < {{.Value}} { variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxItems"}}
			if len({{$recv}}) > {{.Value}} { variantValid = false }
			{{- end}}
			{{- end}}
			if variantValid { oneOfCount++ }
		}
		{{- end}}
		if oneOfCount != 1 {
			return fmt.Errorf("value matches %d oneOf variants, expected exactly 1", oneOfCount)
		}
	}
	{{- end}}
	{{- if .HasContainsValidation}}
	{{- template "contains_check" (mkContainsCtx $recv "contains" .Contains .MinContains .MaxContains)}}
	{{- end}}
	{{- if .HasUnevaluatedItems}}
	{{- template "uneval_items_check" (mkUnevalItemsCtx $recv "unevaluatedItems" .UnevaluatedItems)}}
	{{- end}}
	return nil
}
{{- end}}
