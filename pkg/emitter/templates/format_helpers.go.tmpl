{{/*
format_helpers emits one function per "format" this generator asserts.

They are shared functions rather than inline checks because the same assertion
is needed from three places -- a struct field, a named alias over its own value,
and the wrapper a format with no declared "type" resolves to -- and for a long
time each place carried its own copy. The copies drifted, which is how a format
came to be asserted behind a $ref and not inline, and how a check written for
netip.Addr came to be emitted against a *string. One definition cannot drift
from itself.

The checks answer to the official test suite's optional/format corpus, which is
the only statement of what these strings mean that is not this repository's own
opinion. Where a check is deliberately weaker than the corpus, the function says
so and names what it does not do; those are under-enforcement, which accepts
what should be refused, rather than the reverse.

No check exempts the empty string. That exemption used to be everywhere, on the
grounds that the three positions had to agree with each other -- but they agree
now by construction, and "" is not an email address, a hostname, a UUID or a
duration. It remains acceptable to the checks where it genuinely is one: "" is a
valid URI reference, a valid URI template, a valid regular expression and the
JSON Pointer that selects the whole document, and each of those functions still
returns nil for it on its own terms rather than by exemption.
*/}}
{{define "format_helpers"}}

// schemagenASCIIDigits reports whether s is a run of exactly n ASCII digits.
// The date and time grammars are defined over ASCII, and Go's date parser is
// lenient about a few spellings RFC 3339 does not admit, so the shape is checked
// here before the value is.
func schemagenASCIIDigits(s string, n int) bool {
	if len(s) != n {
		return false
	}
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	return true
}

func schemagenAtoi(s string) int {
	n := 0
	for i := 0; i < len(s); i++ {
		n = n*10 + int(s[i]-'0')
	}
	return n
}

// schemagenFormatDate checks an RFC 3339 full-date.
func schemagenFormatDate(v string) error {
	if len(v) != 10 || v[4] != '-' || v[7] != '-' ||
		!schemagenASCIIDigits(v[0:4], 4) || !schemagenASCIIDigits(v[5:7], 2) || !schemagenASCIIDigits(v[8:10], 2) {
		return fmt.Errorf("%q is not a valid date (YYYY-MM-DD)", v)
	}
	// time.Parse settles the month and day ranges, including February in a leap
	// year, which a regular expression cannot.
	if _, err := time.Parse("2006-01-02", v); err != nil {
		return fmt.Errorf("%q is not a valid date (YYYY-MM-DD): %w", v, err)
	}
	return nil
}

// schemagenFormatTime checks an RFC 3339 full-time: a partial-time and a
// mandatory offset.
//
// The leap second is the part a date library cannot do for you. RFC 3339 admits
// a 60th second, and only at the moment that is 23:59:60 in UTC -- so
// 01:29:60+01:30 is a leap second and 23:59:60+01:00 is not. Go's time.Parse
// rejects second 60 outright, so the check is arithmetic here: the local minute
// of the day, less the offset, must be the last minute of the UTC day.
func schemagenFormatTime(v string) error {
	if err := schemagenCheckFullTime(v); err != nil {
		return fmt.Errorf("%q is not a valid time (RFC 3339 full-time): %w", v, err)
	}
	return nil
}

// schemagenFormatDraft3Time checks draft 3's "time", which is a different
// format under the same name: HH:MM:SS, with no offset and no fraction.
//
// RFC 3339's full-time -- the one every later draft means -- requires an
// offset, so a check written for that refuses 08:30:06, which draft 3 marks
// valid. The two are kept apart rather than unified into something loose enough
// for both, because the loose version would accept a bare local time on the
// drafts that forbid it.
func schemagenFormatDraft3Time(v string) error {
	bad := fmt.Errorf("%q is not a valid time (HH:MM:SS)", v)
	if len(v) != 8 || v[2] != ':' || v[5] != ':' {
		return bad
	}
	if !schemagenASCIIDigits(v[0:2], 2) || !schemagenASCIIDigits(v[3:5], 2) || !schemagenASCIIDigits(v[6:8], 2) {
		return bad
	}
	if schemagenAtoi(v[0:2]) > 23 || schemagenAtoi(v[3:5]) > 59 || schemagenAtoi(v[6:8]) > 60 {
		return bad
	}
	return nil
}

func schemagenCheckFullTime(v string) error {
	if len(v) < 9 || v[2] != ':' || v[5] != ':' {
		return fmt.Errorf("expected HH:MM:SS with a time offset")
	}
	hh, mm, ss := v[0:2], v[3:5], v[6:8]
	if !schemagenASCIIDigits(hh, 2) || !schemagenASCIIDigits(mm, 2) || !schemagenASCIIDigits(ss, 2) {
		return fmt.Errorf("hour, minute and second must each be two ASCII digits")
	}
	rest := v[8:]
	// An optional fraction of a second, which RFC 3339 allows to any precision.
	if len(rest) > 0 && rest[0] == '.' {
		i := 1
		for i < len(rest) && rest[i] >= '0' && rest[i] <= '9' {
			i++
		}
		if i == 1 {
			return fmt.Errorf("a second fraction needs at least one digit")
		}
		rest = rest[i:]
	}
	// The offset is not optional: a bare local time is not an RFC 3339 full-time.
	offsetMinutes := 0
	switch {
	case rest == "Z" || rest == "z":
	case len(rest) == 6 && (rest[0] == '+' || rest[0] == '-') && rest[3] == ':':
		oh, om := rest[1:3], rest[4:6]
		if !schemagenASCIIDigits(oh, 2) || !schemagenASCIIDigits(om, 2) {
			return fmt.Errorf("the offset hour and minute must each be two ASCII digits")
		}
		offH, offM := schemagenAtoi(oh), schemagenAtoi(om)
		if offH > 23 || offM > 59 {
			return fmt.Errorf("offset %s is out of range", rest)
		}
		offsetMinutes = offH*60 + offM
		if rest[0] == '-' {
			offsetMinutes = -offsetMinutes
		}
	default:
		return fmt.Errorf("expected a time offset of Z or ±HH:MM")
	}
	h, m, s := schemagenAtoi(hh), schemagenAtoi(mm), schemagenAtoi(ss)
	if h > 23 || m > 59 {
		return fmt.Errorf("hour or minute out of range")
	}
	if s > 60 {
		return fmt.Errorf("second out of range")
	}
	if s == 60 {
		// Normalise to UTC and require the last minute of the day. The modulo
		// keeps a negative or overflowing result inside 0..1439.
		utc := ((h*60+m-offsetMinutes)%1440 + 1440) % 1440
		if utc != 23*60+59 {
			return fmt.Errorf("a leap second is only valid at 23:59:60 UTC")
		}
	}
	return nil
}

// schemagenFormatDateTime checks an RFC 3339 date-time: a full-date, a
// case-insensitive "T", and a full-time.
func schemagenFormatDateTime(v string) error {
	if len(v) < 11 || (v[10] != 'T' && v[10] != 't') {
		return fmt.Errorf("%q is not a valid date-time (RFC 3339)", v)
	}
	if err := schemagenFormatDate(v[:10]); err != nil {
		return fmt.Errorf("%q is not a valid date-time (RFC 3339): %w", v, err)
	}
	if err := schemagenCheckFullTime(v[11:]); err != nil {
		return fmt.Errorf("%q is not a valid date-time (RFC 3339): %w", v, err)
	}
	return nil
}

// schemagenFormatDuration checks an RFC 3339 appendix A duration.
//
// The grammar is stricter than it looks: at least one component must be
// present, the date components must appear in the order Y M D, a "T" must be
// followed by at least one time component, and a week count may not be combined
// with anything else.
func schemagenFormatDuration(v string) error {
	bad := func() error { return fmt.Errorf("%q is not a valid ISO 8601 duration", v) }
	if len(v) < 2 || v[0] != 'P' {
		return bad()
	}
	body := v[1:]
	datePart, timePart, hasT := strings.Cut(body, "T")
	if hasT && timePart == "" {
		return bad()
	}
	if !hasT && datePart == "" {
		return bad()
	}
	// A week count stands alone.
	if strings.HasSuffix(datePart, "W") && !hasT {
		return schemagenDurationComponents(datePart, "W", bad)
	}
	if strings.Contains(datePart, "W") {
		return bad()
	}
	if datePart != "" {
		if err := schemagenDurationComponents(datePart, "YMD", bad); err != nil {
			return err
		}
	}
	if hasT {
		if err := schemagenDurationComponents(timePart, "HMS", bad); err != nil {
			return err
		}
	}
	return nil
}

// schemagenDurationComponents walks one half of a duration, requiring each
// component to be a run of ASCII digits followed by a designator drawn from
// order, with at least one component present.
//
// The designators are not merely in order, they are *adjacent*, and that is the
// part the RFC 3339 appendix A grammar states and a reading of "in order" misses.
// The productions nest rather than list:
//
//	dur-year = 1*DIGIT "Y" [dur-month]      dur-hour   = 1*DIGIT "H" [dur-minute]
//	dur-month = 1*DIGIT "M" [dur-day]       dur-minute = 1*DIGIT "M" [dur-second]
//	dur-day = 1*DIGIT "D"                   dur-second = 1*DIGIT "S"
//
// so a component may only be followed by the one immediately after it. Any
// component may open the half -- "P1M2D" and "PT1M2S" are valid -- but once one
// has, the next may not skip. That is why "P1Y2D" and "PT1H2S" are invalid, and
// the official suite marks both so.
//
// No component carries a fraction, on either half: dur-second is 1*DIGIT "S"
// and nothing else, so "PT0.5S" is invalid too.
func schemagenDurationComponents(s, order string, bad func() error) error {
	next := 0
	seen := false
	for len(s) > 0 {
		i := 0
		for i < len(s) && s[i] >= '0' && s[i] <= '9' {
			i++
		}
		if i == 0 || i >= len(s) {
			return bad()
		}
		d := strings.IndexByte(order[next:], s[i])
		if d < 0 {
			return bad()
		}
		// After the first component the grammar admits only the very next
		// designator, never a later one.
		if seen && d != 0 {
			return bad()
		}
		next += d + 1
		seen = true
		s = s[i+1:]
	}
	if !seen {
		return bad()
	}
	return nil
}

// schemagenURIChars reports whether every character of v is one RFC 3986 admits
// somewhere in a URI: unreserved, sub-delim, gen-delim, or the "%" that
// introduces a percent-encoding.
//
// This is what refuses a backslash, a quote, an angle or curly bracket, a caret,
// a backtick, a pipe and a space -- each of which the corpus names as invalid
// and each of which url.Parse accepts, since Go's parser is built to be
// forgiving of what browsers send. allowNonASCII is the one axis on which an IRI
// differs: RFC 3987 admits the ucschar ranges, and approximating them as "any
// non-ASCII rune" over-accepts a handful of code points rather than rejecting a
// legitimate one.
func schemagenURIChars(v string, allowNonASCII bool) bool {
	for _, r := range v {
		if r >= 0x80 {
			if allowNonASCII {
				continue
			}
			return false
		}
		switch {
		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9':
		case strings.ContainsRune("-._~!$&'()*+,;=:/?#[]@%", r):
		default:
			return false
		}
	}
	return true
}

// schemagenFormatURI checks an absolute URI: a scheme, and nothing outside the
// grammar's character set. Non-ASCII belongs to `iri`, not here.
func schemagenFormatURI(v string) error {
	if err := schemagenCheckURI(v, true, false); err != nil {
		return fmt.Errorf("%q is not a valid URI", v)
	}
	return nil
}

// schemagenFormatIRI is schemagenFormatURI with non-ASCII admitted.
func schemagenFormatIRI(v string) error {
	if err := schemagenCheckURI(v, true, true); err != nil {
		return fmt.Errorf("%q is not a valid IRI", v)
	}
	return nil
}

func schemagenCheckURI(v string, requireScheme, allowNonASCII bool) error {
	bad := fmt.Errorf("invalid")
	if !schemagenURIChars(v, allowNonASCII) {
		return bad
	}
	u, err := url.Parse(v)
	if err != nil {
		return bad
	}
	if requireScheme && u.Scheme == "" {
		return bad
	}
	if u.Scheme != "" && !schemagenValidScheme(u.Scheme) {
		return bad
	}
	// An authority's host is either a registered name, an IPv4 address, or an
	// IP-literal in brackets. A bare IPv6 address is none of them, and url.Parse
	// reads its leading group as a host and the rest as a port. Hostname()
	// strips the brackets, so the bracketed form has to be recognised from
	// u.Host before the colon test means anything.
	if !strings.HasPrefix(u.Host, "[") && strings.Contains(u.Hostname(), ":") {
		return bad
	}
	return nil
}

func schemagenValidScheme(s string) bool {
	if s == "" {
		return false
	}
	c := s[0]
	if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z') {
		return false
	}
	for i := 1; i < len(s); i++ {
		c := s[i]
		switch {
		case c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9', c == '+', c == '-', c == '.':
		default:
			return false
		}
	}
	return true
}

// schemagenFormatURIReference checks a URI reference, which may be relative and
// may be empty: "" is the reference that selects the current document.
func schemagenFormatURIReference(v string) error {
	if err := schemagenCheckURI(v, false, false); err != nil {
		return fmt.Errorf("%q is not a valid URI reference", v)
	}
	return nil
}

// schemagenFormatIRIReference is schemagenFormatURIReference with non-ASCII
// admitted.
func schemagenFormatIRIReference(v string) error {
	if err := schemagenCheckURI(v, false, true); err != nil {
		return fmt.Errorf("%q is not a valid IRI reference", v)
	}
	return nil
}

// schemagenURITemplateOperators is RFC 6570's operator set: op-level2, op-level3
// and op-reserve together. A leading one of these is an operator rather than the
// first character of a variable name, and reading it as a name is what would
// refuse "{,x}" -- an op-reserve "," followed by the varspec "x", which the
// grammar admits and which a naive split on "," reports as an empty first
// varspec.
const schemagenURITemplateOperators = "+#./;?&=,!@|"

// schemagenFormatURITemplate checks an RFC 6570 URI template.
//
// The template is a sequence of literals and expressions, and this walks it
// looking for the expressions: a "{" opens one, the next "}" closes it, and a
// "}" with no expression open is the unmatched brace the corpus refuses in
// "foo}bar". "" holds no expressions and is a valid template on those terms
// rather than by exemption.
//
// Each expression body is then held to
//
//	expression    =  "{" [ operator ] variable-list "}"
//	variable-list =  varspec *( "," varspec )
//	varspec       =  varname [ modifier-level4 ]
//
// which is what refuses the four forms issue #169 named: "{}" (no variable
// list), "{a,,b}" (an empty varspec inside one), and "{v:0}" and "{v:10000}"
// (a max-length outside 1..9999).
//
// It is deliberately weaker than the grammar in one place: varname is taken to
// be any non-empty run rather than `varchar *( ["."] varchar )`. So "{v-w}",
// "{$v}" and "{a b}" are accepted where RFC 6570 refuses them, and the literal
// character set -- which excludes SP, DQUOTE, "'", "<", ">", "\", "^", "`" and
// "|", and admits "%" only as a percent-encoding -- is not checked at all, so
// "a b" and "a%zzb" are accepted too. Both are under-enforcement, which is the
// direction this generator errs in: the corpus supplies no case either way, the
// one independent implementation that asserts this format at all (santhosh-tekuri,
// through Bowtie) enforces neither, and a template carrying an apostrophe or an
// unencoded space is a document a stricter reading would refuse for no evidence.
func schemagenFormatURITemplate(v string) error {
	bad := func() error { return fmt.Errorf("%q is not a valid URI template", v) }
	for i := 0; i < len(v); i++ {
		switch v[i] {
		case '}':
			return bad()
		case '{':
			end := strings.IndexByte(v[i+1:], '}')
			if end < 0 {
				return bad()
			}
			body := v[i+1 : i+1+end]
			// An expression holds no "{": one inside the body means the "}"
			// found above closes a later expression, not this one.
			if strings.IndexByte(body, '{') >= 0 {
				return bad()
			}
			if !schemagenURITemplateExpression(body) {
				return bad()
			}
			i += end + 1
		}
	}
	return nil
}

// schemagenURITemplateExpression checks the body of one expression -- what sits
// between the braces.
func schemagenURITemplateExpression(body string) bool {
	if body != "" && strings.IndexByte(schemagenURITemplateOperators, body[0]) >= 0 {
		body = body[1:]
	}
	// variable-list is one varspec or more, and an expression that is an operator
	// alone -- or nothing at all -- has none. No separate guard for that: Split
	// of "" yields one empty element, which is the empty varspec the loop below
	// already refuses. An `if body == ""` beside it reads like a second rule and
	// is one no input can reach, which a planted fault showed by surviving it.
	for _, spec := range strings.Split(body, ",") {
		if !schemagenURITemplateVarspec(spec) {
			return false
		}
	}
	return true
}

// schemagenURITemplateVarspec checks one varspec: a varname and at most one
// modifier-level4, which is a prefix or an explode and not both.
func schemagenURITemplateVarspec(spec string) bool {
	if strings.HasSuffix(spec, "*") {
		spec = spec[:len(spec)-1]
	} else if i := strings.IndexByte(spec, ':'); i >= 0 {
		if !schemagenURITemplateMaxLength(spec[i+1:]) {
			return false
		}
		spec = spec[:i]
	}
	// ":" is no part of a varname in any reading of the grammar, so a colon
	// still here is a prefix written beside an explode -- "{v:1*}" -- which
	// modifier-level4 admits only one of.
	return spec != "" && strings.IndexByte(spec, ':') < 0
}

// schemagenURITemplateMaxLength checks RFC 6570's max-length:
//
//	max-length =  %x31-39 0*3DIGIT   ; positive integer < 10000
//
// One to four digits, the first of them non-zero. "{v:1}" and "{v:9999}" are the
// boundaries it admits; "{v:0}", "{v:01}", "{v:}" and "{v:10000}" are the ones
// just outside.
func schemagenURITemplateMaxLength(s string) bool {
	if len(s) < 1 || len(s) > 4 || s[0] < '1' || s[0] > '9' {
		return false
	}
	for i := 1; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	return true
}

var schemagenUUIDPattern = regexp.MustCompile(`^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$`)

func schemagenFormatUUID(v string) error {
	if !schemagenUUIDPattern.MatchString(v) {
		return fmt.Errorf("%q is not a valid UUID", v)
	}
	return nil
}

var schemagenJSONPointerPattern = regexp.MustCompile(`^(/([^~/]|~0|~1)*)*$`)

// schemagenFormatJSONPointer checks an RFC 6901 JSON Pointer. "" is the pointer
// that selects the whole document, and the pattern admits it.
func schemagenFormatJSONPointer(v string) error {
	if !schemagenJSONPointerPattern.MatchString(v) {
		return fmt.Errorf("%q is not a valid JSON Pointer", v)
	}
	return nil
}

var schemagenRelJSONPointerPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)(#|(/([^~/]|~0|~1)*)*)$`)

func schemagenFormatRelativeJSONPointer(v string) error {
	if !schemagenRelJSONPointerPattern.MatchString(v) {
		return fmt.Errorf("%q is not a valid relative JSON Pointer", v)
	}
	return nil
}

// schemagenFormatRegex checks an ECMA-262 regular expression.
//
// Compiled by the same ECMA-262 engine the "pattern" keyword uses, not by
// regexp.Compile. Go's RE2 is a different language: it rejects [^] and every
// lookaround, both of which are ordinary ECMA-262 and which the corpus marks
// valid. Judging one dialect's regular expressions by another's parser rejects
// what the schema permits.
func schemagenFormatRegex(v string) error {
	if _, err := ecma262.Compile(v, ecmaflags.Unicode); err != nil {
		return fmt.Errorf("%q is not a valid regex: %w", v, err)
	}
	return nil
}

func schemagenFormatIPv4(v string) error {
	a, err := netip.ParseAddr(v)
	if err != nil || !a.Is4() {
		return fmt.Errorf("%q is not a valid IPv4 address", v)
	}
	return nil
}

func schemagenFormatIPv6(v string) error {
	a, err := netip.ParseAddr(v)
	if err != nil || !a.Is6() || a.Zone() != "" {
		return fmt.Errorf("%q is not a valid IPv6 address", v)
	}
	return nil
}

// schemagenFormatIPv4Addr and schemagenFormatIPv6Addr are the same assertions
// against a value already held as a netip.Addr, which is what a declared
// "type":"string" with an ip format resolves to under an asserting dialect.
// Everything the parser rejects was refused at decode, so only the address
// family is left to test.
func schemagenFormatIPv4Addr(a netip.Addr) error {
	if a.IsValid() && !a.Is4() {
		return fmt.Errorf("%q is not a valid IPv4 address", a)
	}
	return nil
}

func schemagenFormatIPv6Addr(a netip.Addr) error {
	if a.IsValid() && !a.Is6() {
		return fmt.Errorf("%q is not a valid IPv6 address", a)
	}
	return nil
}

// schemagenDraft3ColorKeywords is every word CSS 2.1 admits where a colour is
// wanted: the seventeen colour keywords of section 4.3.6, the system colours of
// section 18.2, and "transparent".
//
// The last of those is not strictly a <color> in CSS 2.1 -- that specification
// gives it as a value of 'background-color' and 'border-color' rather than of
// the type -- and it is here anyway. Every implementation since has treated it
// as a colour, CSS Color 3 made it one outright, and accepting a word whose
// status is arguable withholds a rejection rather than inventing one, which is
// the direction this repository errs in.
//
// The system colours are deprecated and are here for the same reason: CSS 2.1
// does define them as colour values, and a document written against the
// specification draft 3 names is not wrong for using one.
var schemagenDraft3ColorKeywords = map[string]bool{
	"aqua": true, "black": true, "blue": true, "fuchsia": true, "gray": true,
	"green": true, "lime": true, "maroon": true, "navy": true, "olive": true,
	"orange": true, "purple": true, "red": true, "silver": true, "teal": true,
	"white": true, "yellow": true, "transparent": true,

	"activeborder": true, "activecaption": true, "appworkspace": true,
	"background": true, "buttonface": true, "buttonhighlight": true,
	"buttonshadow": true, "buttontext": true, "captiontext": true,
	"graytext": true, "highlight": true, "highlighttext": true,
	"inactiveborder": true, "inactivecaption": true, "inactivecaptiontext": true,
	"infobackground": true, "infotext": true, "menu": true, "menutext": true,
	"scrollbar": true, "threeddarkshadow": true, "threedface": true,
	"threedhighlight": true, "threedlightshadow": true, "threedshadow": true,
	"window": true, "windowframe": true, "windowtext": true,
}

// schemagenFormatDraft3Color checks draft 3's "color", which section 5.23 of
// that draft defines as a CSS colour "based on CSS 2.1" -- naming the
// specification by its dated URI, which is what makes this a fixed grammar and
// not a moving one.
//
// Three notations, and no more. #RGB and #RRGGBB; the rgb() function over three
// integers or three percentages; and a keyword. #RRGGBBAA is deliberately
// refused: CSS Color 4 added it and CSS 2.1 has no such thing, and the official
// suite marks "#00332520" invalid, so reading the keyword as modern CSS would
// accept a document draft 3 forbids. Nothing later than 2.1 is admitted for the
// same reason -- no hsl(), no lab(), no rebeccapurple.
//
// Keywords are matched case-insensitively, which is what CSS says of every
// identifier in the language.
func schemagenFormatDraft3Color(v string) error {
	bad := fmt.Errorf("%q is not a valid CSS 2.1 color", v)
	if v == "" {
		return bad
	}
	if v[0] == '#' {
		hex := v[1:]
		if len(hex) != 3 && len(hex) != 6 {
			return bad
		}
		for i := 0; i < len(hex); i++ {
			c := hex[i]
			switch {
			case c >= '0' && c <= '9', c >= 'a' && c <= 'f', c >= 'A' && c <= 'F':
			default:
				return bad
			}
		}
		return nil
	}
	lower := strings.ToLower(v)
	if strings.HasPrefix(lower, "rgb(") && strings.HasSuffix(lower, ")") {
		if schemagenDraft3RGB(lower[4 : len(lower)-1]) {
			return nil
		}
		return bad
	}
	if schemagenDraft3ColorKeywords[lower] {
		return nil
	}
	return bad
}

// schemagenDraft3RGB reports whether the argument list of an rgb() function is
// three components of one kind -- all integers, or all percentages, which CSS
// 2.1 forbids mixing. Values outside the range are clipped by that
// specification rather than refused, so they are accepted here.
func schemagenDraft3RGB(args string) bool {
	parts := strings.Split(args, ",")
	if len(parts) != 3 {
		return false
	}
	percentages := 0
	for _, p := range parts {
		p = strings.TrimSpace(p)
		if strings.HasSuffix(p, "%") {
			percentages++
			p = strings.TrimSuffix(p, "%")
		}
		if !schemagenDraft3CSSNumber(p) {
			return false
		}
	}
	return percentages == 0 || percentages == 3
}

// schemagenDraft3CSSNumber reports whether s is a CSS 2.1 <number>: an optional
// sign, then digits with an optional fractional part.
func schemagenDraft3CSSNumber(s string) bool {
	if s == "" {
		return false
	}
	if s[0] == '+' || s[0] == '-' {
		s = s[1:]
	}
	intPart, fracPart, hasDot := strings.Cut(s, ".")
	if hasDot && fracPart == "" {
		return false
	}
	if intPart == "" && fracPart == "" {
		return false
	}
	for _, digits := range []string{intPart, fracPart} {
		for i := 0; i < len(digits); i++ {
			if digits[i] < '0' || digits[i] > '9' {
				return false
			}
		}
	}
	return true
}
