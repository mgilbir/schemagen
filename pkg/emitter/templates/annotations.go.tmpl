{{define "annotation_helpers"}}
{{- /*
	$ev and $sc keep the dynamic scope out of a package that has no use for it.
	The evaluator threads a stack of schema resources through every recursive
	call, and a package whose schemas name no $dynamicRef or $recursiveRef would
	be carrying a parameter nothing ever reads. With the arms off, $ev is
	_evalNode and $sc is empty and the emitted evaluator is what it always was;
	with them on, the recursion goes through _evalNodeIn and _evalNode becomes
	the entry point that starts it with an empty scope -- so the callers outside
	this block, in annotation_schema and validation, are the same either way.
*/ -}}
{{- $ev := "_evalNode" -}}
{{- $sc := "" -}}
{{- if .AnnotationsDynamic -}}
{{- $ev = "_evalNodeIn" -}}
{{- $sc = ", _scope" -}}
{{- end -}}
// The types below evaluate JSON Schema at runtime, against a value decoded into
// `any`.
//
// Two callers reach it. One is unevaluatedItems next to in-place applicators:
// which items count as evaluated depends on which branches matched the value in
// hand, which is not knowable at generation time -- in
// {"anyOf":[A,B],"unevaluatedItems":false} the evaluated set is whatever the
// branches that matched *this value* evaluated. The other is a schema that
// constrains a value without giving it a Go type of its own, typically a root
// composition or a root "not": Go forbids methods on a type whose underlying
// type is an interface, so such a schema has nowhere to put a Validate() unless
// its raw JSON is wrapped and the schema kept as data.
//
// Only schemas whose whole subtree fits this model are compiled to it; anything
// else keeps the static checks, or is refused outright rather than evaluated
// with a keyword silently ignored.

// A node is declared in three runs rather than by vocabulary: everything held
// through a pointer, then everything held in a slice, then the one flag. The
// vocabulary grouping is kept inside each run, so a keyword is still beside its
// neighbours -- it just appears in whichever of the two runs its Go type puts it
// in.
//
// What it costs is what decides the order. This struct is instantiated once per
// subschema of the document, and every one of them is scanned by the garbage
// collector on each cycle, so a `bool` written between two pointers is not free:
// it pushes seven bytes of padding into the middle of the value and drags the
// scan past both. Pointers before slices for the same reason -- a slice carries
// its pointer in the first of its three words, and the length and capacity
// behind it are two words the scan has to cross to reach anything written after
// them. Putting the slices last means it crosses them once, at the end, and the
// flag after those is not scanned at all.
type _schemaNode struct {
	Boolean *bool // a bare true/false schema

	Const *string // JSON encoding of the const value

	MultipleOf       *float64
	Minimum          *float64
	Maximum          *float64
	ExclusiveMinimum *float64
	ExclusiveMaximum *float64

	MinLength *int
	MaxLength *int
	Pattern   *string
{{- if .AnnotationsFormats}}

	// Format is set only where the schema's own dialect asserts "format" and
	// this generator has a check for the name; on a dialect that annotates it,
	// and for a format nothing here judges, the node carries no field, because
	// there is nothing to judge rather than something skipped.
	Format *string
{{- end}}
{{- if .AnnotationsContent}}

	// The content vocabulary, on the one dialect that asserts it. Set under the
	// same rule as Format: present only where a check is going to be made.
	ContentEncoding  *string
	ContentMediaType *string
{{- end}}

	Items       *_schemaNode // items as a single schema: applies past the tuple
	Contains    *_schemaNode
	MinContains *int
	MaxContains *int
	MinItems    *int
	MaxItems    *int

	AdditionalProperties *_schemaNode
	PropertyNames        *_schemaNode
	MinProperties        *int
	MaxProperties        *int

	Not *_schemaNode

	If   *_schemaNode
	Then *_schemaNode
	Else *_schemaNode

	UnevaluatedItems      *_schemaNode
	UnevaluatedProperties *_schemaNode
{{- if .AnnotationsDynamic}}

	// Ref evaluates another node in place of this one, and is how a schema that
	// contains itself is expressed: an object whose additionalProperties are
	// objects of the same shape is a cycle, and a cycle is not a tree of
	// composite literals. Go refuses a cycle between package-level variable
	// initialisers, so the nodes taking part in one are declared empty and
	// assigned in init().
	Ref *_schemaNode

	// DynamicRef is a $dynamicRef or $recursiveRef, and is another conjunct like
	// AllOf: the drafts that define these keywords are the drafts where a
	// reference applies beside its siblings rather than replacing them.
	DynamicRef *_dynamicRef
{{- end}}

	Type []string // the JSON types the value may have; empty means any
	Enum []string // JSON encodings of the permitted values

	PrefixItems []_schemaNode // tuple positions (prefixItems, or draft-2019 tuple-form items)

	Properties        []_schemaMember // by property name
	PatternProperties []_schemaMember // by ECMA-262 pattern over the key
	Required          []string
	DependentRequired []_schemaDependency
	DependentSchemas  []_schemaMember

	AllOf []_schemaNode
	AnyOf []_schemaNode
	OneOf []_schemaNode
{{- if .AnnotationsDynamic}}

	// DynamicAnchors marks this node as *entering* a schema resource and lists
	// what that resource contributes to the dynamic scope while it is being
	// evaluated. Entering is not the same as being the resource's root: a
	// reference into the middle of a resource enters it too, and the frame then
	// hangs off the node the reference landed on. Only the anchors some
	// reference in this schema searches for are listed; an anchor nothing looks
	// up changes no answer.
	DynamicAnchors []_schemaAnchor
{{- end}}

	UniqueItems bool
}
{{- if .AnnotationsDynamic}}

// _schemaAnchor is one $dynamicAnchor -- or one $recursiveAnchor, which is filed
// under the empty name, a name no $dynamicAnchor may have -- that a schema
// resource publishes while it is on the dynamic scope.
//
// A nil Node means the node this frame hangs off. That is not a shorthand: such
// an anchor names the very node that carries it, and a node holding a pointer to
// itself cannot be written as a composite literal. Where a reference entered a
// resource part-way, the anchor and the node differ and the generator writes the
// node out instead, so this spelling always means the same thing.
type _schemaAnchor struct {
	Node *_schemaNode
	Name string
}

// _dynamicRef is a reference whose target is decided by the path taken to it
// rather than by where it is written.
//
// The scope is searched from the outermost resource inwards, so the same keyword
// means different things down different paths -- which is the whole point of it,
// and why no amount of reading the schema settles it in advance. Fallback is
// where it points when the path entered no resource publishing the anchor, which
// is what a plain $ref would have meant.
type _dynamicRef struct {
	Fallback *_schemaNode
	Anchor   string
}

// _schemaFrame is one schema resource on the dynamic scope, holding what it
// publishes and the node that entered it -- the latter because an anchor on that
// node is recorded as naming no node at all, and this is the node it names.
type _schemaFrame struct {
	node    *_schemaNode
	anchors []_schemaAnchor
}

// _dynResolveRef picks the node a $dynamicRef or $recursiveRef names, by walking
// the dynamic scope from the outermost resource inwards and taking the first one
// that publishes the anchor.
func _dynResolveRef(r *_dynamicRef, scope []_schemaFrame) *_schemaNode {
	for i := range scope {
		for _, anchor := range scope[i].anchors {
			if anchor.Name != r.Anchor {
				continue
			}
			if anchor.Node != nil {
				return anchor.Node
			}
			return scope[i].node
		}
	}
	return r.Fallback
}
{{- end}}

// _schemaMember is one entry of a keyword whose argument is an object mapping a
// name or a pattern to a schema. A slice rather than a map so the order the
// generator emitted is the order they are checked, and a failure names the same
// member every run.
type _schemaMember struct {
	Key  string
	Node _schemaNode
}

// _schemaDependency is one entry of dependentRequired: when Key is present,
// every name in Keys must be too.
type _schemaDependency struct {
	Key  string
	Keys []string
}

// _evalResult is one node's verdict, the reason it failed, and the annotations
// it produced: the item indices and the property names it evaluated.
//
// The two sets are what unevaluatedItems and unevaluatedProperties read. They
// are kept apart rather than merged into one because the keywords are: an index
// evaluated by prefixItems says nothing about a property name, and a schema can
// state both keywords over the same node.
//
// Declared pointer-carrying members first and flags last, as every struct in
// this file is: a bool between two maps costs seven bytes of padding and drags
// the collector's scan across both.
type _evalResult struct {
	evaluated      map[int]bool
	evaluatedProps map[string]bool
	reason         string
	ok             bool
	// reasonIsAStep says reason opens with a step into the value -- a property
	// this node descended into, or the branch of a conditional that refused --
	// rather than being a sentence about the value itself.
	//
	// It decides what goes between the reason and the path of whatever holds the
	// value: a "." in front of a step, ": " in front of a sentence. Only the site
	// that raised the failure knows which of the two it built, so the answer is
	// recorded there and travels with the reason; a caller who guessed wrote
	// `p.value matches no anyOf branch`, a member the document does not have.
	// See issue #284 and jsonPathError.
	reasonIsAStep bool
}

func _newEval(ok bool) _evalResult {
	return _evalResult{ok: ok, evaluated: map[int]bool{}, evaluatedProps: map[string]bool{}}
}

func (r *_evalResult) absorb(other _evalResult) {
	for i := range other.evaluated {
		r.evaluated[i] = true
	}
	for k := range other.evaluatedProps {
		r.evaluatedProps[k] = true
	}
}

// fail marks the result as failed with a sentence about the value itself, which
// is what all but a handful of keywords have to say. It records the first reason
// given; later keywords cannot overwrite it because evaluation returns at the
// first failure.
func (r *_evalResult) fail(reason string) _evalResult {
	r.ok = false
	r.reason = reason
	r.reasonIsAStep = false
	return *r
}

// failAt is fail for a failure this node reaches by stepping into the value: a
// property it descended into, a branch of a conditional, a dependent schema. The
// step and the reason underneath it are joined the way a path is, and the result
// is marked as opening with a step so that whatever holds this value joins its
// own path to it with a "." rather than a ": ".
func (r *_evalResult) failAt(step, reason string) _evalResult {
	r.ok = false
	r.reason = step + ": " + reason
	r.reasonIsAStep = true
	return *r
}

// failAs re-raises a child's failure at this node unchanged. An in-place
// applicator -- allOf, a $dynamicRef, items, unevaluatedItems -- judges the very
// value this node was handed, so what the child said about it is what this node
// has to say, and how it joins is the child's answer too.
func (r *_evalResult) failAs(child _evalResult) _evalResult {
	r.ok = false
	r.reason = child.reason
	r.reasonIsAStep = child.reasonIsAStep
	return *r
}

// _evalError turns a failed evaluation into the error a Validate answers with,
// carrying what has to be written between the reason and the path of the value
// it was raised on. A reason that opens with a step is joined the way a path is;
// a sentence about the value takes the ": " jsonValueErrorf records.
func _evalError(r _evalResult) error {
	if r.reason == "" {
		// Structural: nothing sets ok to false without a reason, and this exists
		// so that a future keyword which did would still say something rather
		// than answer with an empty message.
		return jsonValueErrorf("value does not satisfy the schema")
	}
	if r.reasonIsAStep {
		return jsonStepErrorf("%s", r.reason)
	}
	return jsonValueErrorf("%s", r.reason)
}

// _evalNode reports whether v satisfies n, together with the item annotations
// produced. Annotations from a subschema count only when that subschema
// matched: a failed anyOf branch contributes nothing.
{{- if .AnnotationsDynamic}}
//
// Nothing has been entered when validation starts, so the dynamic scope starts
// empty.
func _evalNode(n *_schemaNode, v any) _evalResult { return _evalNodeIn(n, v, nil) }

// _evalNodeIn is _evalNode carrying the schema resources entered on the way
// here, which is what a $dynamicRef is resolved against.
{{- end}}
func {{$ev}}(n *_schemaNode, v any{{if .AnnotationsDynamic}}, _scope []_schemaFrame{{end}}) _evalResult {
	if n == nil {
		return _newEval(true)
	}
{{- if .AnnotationsDynamic}}
	if n.Ref != nil {
		return {{$ev}}(n.Ref, v{{$sc}})
	}
	if len(n.DynamicAnchors) > 0 {
		// This node enters a schema resource, so the resource is in scope for as
		// long as it is being evaluated and out of scope again on the way back --
		// which is what makes a $dynamicRef's target depend on the path rather
		// than on the text. The slice is grown with its capacity clipped so that
		// the append copies: two branches evaluated from the same scope would
		// otherwise write their frames over each other's.
		_scope = append(_scope[:len(_scope):len(_scope)], _schemaFrame{node: n, anchors: n.DynamicAnchors})
	}
{{- end}}
	res := _newEval(true)
	if n.Boolean != nil {
		if *n.Boolean {
			return res
		}
		return res.fail("schema is false, which no value satisfies")
	}

	if len(n.Type) > 0 && !_dynTypeMatchesAny(n.Type, v) {
		return res.fail("value is not of type " + _dynJoin(n.Type))
	}
	if n.Const != nil && !_dynEqualsJSON(v, *n.Const) {
		return res.fail("value is not the constant " + *n.Const)
	}
	if len(n.Enum) > 0 {
		found := false
		for _, want := range n.Enum {
			if _dynEqualsJSON(v, want) {
				found = true
				break
			}
		}
		if !found {
			return res.fail("value is not one of the permitted values")
		}
	}

	if n.MultipleOf != nil && !_dynNumOK(v, func(f float64) bool { return _dynMultipleOf(f, *n.MultipleOf) }) {
		return res.fail("value is not a multiple of the required factor")
	}
	if n.Minimum != nil && !_dynNumOK(v, func(f float64) bool { return f >= *n.Minimum }) {
		return res.fail("value is below the minimum")
	}
	if n.Maximum != nil && !_dynNumOK(v, func(f float64) bool { return f <= *n.Maximum }) {
		return res.fail("value is above the maximum")
	}
	if n.ExclusiveMinimum != nil && !_dynNumOK(v, func(f float64) bool { return f > *n.ExclusiveMinimum }) {
		return res.fail("value is not above the exclusive minimum")
	}
	if n.ExclusiveMaximum != nil && !_dynNumOK(v, func(f float64) bool { return f < *n.ExclusiveMaximum }) {
		return res.fail("value is not below the exclusive maximum")
	}

	if n.MinLength != nil && !_dynStrOK(v, func(s string) bool { return _dynRuneLen(s) >= *n.MinLength }) {
		return res.fail("string is shorter than the minimum length")
	}
	if n.MaxLength != nil && !_dynStrOK(v, func(s string) bool { return _dynRuneLen(s) <= *n.MaxLength }) {
		return res.fail("string is longer than the maximum length")
	}
{{- if .AnnotationsPattern}}
	if n.Pattern != nil && !_dynStrOK(v, func(s string) bool { return _dynPatternOK(*n.Pattern, s) }) {
		return res.fail("string does not match the required pattern")
	}
{{- end}}
{{- if .AnnotationsFormats}}
	// _dynStrOK, so a non-string passes: "format" is defined over strings and
	// says nothing about a number, an object or a null. That is the same reading
	// every other position takes -- a format check is built against a value the
	// schema has already made a string, and propertyNames applies one to a key,
	// which is a string wherever it appears.
	if n.Format != nil && !_dynStrOK(v, func(s string) bool { return _dynFormatOK(*n.Format, s) }) {
		return res.fail("string does not satisfy the required format")
	}
{{- end}}
{{- if .AnnotationsContent}}
	if (n.ContentEncoding != nil || n.ContentMediaType != nil) && !_dynStrOK(v, func(s string) bool {
		return schemagenContentString(s, _dynStrOr(n.ContentEncoding), _dynStrOr(n.ContentMediaType)) == nil
	}) {
		return res.fail("string does not satisfy the content vocabulary")
	}
{{- end}}

	arr, isArray := v.([]any)
	// Read once, up here, because unevaluatedProperties needs the object again
	// after every in-place applicator below has had its turn.
	obj, isObject := v.(map[string]any)

	if isArray {
		if n.MinItems != nil && len(arr) < *n.MinItems {
			return res.fail("array has fewer items than the minimum")
		}
		if n.MaxItems != nil && len(arr) > *n.MaxItems {
			return res.fail("array has more items than the maximum")
		}
		if n.UniqueItems && !_dynUnique(arr) {
			return res.fail("array items are not unique")
		}
	}

	// Tuple positions, then items for the remainder.
	if isArray && len(n.PrefixItems) > 0 {
		for i, sub := range n.PrefixItems {
			if i >= len(arr) {
				break
			}
			sub := sub
			r := {{$ev}}(&sub, arr[i]{{$sc}})
			if !r.ok {
				return res.failAs(r)
			}
			res.evaluated[i] = true
		}
	}
	if isArray && n.Items != nil {
		for i := len(n.PrefixItems); i < len(arr); i++ {
			r := {{$ev}}(n.Items, arr[i]{{$sc}})
			if !r.ok {
				return res.failAs(r)
			}
			res.evaluated[i] = true
		}
	}

	// contains: matching indices are evaluated, and the count gates the node.
	if isArray && n.Contains != nil {
		count := 0
		for i, elem := range arr {
			if {{$ev}}(n.Contains, elem{{$sc}}).ok {
				res.evaluated[i] = true
				count++
			}
		}
		min := 1
		if n.MinContains != nil {
			min = *n.MinContains
		}
		if count < min {
			return res.fail("array does not contain enough matching items")
		}
		if n.MaxContains != nil && count > *n.MaxContains {
			return res.fail("array contains too many matching items")
		}
	}

	if isObject {
		for _, key := range n.Required {
			if _, present := obj[key]; !present {
				return res.fail("object is missing required property " + key)
			}
		}
		if n.MinProperties != nil && len(obj) < *n.MinProperties {
			return res.fail("object has fewer properties than the minimum")
		}
		if n.MaxProperties != nil && len(obj) > *n.MaxProperties {
			return res.fail("object has more properties than the maximum")
		}
		if n.PropertyNames != nil {
			for _, key := range _dynSortedKeys(obj) {
				r := {{$ev}}(n.PropertyNames, key{{$sc}})
				if !r.ok {
					return res.failAt("property name "+key, r.reason)
				}
			}
		}
		for i := range n.Properties {
			member := n.Properties[i]
			value, present := obj[member.Key]
			if !present {
				continue
			}
			r := {{$ev}}(&member.Node, value{{$sc}})
			if !r.ok {
				return res.failAt("property "+member.Key, r.reason)
			}
			// The property is evaluated by this node, so unevaluatedProperties
			// no longer speaks about it. The subschema's own annotations are
			// about the property's *value* and belong to it, not here, which is
			// why r is not absorbed.
			res.evaluatedProps[member.Key] = true
		}
{{- if .AnnotationsPattern}}
		for i := range n.PatternProperties {
			member := n.PatternProperties[i]
			for _, key := range _dynSortedKeys(obj) {
				if !_dynPatternOK(member.Key, key) {
					continue
				}
				r := {{$ev}}(&member.Node, obj[key]{{$sc}})
				if !r.ok {
					return res.failAt("property "+key, r.reason)
				}
				res.evaluatedProps[key] = true
			}
		}
{{- end}}
		if n.AdditionalProperties != nil {
			for _, key := range _dynSortedKeys(obj) {
				if _dynMemberNamed(n.Properties, key) {
					continue
				}
{{- if .AnnotationsPattern}}
				if _dynMemberMatches(n.PatternProperties, key) {
					continue
				}
{{- end}}
				r := {{$ev}}(n.AdditionalProperties, obj[key]{{$sc}})
				if !r.ok {
					return res.failAt("property "+key, r.reason)
				}
				res.evaluatedProps[key] = true
			}
		}
		for _, dep := range n.DependentRequired {
			if _, present := obj[dep.Key]; !present {
				continue
			}
			for _, needed := range dep.Keys {
				if _, ok := obj[needed]; !ok {
					return res.fail("property " + dep.Key + " requires property " + needed)
				}
			}
		}
		for i := range n.DependentSchemas {
			member := n.DependentSchemas[i]
			if _, present := obj[member.Key]; !present {
				continue
			}
			r := {{$ev}}(&member.Node, v{{$sc}})
			if !r.ok {
				return res.failAt("dependent schema for "+member.Key, r.reason)
			}
			res.absorb(r)
		}
	}

	// In-place applicators contribute their annotations to this node.
{{- if .AnnotationsDynamic}}
	// A $dynamicRef is one of them, and is resolved here rather than earlier
	// because the scope it is resolved against is the one this node has just
	// joined: a resource whose own root carries the reference publishes its
	// anchors to it, which is what "$recursiveRef with no $recursiveAnchor in
	// the outer schema resource" turns on.
	if n.DynamicRef != nil {
		r := {{$ev}}(_dynResolveRef(n.DynamicRef, _scope), v{{$sc}})
		if !r.ok {
			return res.failAs(r)
		}
		res.absorb(r)
	}
{{- end}}
	for i := range n.AllOf {
		sub := n.AllOf[i]
		r := {{$ev}}(&sub, v{{$sc}})
		if !r.ok {
			return res.failAs(r)
		}
		res.absorb(r)
	}
	if len(n.AnyOf) > 0 {
		any := false
		for i := range n.AnyOf {
			sub := n.AnyOf[i]
			r := {{$ev}}(&sub, v{{$sc}})
			if r.ok {
				any = true
				res.absorb(r)
			}
		}
		if !any {
			return res.fail("value matches no anyOf branch")
		}
	}
	if len(n.OneOf) > 0 {
		matches := 0
		var matched _evalResult
		for i := range n.OneOf {
			sub := n.OneOf[i]
			r := {{$ev}}(&sub, v{{$sc}})
			if r.ok {
				matches++
				matched = r
			}
		}
		if matches != 1 {
			return res.fail("value matches " + _dynItoa(matches) + " oneOf branches, expected exactly 1")
		}
		res.absorb(matched)
	}
	// "not" contributes no annotations: a subschema that must fail evaluates
	// nothing, and one that succeeds is a failure of this node.
	if n.Not != nil && {{$ev}}(n.Not, v{{$sc}}).ok {
		return res.fail("value matches a forbidden schema")
	}
	// The branch that refused names itself, the way a property this node
	// descended into does. "if" cannot name it: a condition is not an assertion,
	// so a document is never refused by it -- a condition that fails selects
	// "else", or, where there is no "else", accepts. A message that opened with
	// "if" therefore sent the caller to a sub-schema that says nothing about the
	// value at fault (issue #281), and only this site knows which of "then" and
	// "else" was the one that ran.
	if n.If != nil {
		r := {{$ev}}(n.If, v{{$sc}})
		if r.ok {
			res.absorb(r)
			if n.Then != nil {
				tr := {{$ev}}(n.Then, v{{$sc}})
				if !tr.ok {
					return res.failAt("then", tr.reason)
				}
				res.absorb(tr)
			}
		} else if n.Else != nil {
			er := {{$ev}}(n.Else, v{{$sc}})
			if !er.ok {
				return res.failAt("else", er.reason)
			}
			res.absorb(er)
		}
	}

	// unevaluatedItems sees only what *this* node's own subschemas evaluated.
	// A sibling's annotations are invisible: in
	// {"allOf":[{"prefixItems":[true]},{"unevaluatedItems":false}]} the second
	// branch is a cousin of the first and sees nothing, so any non-empty array
	// fails.
	if isArray && n.UnevaluatedItems != nil {
		for i := range arr {
			if res.evaluated[i] {
				continue
			}
			r := {{$ev}}(n.UnevaluatedItems, arr[i]{{$sc}})
			if !r.ok {
				return res.failAs(r)
			}
			res.evaluated[i] = true
		}
	}

	// unevaluatedProperties, read the same way and for the same reason: only the
	// properties *this* node's own subschemas evaluated are exempt, and a branch
	// that failed evaluated nothing -- which is the whole point of settling it
	// here rather than at generation time. In
	// {"anyOf":[{"properties":{"b":{}},"unevaluatedProperties":false},
	//           {"required":["a"]}]}
	// the document {"a":1} satisfies the second branch, and the first branch's
	// keyword never applies because that branch does not match.
	if isObject && n.UnevaluatedProperties != nil {
		for _, key := range _dynSortedKeys(obj) {
			if res.evaluatedProps[key] {
				continue
			}
			r := {{$ev}}(n.UnevaluatedProperties, obj[key]{{$sc}})
			if !r.ok {
				return res.failAt("unevaluated property "+key, r.reason)
			}
			res.evaluatedProps[key] = true
		}
	}

	return res
}

func _node(n _schemaNode) *_schemaNode { return &n }
func _boolPtr(b bool) *bool            { return &b }
func _strPtr(s string) *string         { return &s }
func _intPtr(i int) *int               { return &i }
func _floatPtr(f float64) *float64     { return &f }

func _dynTypeMatches(t string, v any) bool {
	switch t {
	case "integer":
		return _dynIsInteger(v)
	case "number":
		return _dynIsNumber(v)
	case "string":
		return _dynIsString(v)
	case "boolean":
		return _dynIsBool(v)
	case "object":
		return _dynIsObject(v)
	case "array":
		return _dynIsArray(v)
	case "null":
		return v == nil
	}
	return true
}

// _dynTypeMatchesAny reads a type union the way JSON Schema does: the value has
// to match one of the listed types, not all of them.
func _dynTypeMatchesAny(types []string, v any) bool {
	for _, t := range types {
		if _dynTypeMatches(t, v) {
			return true
		}
	}
	return false
}

// _dynEqualsJSON compares a decoded value against a const by re-encoding it, so
// equality follows JSON semantics rather than Go's.
func _dynEqualsJSON(v any, want string) bool {
	got, err := json.Marshal(v)
	if err != nil {
		return false
	}
	var a, b any
	if json.Unmarshal(got, &a) != nil || json.Unmarshal([]byte(want), &b) != nil {
		return false
	}
	return reflect.DeepEqual(a, b)
}

// _dynMultipleOf avoids the floating point error that plain math.Mod shows for
// values such as 4.5 / 1.5.
func _dynMultipleOf(f, by float64) bool {
	if by == 0 {
		return false
	}
	q := f / by
	return q == math.Trunc(q)
}

// _dynRuneLen counts characters rather than bytes, which is the unit minLength
// and maxLength are defined in.
func _dynRuneLen(s string) int { return len([]rune(s)) }

// _dynUnique reports whether every element of an array is distinct under JSON
// equality, which is what uniqueItems compares by: 1 and 1.0 are the same value
// however they were written, and so are two objects with the same members in a
// different order.
//
// Re-encoding each element settles both. encoding/json sorts object keys, and a
// decoded number is a float64 whichever notation the document used, so two
// elements produce the same bytes exactly when they are the same JSON value.
func _dynUnique(arr []any) bool {
	seen := make(map[string]bool, len(arr))
	for _, elem := range arr {
		raw, err := json.Marshal(elem)
		if err != nil {
			return false
		}
		if seen[string(raw)] {
			return false
		}
		seen[string(raw)] = true
	}
	return true
}

// _dynSortedKeys returns an object's keys in a fixed order, so a document with
// several offending properties fails on the same one every run.
func _dynSortedKeys(obj map[string]any) []string {
	keys := make([]string, 0, len(obj))
	for k := range obj {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

func _dynMemberNamed(members []_schemaMember, key string) bool {
	for i := range members {
		if members[i].Key == key {
			return true
		}
	}
	return false
}

func _dynJoin(parts []string) string {
	out := ""
	for i, p := range parts {
		if i > 0 {
			out += " or "
		}
		out += p
	}
	return out
}

func _dynItoa(i int) string { return strconv.Itoa(i) }
{{- if .AnnotationsPattern}}

// _dynPatternOK applies an ECMA-262 regular expression the way JSON Schema
// does, as a search rather than a full-string match. A pattern the engine
// cannot compile matches nothing, which is the same answer the static checks
// give.
func _dynPatternOK(pattern, s string) bool {
	matched, err := ecma262.MatchString(pattern, ecmaflags.Unicode, s)
	return err == nil && matched
}

func _dynMemberMatches(members []_schemaMember, key string) bool {
	for i := range members {
		if _dynPatternOK(members[i].Key, key) {
			return true
		}
	}
	return false
}
{{- end}}
{{- if .AnnotationsFormats}}

// _dynFormatOK applies a "format" assertion, dispatching to the same helper
// every other position in this package calls for the same format name.
//
// There is one arm per format the compiled schemas actually name, rather than
// one per format schemagen can check. A switch over all of them would name the
// four hostname helpers whatever the schemas said, and those live in the block
// that needs golang.org/x/net/idna -- so a package asserting nothing but
// `format: date` would acquire that dependency for an arm it never reaches.
//
// A name with no arm returns true. It cannot occur: the node carries a format
// only where FormatCheckableOnString admitted it, and a format admitted there
// and missing here is a build failure at the call rather than a silent pass.
// The default exists because Go requires the function to return.
func _dynFormatOK(format, s string) bool {
	switch format {
{{- range .AnnotationsFormats}}
{{- $fn := formatHelperName . true}}
{{- if $fn}}
	case {{printf "%q" .}}:
		return {{$fn}}(s) == nil
{{- end}}
{{- end}}
	}
	return true
}
{{- end}}
{{- if .AnnotationsContent}}

// _dynStrOr reads an optional node field as a string, with "" meaning the schema
// stated no such keyword. schemagenContentString takes "" for either argument
// and skips that half of the check, which is the same reading ContentCheck gives
// the static path.
func _dynStrOr(p *string) string {
	if p == nil {
		return ""
	}
	return *p
}
{{- end}}
{{- end}}
