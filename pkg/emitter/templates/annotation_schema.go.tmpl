{{define "annotation_schema"}}
{{- $recv := receiverName .Name -}}
{{- template "type_doc" .}}
// {{.Name}} accepts any JSON value. Its schema is held as data and interpreted
// at validation time, either because an unevaluatedItems constraint depends on
// which items the applicators evaluate for the value in hand, or because the
// schema gives the value no Go type of its own to hang a check on.
{{- template "annotation_comment" mkAnnotationCtx .Annotations "" true}}
type {{.Name}} struct {
	_raw json.RawMessage
}

{{- if .AccessRules}}

// {{.AccessRulesVar}} is what --strict-read-write has to say about this value.
// This type has no fields at all -- its whole schema is held as data -- so the
// key lists a struct's decoder and encoder carry have nowhere to live here, and
// until issue #219 the flag did nothing to a value that reached this type: a
// readOnly property was accepted and a writeOnly one written straight back out.
var {{.AccessRulesVar}} = {{accessRules .AccessRules}}
{{- end}}

{{- if .AccessRules}}

// UnmarshalJSON replaces {{$recv}} with the value the document holds. See
// decodeJSONAt.
func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	_d, _sp, _err := jsonOpenDoc(data)
	if _err != nil {
		return jsonDecodeRefusal(_err)
	}
	return _d.finish({{$recv}}.decodeJSONAt(_d, _sp))
}

// decodeJSONAt keeps the value at _sp, replacing whatever {{$recv}} held. The
// bytes kept are the document's own copy (see jsonDoc.keep): the methods that
// hand them out hand out copies.
//
// A value setting a location the schema marks readOnly is still kept whole: the
// refusal is recorded on the document and returned once the decode is done
// (see jsonDoc.finish), so a Validate check that has to ignore it -- readOnly
// constrains no document -- has the value to judge.
func ({{$recv}} *{{.Name}}) decodeJSONAt(_d *jsonDoc, _sp jsonSpan) error {
	*{{$recv}} = {{.Name}}{}
	if _d.refusal == nil {
		if _err := _accessRefuseReadOnly(_d, _sp, {{.AccessRulesVar}}); _err != nil {
			_d.refusal = _err
		}
	}
	{{$recv}}._raw = _d.keep(_sp)
	return nil
}

// MarshalJSON writes the value back, without the locations the schema marks
// writeOnly.
func ({{$recv}} {{.Name}}) MarshalJSON() ([]byte, error) {
	if len({{$recv}}._raw) == 0 {
		return []byte("null"), nil
	}
	return _accessStripWriteOnly(append([]byte(nil), {{$recv}}._raw...), {{.AccessRulesVar}})
}

// Raw returns a copy of the value's bytes.
func ({{$recv}} {{.Name}}) Raw() json.RawMessage { return append(json.RawMessage(nil), {{$recv}}._raw...) }
{{- if .HasIdentity}}

// jsonIdentity is {{$recv}}'s identity as JSON: that of what MarshalJSON writes,
// the value's bytes with the writeOnly locations stripped -- read off the
// value's tree with them taken out of it (see _accessStripTree), rather than
// off what MarshalJSON writes. See jsonID.
func ({{$recv}} *{{.Name}}) jsonIdentity(_m *jsonValidation) (jsonID, error) {
	if len({{$recv}}._raw) == 0 {
		return jsonIDNull(_m)
	}
	_t, _err := jsonTreeRaw({{$recv}}._raw, false)
	if _err != nil {
		return jsonID{}, _err
	}
	if _t, _err = _accessStripTree(_t, {{.AccessRulesVar}}); _err != nil {
		return jsonID{}, _err
	}
	if _m.reading() {
		_m.push(_t)
		return jsonID{}, nil
	}
	return jsonIDAny(_t, _m)
}
{{- end}}
{{- else}}
{{template "raw_holder_methods" .}}
{{- end}}

// IsZero reports whether no value was present, so an optional field tagged
// ",omitzero" is omitted when absent rather than marshalled as null.
func ({{$recv}} {{.Name}}) IsZero() bool { return len({{$recv}}._raw) == 0 }

func ({{$recv}} {{.Name}}) String() string { return string({{$recv}}._raw) }

{{- if .Nodes}}
// {{.SchemaVar}} is the schema {{.Name}} validates against, and the nodes below
// it are the parts of that schema something inside it refers back to.
//
// They are assembled in init() rather than declared with their values because
// the schema is recursive, and Go refuses a cycle between package-level variable
// initialisers. Taking a node's address is not part of that cycle, so the
// assignments may run in any order.
var (
	{{.SchemaVar}} _schemaNode
{{- range .Nodes}}
	{{.Name}} _schemaNode
{{- end}}
)

func init() {
{{- range .Nodes}}
	{{.Name}} = {{.Literal}}
{{- end}}
	{{$.SchemaVar}} = {{$.NodeLiteral}}
}
{{- else}}
// {{.SchemaVar}} is the schema {{.Name}} validates against.
var {{.SchemaVar}} = {{.NodeLiteral}}
{{- end}}

// Validate checks {{.Name}} against its JSON Schema constraints.
func ({{$recv}} {{.Name}}) Validate() error {
	// No value was present. A constraint applies to a value that is there; an
	// absent optional property is the parent's business (required), not this
	// type's.
	if len({{$recv}}._raw) == 0 {
		return nil
	}
	// Read one level at a time (see jsonLazy), as the evaluator asks for each
	// level. Decoded whole, the value was an any the evaluator's checks that
	// compare values -- uniqueItems, const, enum -- read the identity of afresh at
	// every level of a document; read off a document, what one level computes is
	// kept there for the next (see jsonLazy.jsonDocID).
	_v, _err := jsonReadLazily({{$recv}}._raw)
	if _err != nil {
		// A sentence about the value, joined by the same rule as the verdict
		// below. Structural: the raw bytes came from a decoder that had already
		// accepted them as JSON, so nothing has been seen to reach this.
		return jsonValueErrorf("cannot decode value: %w", _err)
	}
	{{- /* The evaluator's reason is put behind whatever path reaches this value by
	       the same rule as every other message (see _evalError and
	       jsonPathError). Handed up bare, a sentence about the value was joined
	       as though it were a member name: `p.value matches no anyOf branch`,
	       naming a member p.value the document does not have. Issue #284. */}}
	if _res := _evalNode(&{{.SchemaVar}}, _v); !_res.ok {
		return _evalError(_res)
	}
	return nil
}
{{- end}}

{{/*
element_node declares an ElementNode: the schema of a type, compiled for the
runtime evaluator, which judges an element held as decoded JSON against it --
as it is held, where the element used to be marshalled and decoded into the
type. The hoisted nodes are assembled in init() for the reason an
AnnotationSchemaDef's are.
*/}}
{{define "element_node"}}
{{- if .Nodes}}
// {{.Var}} is the schema of {{.TypeName}}, compiled for judging an element held as
// decoded JSON against it, and the nodes below it are the parts of that schema
// something inside it refers back to.
var (
	{{.Var}} _schemaNode
{{- range .Nodes}}
	{{.Name}} _schemaNode
{{- end}}
)

func init() {
{{- range .Nodes}}
	{{.Name}} = {{.Literal}}
{{- end}}
	{{$.Var}} = {{$.Literal}}
}
{{- else}}
// {{.Var}} is the schema of {{.TypeName}}, compiled for judging an element held as
// decoded JSON against it.
var {{.Var}} = {{.Literal}}
{{- end}}
{{- end}}
