{{define "annotation_schema"}}
{{- $recv := receiverName .Name -}}
{{- if .Description}}
// {{.Name}} - {{comment "" .Description}}
{{- end}}
// {{.Name}} accepts any JSON value. Its schema is held as data and interpreted
// at validation time, either because an unevaluatedItems constraint depends on
// which items the applicators evaluate for the value in hand, or because the
// schema gives the value no Go type of its own to hang a check on.
type {{.Name}} struct {
	_raw json.RawMessage
}

func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	{{$recv}}._raw = append({{$recv}}._raw[:0], data...)
	return nil
}

func ({{$recv}} {{.Name}}) MarshalJSON() ([]byte, error) {
	if len({{$recv}}._raw) == 0 {
		return []byte("null"), nil
	}
	return {{$recv}}._raw, nil
}

func ({{$recv}} {{.Name}}) Raw() json.RawMessage { return {{$recv}}._raw }

// IsZero reports whether no value was present, so an optional field tagged
// ",omitzero" is omitted when absent rather than marshalled as null.
func ({{$recv}} {{.Name}}) IsZero() bool { return len({{$recv}}._raw) == 0 }

func ({{$recv}} {{.Name}}) String() string { return string({{$recv}}._raw) }

// {{.Name}}Schema is the schema {{.Name}} validates against.
var {{.Name}}Schema = {{.NodeLiteral}}

// Validate checks {{.Name}} against its JSON Schema constraints.
func ({{$recv}} {{.Name}}) Validate() error {
	// No value was present. A constraint applies to a value that is there; an
	// absent optional property is the parent's business (required), not this
	// type's.
	if len({{$recv}}._raw) == 0 {
		return nil
	}
	var _v any
	if _err := json.Unmarshal({{$recv}}._raw, &_v); _err != nil {
		return fmt.Errorf("cannot decode value: %w", _err)
	}
	if _res := _evalNode(&{{.Name}}Schema, _v); !_res.ok {
		if _res.reason == "" {
			return fmt.Errorf("value does not satisfy the schema")
		}
		return fmt.Errorf("%s", _res.reason)
	}
	return nil
}
