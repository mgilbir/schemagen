{{define "annotation_schema"}}
{{- $recv := receiverName .Name -}}
{{- if .Description}}
// {{.Name}} - {{comment "" .Description}}
{{- end}}
// {{.Name}} accepts any JSON value. Its schema is held as data and interpreted
// at validation time, either because an unevaluatedItems constraint depends on
// which items the applicators evaluate for the value in hand, or because the
// schema gives the value no Go type of its own to hang a check on.
{{- template "annotation_comment" mkAnnotationCtx .Annotations "" true}}
type {{.Name}} struct {
	_raw json.RawMessage
}

{{- if .AccessRules}}

// {{.Name}}AccessRules is what --strict-read-write has to say about this value.
// This type has no fields at all -- its whole schema is held as data -- so the
// key lists a struct's decoder and encoder carry have nowhere to live here, and
// until issue #219 the flag did nothing to a value that reached this type: a
// readOnly property was accepted and a writeOnly one written straight back out.
var {{.Name}}AccessRules = {{accessRules .AccessRules}}
{{- end}}

func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	{{- if .AccessRules}}
	if _err := _accessRefuseReadOnly(data, {{.Name}}AccessRules); _err != nil {
		return _err
	}
	{{- end}}
	{{$recv}}._raw = append({{$recv}}._raw[:0], data...)
	return nil
}

func ({{$recv}} {{.Name}}) MarshalJSON() ([]byte, error) {
	if len({{$recv}}._raw) == 0 {
		return []byte("null"), nil
	}
	{{- if .AccessRules}}
	return _accessStripWriteOnly({{$recv}}._raw, {{.Name}}AccessRules)
	{{- end}}
	{{- if not .AccessRules}}
	return {{$recv}}._raw, nil
	{{- end}}
}

func ({{$recv}} {{.Name}}) Raw() json.RawMessage { return {{$recv}}._raw }

// IsZero reports whether no value was present, so an optional field tagged
// ",omitzero" is omitted when absent rather than marshalled as null.
func ({{$recv}} {{.Name}}) IsZero() bool { return len({{$recv}}._raw) == 0 }

func ({{$recv}} {{.Name}}) String() string { return string({{$recv}}._raw) }

{{- if .Nodes}}
// {{.Name}}Schema is the schema {{.Name}} validates against, and the nodes below
// it are the parts of that schema something inside it refers back to.
//
// They are assembled in init() rather than declared with their values because
// the schema is recursive, and Go refuses a cycle between package-level variable
// initialisers. Taking a node's address is not part of that cycle, so the
// assignments may run in any order.
var (
	{{.Name}}Schema _schemaNode
{{- range .Nodes}}
	{{.Name}} _schemaNode
{{- end}}
)

func init() {
{{- range .Nodes}}
	{{.Name}} = {{.Literal}}
{{- end}}
	{{$.Name}}Schema = {{$.NodeLiteral}}
}
{{- else}}
// {{.Name}}Schema is the schema {{.Name}} validates against.
var {{.Name}}Schema = {{.NodeLiteral}}
{{- end}}

// Validate checks {{.Name}} against its JSON Schema constraints.
func ({{$recv}} {{.Name}}) Validate() error {
	// No value was present. A constraint applies to a value that is there; an
	// absent optional property is the parent's business (required), not this
	// type's.
	if len({{$recv}}._raw) == 0 {
		return nil
	}
	var _v any
	if _err := json.Unmarshal({{$recv}}._raw, &_v); _err != nil {
		// A sentence about the value, joined by the same rule as the verdict
		// below. Structural: the raw bytes came from a decoder that had already
		// accepted them as JSON, so nothing has been seen to reach this.
		return jsonValueErrorf("cannot decode value: %w", _err)
	}
	{{- /* The evaluator's reason is put behind whatever path reaches this value by
	       the same rule as every other message (see _evalError and
	       jsonPathError). Handed up bare, a sentence about the value was joined
	       as though it were a member name: `p.value matches no anyOf branch`,
	       naming a member p.value the document does not have. Issue #284. */}}
	if _res := _evalNode(&{{.Name}}Schema, _v); !_res.ok {
		return _evalError(_res)
	}
	return nil
}
{{- end}}
