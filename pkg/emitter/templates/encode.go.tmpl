// jsonIdentityMember reads the member of {{$recv}} numbered idx, as
// appendMemberJSON writes it. key is the member's key, which names the
// additionalProperties value to read.
func ({{$recv}} *{{.Name}}) jsonIdentityMember(_idx int, _key string, _m *jsonValidation) (jsonID, error) {
	_ = _key
	switch _idx {
	{{- range .EncodeMembers}}
	{{- if .Field}}
	{{- if not .Field.EncodeLeaf}}
	case {{.Index}}:
		return ({{.Field.Identifier}})(&{{$recv}}.{{.Field.Name}}, _m)
	{{- end}}
	{{- else}}
	case {{.Index}}:
		switch _sel := {{$recv}}.{{.OneOf.FieldName}}.(type) {
		{{- range .OneOf.Variants}}
		case *{{.WrapperName}}:
			return ({{.Identifier}})(&_sel.{{.FieldName}}, _m)
		{{- end}}
		}
	{{- end}}
	{{- end}}
	{{- range .EncodeManual}}
	case {{.Index}}:
		{{- if .OneOf}}
		switch _sel := {{$recv}}.{{.OneOf.FieldName}}.(type) {
		{{- range .OneOf.Variants}}
		case *{{.WrapperName}}:
			return ({{.Identifier}})(&_sel.{{.FieldName}}, _m)
		{{- end}}
		}
		{{- else}}
		return ({{.Field.Identifier}})(&{{$recv}}.{{.Field.Name}}, _m)
		{{- end}}
	{{- end}}
	{{- if and .AdditionalProperties (not (isRawMessage .AdditionalProperties.ValueType)) (not .AdditionalProperties.ValueEncodeLeaf)}}
	case {{.EncodeAdditionalMember}}:
		_v := {{$recv}}.AdditionalProperties[_key]
		return ({{.AdditionalProperties.ValueIdentifier}})(&_v, _m)
	{{- end}}
	}
	return jsonIDNull(_m)
