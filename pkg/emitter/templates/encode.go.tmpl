{{/*
struct_identity_fields reads the members a struct's tagged fields are written
as into _o, by the rules encode_field_object writes them by: a member holding
nothing of this package's is read now, and one that does is left for
jsonIdentityMember to read once the object is complete.
*/}}
{{define "struct_identity_fields"}}
{{- $recv := receiverName .Name -}}
	{{- range $mem := .EncodeMembers}}
	{{- with $mem.Field}}
	{
		{{- if .EncodeLeaf}}
		{{- if $mem.Omit}}
		if !{{if eq $mem.Omit "zero"}}jsonOmitZeroAt{{else}}jsonOmitEmptyAt{{end}}(&{{$recv}}.{{.Name}}) {
		{{- else}}
		{
		{{- end}}
			_id, _err := ({{.Identifier}})(&{{$recv}}.{{.Name}}, _m)
			if _err != nil {
				return jsonID{}, _err
			}
			_o.computed({{printf "%q" .JSONName}}, _id)
		}
		{{- else}}
		{{- if $mem.Omit}}
		if !{{if eq $mem.Omit "zero"}}jsonIsZero{{else}}jsonIsEmpty{{end}}({{$recv}}.{{.Name}}) {
			_o.idDeferred({{printf "%q" .JSONName}}, {{$mem.Index}})
		}
		{{- else}}
		_o.idDeferred({{printf "%q" .JSONName}}, {{$mem.Index}})
		{{- end}}
		{{- end}}
	}
	{{- end}}
	{{- end}}
{{- end}}

{{/*
