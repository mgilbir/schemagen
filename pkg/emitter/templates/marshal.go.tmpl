{{/*
marshal is a struct's MarshalJSON: its appendJSON, written into a buffer of its
own (see struct_encode in encode.go.tmpl).
*/}}
{{define "marshal"}}
{{- $struct := . -}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} {{$struct.Name}}) MarshalJSON() ([]byte, error) {
	{{- if $struct.AcceptNonObject}}
	// Non-object data was silently accepted — return the original raw bytes,
	// in a buffer of their own: the value's bytes, handed out, are bytes a
	// caller can rewrite the value through.
	if {{$recv}}._nonObject {
		if len({{$recv}}._rawNonObject) > 0 {
			return append([]byte(nil), {{$recv}}._rawNonObject...), nil
		}
		return []byte("null"), nil
	}
	{{- end}}
	_b, _err := {{$recv}}.appendJSON(nil)
	if _err != nil {
		return nil, _err
	}
	return _b, nil
}
{{- end}}
