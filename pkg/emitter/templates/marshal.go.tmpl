{{define "marshal"}}
{{- $struct := . -}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} {{$struct.Name}}) MarshalJSON() ([]byte, error) {
	{{- if $struct.AcceptNonObject}}
	// Non-object data was silently accepted — return the original raw bytes.
	if {{$recv}}._nonObject {
		if len({{$recv}}._rawNonObject) > 0 {
			return {{$recv}}._rawNonObject, nil
		}
		return []byte("null"), nil
	}
	{{- end}}
	{{- /* Check if we have any top-level oneOfs (empty JSONName) */}}
	{{- $hasTopLevelOneOf := false}}
	{{- range $struct.OneOfs}}
	{{- if not .JSONName}}{{$hasTopLevelOneOf = true}}{{end}}
	{{- end}}

	{{- if $hasTopLevelOneOf}}
	// Top-level oneOf: marshal the selected variant directly as the root object.
	{{- range $oof := $struct.OneOfs}}
	{{- if not $oof.JSONName}}
	if {{$recv}}.{{$oof.FieldName}} != nil {
		switch v := {{$recv}}.{{$oof.FieldName}}.(type) {
		{{- range $oof.Variants}}
		case *{{.WrapperName}}:
			return json.Marshal(v.{{.FieldName}})
		{{- end}}
		}
	}
	{{- end}}
	{{- end}}
	return []byte("null"), nil
	{{- else}}
	type Alias {{$struct.Name}}
	aux := struct {
		Alias
		{{- range $struct.OneOfs}}
		{{.FieldName}} json.RawMessage `json:"{{.JSONName}},omitempty"`
		{{- end}}
	}{
		Alias: (Alias)({{$recv}}),
	}
	{{- range $oof := $struct.OneOfs}}

	if {{$recv}}.{{$oof.FieldName}} != nil {
		switch v := {{$recv}}.{{$oof.FieldName}}.(type) {
		{{- range $oof.Variants}}
		case *{{.WrapperName}}:
			raw, err := json.Marshal(v.{{.FieldName}})
			if err != nil {
				return nil, fmt.Errorf("marshaling {{$struct.Name}}.{{$oof.FieldName}}: %w", err)
			}
			aux.{{$oof.FieldName}} = raw
		{{- end}}
		}
	}
	{{- end}}

	{{- if or (hasManualFields $struct.Fields) $struct.AdditionalProperties $struct.HasPatternProperties $struct.NeedsJSONNulls $struct.WriteOnlyKeys}}
	data, err := json.Marshal(aux)
	if err != nil {
		return nil, err
	}
	var obj map[string]json.RawMessage
	if err := json.Unmarshal(data, &obj); err != nil {
		return nil, err
	}
	{{- range $struct.Fields}}
	{{- if .ManualJSON}}
	{{- if eq .ManualOmit "nil"}}
	// The property name cannot go in a struct tag, so omitempty never reaches
	// this field: an absent optional value has to be skipped by hand, or the
	// null a nil pointer/slice/map marshals to would be written as if the
	// property were present with a null value. A present-but-empty collection
	// is non-nil and still written.
	if {{$recv}}.{{.Name}} != nil {
		raw, err := json.Marshal({{$recv}}.{{.Name}})
		if err != nil {
			return nil, fmt.Errorf("marshaling {{$struct.Name}}.{{.Name}}: %w", err)
		}
		obj[{{printf "%q" .JSONName}}] = raw
	}
	{{- else if eq .ManualOmit "iszero"}}
	// The property name cannot go in a struct tag, so omitzero never reaches
	// this field: the wrapper's MarshalJSON writes null when no value was
	// present, so an absent optional value has to be skipped by hand.
	if !{{$recv}}.{{.Name}}.IsZero() {
		raw, err := json.Marshal({{$recv}}.{{.Name}})
		if err != nil {
			return nil, fmt.Errorf("marshaling {{$struct.Name}}.{{.Name}}: %w", err)
		}
		obj[{{printf "%q" .JSONName}}] = raw
	}
	{{- else}}
	{
		raw, err := json.Marshal({{$recv}}.{{.Name}})
		if err != nil {
			return nil, fmt.Errorf("marshaling {{$struct.Name}}.{{.Name}}: %w", err)
		}
		obj[{{printf "%q" .JSONName}}] = raw
	}
	{{- end}}
	{{- end}}
	{{- end}}
	{{- if $struct.HasPatternProperties}}
	for k, v := range {{$recv}}.PatternProperties {
		obj[k] = v
	}
	{{- end}}
	{{- if $struct.NeedsJSONNulls}}
	// The properties the source document wrote as null. Nothing left in the
	// decoded value says they were there -- a null leaves the nil pointer or the
	// untouched zero an absent property leaves -- so writing them back has to
	// come from the record UnmarshalJSON kept. See issue #110.
	//
	// Only where the field still holds what the null left it holding. A caller
	// who decoded a null and then assigned a value has said something newer than
	// the document did, and writing the null over it would discard the
	// assignment; the record is about a value nobody has touched. What the
	// untouched state looks like is read off a zero of this very struct rather
	// than from a per-field literal, so a field type's own MarshalJSON decides
	// for itself and nothing here has to know how it spells "empty".
	if len({{$recv}}._jsonNulls) > 0 {
		var _zero Alias
		if _zeroData, _zeroErr := json.Marshal(_zero); _zeroErr == nil {
			var _zeroObj map[string]json.RawMessage
			if json.Unmarshal(_zeroData, &_zeroObj) == nil {
				for _k := range {{$recv}}._jsonNulls {
					if _cur, _present := obj[_k]; !_present || string(_cur) == string(_zeroObj[_k]) {
						obj[_k] = json.RawMessage("null")
					}
				}
			}
		}
	}
	{{- end}}
	{{- if $struct.AdditionalProperties}}
	for k, v := range {{$recv}}.AdditionalProperties {
		{{- if isRawMessage $struct.AdditionalProperties.ValueType}}
		obj[k] = v
		{{- else}}
		raw, err := json.Marshal(v)
		if err != nil {
			return nil, fmt.Errorf("marshaling additional property %q: %w", k, err)
		}
		obj[k] = raw
		{{- end}}
	}
	{{- end}}
	{{- if $struct.WriteOnlyKeys}}
	// --strict-read-write. The schema marks these "writeOnly", which JSON Schema
	// section 9.4 says is "never present when the instance is retrieved from the
	// owning authority" -- so this type, which that flag makes the authority's
	// view, does not write them.
	//
	// Deleted after every other contributor above has had its say, including the
	// overflow map and the null record: a writeOnly property put back by one of
	// those would be just as present as one the struct tag wrote.
	for _, _woKey := range []string{
		{{- range $struct.WriteOnlyKeys}}
		{{printf "%q" .}},
		{{- end}}
	} {
		delete(obj, _woKey)
	}
	{{- end}}
	return json.Marshal(obj)
	{{- else}}
	return json.Marshal(aux)
	{{- end}}
	{{- end}}
}
{{- end}}
