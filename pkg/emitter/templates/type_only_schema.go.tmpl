{{define "type_only_schema"}}
{{- $recv := receiverName .Name -}}
{{- template "type_doc" .}}
// {{.Name}} accepts any JSON value and validates that it is one of the allowed types.
{{- template "annotation_comment" mkAnnotationCtx .Annotations "" true}}
type {{.Name}} struct {
	{{- if .KeepsDoc}}
	_doc *rt.Doc // the document _raw is a view of, which Validate decodes the alternatives through
	{{- end}}
	_raw json.RawMessage
}

{{template "raw_holder_methods" .}}

// IsZero reports whether no value was present, so an optional field tagged
// ",omitzero" is omitted when absent rather than marshalled as null.
func ({{$recv}} {{.Name}}) IsZero() bool { return len({{$recv}}._raw) == 0 }

func ({{$recv}} {{.Name}}) String() string { return string({{$recv}}._raw) }

{{- if .VisitTarget}}
// Validate checks {{.Name}} against its JSON Schema type constraint.
func ({{$recv}} {{.Name}}) Validate() error { return {{$recv}}.validateVisiting(nil) }

// validateVisiting is Validate, told which type wrappers are already judging
// this same value. A branch that would re-enter one of them never gets further
// into the value, and contributes nothing; see the generator's
// resolveTypeBranchesInPlace.
func ({{$recv}} {{.Name}}) validateVisiting(_visiting []string) error {
	_visiting = append(_visiting, {{printf "%q" .Name}})
{{- else}}
// Validate checks {{.Name}} against its JSON Schema type constraint.
func ({{$recv}} {{.Name}}) Validate() error {
	{{- if .HasInPlaceBranch}}
	_visiting := []string{ {{- printf "%q" .Name -}} }
	{{- end}}
{{- end}}
	// No value was present. A constraint applies to a value that is there; an
	// absent optional property is the parent's business (required), not this
	// type's.
	if len({{$recv}}._raw) == 0 {
		return nil
	}
	{{- /* Every number is kept as the literal the document wrote, on either
	       path: "integer" is read off it the way the draft reads it, and 1e400
	       is a number rather than a decode error. See rt.Held and
	       rt.DecodeNumbers. */}}
	{{- if .KeepsDoc}}
	{{- /* Only the value's first level is read here: the checks below ask its JSON
	       type and the types of its members, and an alternative that is a type
	       of its own decodes the value itself. Decoded whole, a value nested d
	       levels deep in wrappers like this one was decoded once per level. */}}
	_v, _err := rt.Held({{$recv}}._doc, {{$recv}}._raw)
	if _err != nil {
		return fmt.Errorf("type: cannot decode value: %w", _err)
	}
	_v = rt.Top(_v)
	{{- else}}
	var _v any
	if _err := rt.DecodeNumbers({{$recv}}._raw, &_v); _err != nil {
		return fmt.Errorf("type: cannot decode value: %w", _err)
	}
	{{- end}}
	_typeBranchValid := false
	{{- range $bi, $branch := .TypeBranches}}
	{
		_branchMatches := true
		{{- if $branch.InPlaceType}}
		{
			// The alternative is another type wrapper, which judges this same
			// value; one already judging it answers nothing new here.
			_reentered := false
			{{- /* maporder: not a map: ranges a slice. */}}
			for _, _name := range _visiting {
				if _name == {{printf "%q" $branch.InPlaceType}} {
					_reentered = true
				}
			}
			var _bv {{$branch.TypeName}}
			if _reentered {
				_branchMatches = false
			} else if _err := {{if $branch.Decoder}}rt.DecodeHeld({{$recv}}._doc, {{$recv}}._raw, &_bv, {{$branch.Decoder}}){{else}}json.Unmarshal({{$recv}}._raw, &_bv){{end}}; _err != nil {
				if rt.Undecided(_err) {
					return fmt.Errorf("type: %w", _err)
				}
				_branchMatches = false
			} else if _err := {{$branch.InPlaceType}}(_bv).validateVisiting(_visiting); _err != nil {
				if rt.Undecided(_err) {
					return fmt.Errorf("type: %w", _err)
				}
				_branchMatches = false
			}
		}
		{{- else if $branch.TypeName}}
		{
			// The alternative is a reference; the value matches it when it
			// decodes into the referenced type and that type accepts it.
			// A pattern match with no answer on the way is no verdict on the
			// branch, so it is returned rather than read as "no match".
			var _bv {{$branch.TypeName}}
			if _err := {{if $branch.Decoder}}rt.DecodeHeld({{$recv}}._doc, {{$recv}}._raw, &_bv, {{$branch.Decoder}}){{else}}json.Unmarshal({{$recv}}._raw, &_bv){{end}}; _err != nil {
				if rt.Undecided(_err) {
					return fmt.Errorf("type: %w", _err)
				}
				_branchMatches = false
			} else if _bvv, _ok := any(&_bv).(interface{ Validate() error }); _ok {
				if _err := _bvv.Validate(); _err != nil {
					if rt.Undecided(_err) {
						return fmt.Errorf("type: %w", _err)
					}
					_branchMatches = false
				}
			}
		}
		{{- end}}
		{{- if $branch.AllowedTypes}}
		{
			// A schema-valued type branch lists one or more allowed JSON types;
			// the value matches when it is any one of them.
			_typeOk := false
			{{- range $branch.AllowedTypes}}
			{{- if eq . "object"}}
			if _, _ok := _v.(map[string]any); _ok { _typeOk = true }
			{{- else if eq . "integer"}}
			if rt.IsInteger(_v, {{if $.StrictInteger}}true{{else}}false{{end}}) { _typeOk = true }
			{{- else if eq . "number"}}
			if rt.IsNumber(_v) { _typeOk = true }
			{{- else if eq . "string"}}
			if _, _ok := _v.(string); _ok { _typeOk = true }
			{{- else if eq . "boolean"}}
			if _, _ok := _v.(bool); _ok { _typeOk = true }
			{{- else if eq . "null"}}
			if _v == nil { _typeOk = true }
			{{- else if eq . "array"}}
			if _, _ok := _v.([]any); _ok { _typeOk = true }
			{{- end}}
			{{- end}}
			if !_typeOk { _branchMatches = false }
		}
		{{- end}}
		{{- if $branch.Properties}}
		_obj, _objOk := _v.(map[string]any)
		if !_objOk {
			_branchMatches = false
		}
		{{- range $branch.Properties}}
		if _branchMatches {
			_propVal, _propOk := _obj[{{printf "%q" .Name}}]
			{{- if $.KeepsDoc}}
			_propVal = rt.Top(_propVal)
			{{- end}}
			if !_propOk {
				{{- if .Required}}
				_branchMatches = false
				{{- end}}
			} else {
				{{- if eq .JSONType "integer"}}
				if !rt.IsInteger(_propVal, {{if $.StrictInteger}}true{{else}}false{{end}}) { _branchMatches = false }
				{{- else if eq .JSONType "number"}}
				if !rt.IsNumber(_propVal) { _branchMatches = false }
				{{- else if eq .JSONType "string"}}
				if _, _sOk := _propVal.(string); !_sOk { _branchMatches = false }
				{{- else if eq .JSONType "boolean"}}
				if _, _bOk := _propVal.(bool); !_bOk { _branchMatches = false }
				{{- else if eq .JSONType "null"}}
				if _propVal != nil { _branchMatches = false }
				{{- else if eq .JSONType "array"}}
				if _, _aOk := _propVal.([]any); !_aOk { _branchMatches = false }
				{{- else if eq .JSONType "object"}}
				if _, _oOk := _propVal.(map[string]any); !_oOk { _branchMatches = false }
				{{- end}}
			}
		}
		{{- end}}
		{{- end}}
		if _branchMatches {
			_typeBranchValid = true
		}
	}
	{{- end}}
	if _typeBranchValid {
		return nil
	}
	{{- $nullOk := false}}{{$numOk := false}}{{$intOk := false}}{{$strOk := false}}{{$boolOk := false}}{{$arrOk := false}}{{$objOk := false}}
	{{- range .AllowedTypes -}}
		{{- if eq . "null"}}{{$nullOk = true}}
		{{- else if eq . "number"}}{{$numOk = true}}
		{{- else if eq . "integer"}}{{$intOk = true}}
		{{- else if eq . "string"}}{{$strOk = true}}
		{{- else if eq . "boolean"}}{{$boolOk = true}}
		{{- else if eq . "array"}}{{$arrOk = true}}
		{{- else if eq . "object"}}{{$objOk = true}}
		{{- end}}
	{{- end}}
	if _v == nil {
		{{- if $nullOk}}
		return nil
		{{- else}}
		return fmt.Errorf("type: null is not allowed")
		{{- end}}
	}
	switch _tv := _v.(type) {
	case json.Number:
		{{- if $numOk}}
		_ = _tv
		return nil
		{{- else if $intOk}}
		if !rt.IsInteger(_tv, {{if .StrictInteger}}true{{else}}false{{end}}) {
			return fmt.Errorf("type: expected integer, got number")
		}
		return nil
		{{- else}}
		_ = _tv
		return fmt.Errorf("type: number is not allowed")
		{{- end}}
	case string:
		{{- if $strOk}}
		_ = _tv
		return nil
		{{- else}}
		_ = _tv
		return fmt.Errorf("type: string is not allowed")
		{{- end}}
	case bool:
		{{- if $boolOk}}
		_ = _tv
		return nil
		{{- else}}
		_ = _tv
		return fmt.Errorf("type: boolean is not allowed")
		{{- end}}
	case []any:
		{{- if $arrOk}}
		_ = _tv
		return nil
		{{- else}}
		_ = _tv
		return fmt.Errorf("type: array is not allowed")
		{{- end}}
	case map[string]any:
		{{- if $objOk}}
		_ = _tv
		return nil
		{{- else}}
		_ = _tv
		return fmt.Errorf("type: object is not allowed")
		{{- end}}
	default:
		return fmt.Errorf("type: unexpected value type %T", _v)
	}
}
{{- end}}
