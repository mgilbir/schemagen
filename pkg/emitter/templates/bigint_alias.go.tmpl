{{define "bigint_alias"}}
{{- $recv := receiverName .Name -}}
{{- template "type_doc" .}}
// {{.Name}} holds an integer value with arbitrary-precision support (int64 + *big.Int).
{{- if .AllowsNull}}
// The schema also admits null, so the wrapper carries an explicit null state:
// neither the int64 nor the *big.Int can stand in for it, since the int64 zero
// is what a literal 0 decodes to and a nil *big.Int is what every int64-sized
// value leaves behind. IsNull reports it, and the zero value is 0, not null.
{{- end}}
{{- template "annotation_comment" mkAnnotationCtx .Annotations "" true}}
{{- /* The *big.Int leads because it is the only member carrying a pointer, so
       the garbage collector's scan of the wrapper stops at the first word; the
       flags follow the int64 so they pack into the tail rather than pushing it
       out with padding. Nothing about that depends on the schema, which is why
       this order is written here rather than chosen by the layout pass -- but
       layoutTable.ofDef states the same four members, and has to agree. */}}
type {{.Name}} struct {
	_bigInt   *big.Int
	_int64    int64
	_isBigInt bool
	{{- if .AllowsNull}}
	_isNull   bool
	{{- end}}
}

{{template "bigint_alias_unmarshal" .}}
{{template "bigint_alias_marshal" .}}
{{template "bigint_alias_accessors" .}}
{{template "bigint_alias_validate" .}}
{{- end}}

{{define "bigint_alias_unmarshal"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	{{- /* Replaced rather than merged into, as every generated type is: a
	       refused document leaves the zero value, not the previous one's. */}}
	*{{$recv}} = {{.Name}}{}
	{{- if .NeedsNullCheck}}
	if string(data) == "null" {
		return rt.ValueErrorf("null is not allowed")
	}
	{{- end}}
	{{- if .AllowsNull}}
	// The schema admits null. Take it before json.Number does: a null decodes
	// into a json.Number as the empty string, which then fails every numeric
	// parse below -- which is how a permitted null came to be reported as
	// "not a valid integer".
	if string(data) == "null" {
		{{$recv}}._isNull = true
		{{$recv}}._int64 = 0
		{{$recv}}._isBigInt = false
		{{$recv}}._bigInt = nil
		return nil
	}
	{{$recv}}._isNull = false
	{{- end}}
	// Reject JSON strings (e.g., "1").
	if len(data) > 0 && data[0] == '"' {
		return rt.ValueErrorf("expected integer, got string")
	}
	var _n json.Number
	if _err := json.Unmarshal(data, &_n); _err != nil {
		return rt.DecodeRefusal(_err)
	}
	// Try int64 first.
	if _i, _iErr := _n.Int64(); _iErr == nil {
		{{$recv}}._int64 = _i
		{{$recv}}._isBigInt = false
		{{$recv}}._bigInt = nil
		return nil
	}
	// Try float with zero fractional part only for float-notation numbers (e.g., 1.0, 1e2).
	_s := _n.String()
	{{- if .StrictInteger}}
	// Except in this draft, which defines an integer as a number written with
	// no fraction and no exponent: 1.0 and 1e2 are not integers here, so the
	// float-notation arms are refused before they are reached. What remains is
	// the int64 parse above and the big.Int parse of a plain digit string,
	// which is exactly the set of spellings the draft admits.
	if strings.ContainsAny(_s, ".eE") {
		return fmt.Errorf("value %s is not a valid integer", _s)
	}
	{{- end}}
	// Everything else is read exactly, from the literal's digits: an int64
	// where one holds it (1.0, 1e2), a big.Int where none does. The big.Float of
	// 64 bits this replaces was not arbitrary precision -- it read
	// 12345678901234567891.5 as the integer 12345678901234567892, and 1e100 as
	// a different integer from 10^100. See rt.BigIntFromLiteral.
	if _i64, _iOK := rt.IntegerFromLiteral(_s); _iOK {
		{{$recv}}._int64 = _i64
		{{$recv}}._isBigInt = false
		{{$recv}}._bigInt = nil
		return nil
	}
	_bi, _isInt, _tooLarge := rt.BigIntFromLiteral(_s)
	if _tooLarge {
		return fmt.Errorf("value %s is an integer with more digits than this type builds from an exponent", rt.ClipText(_s))
	}
	if !_isInt {
		return fmt.Errorf("value %s is not an integer", rt.ClipText(_s))
	}
	{{$recv}}._bigInt = _bi
	{{$recv}}._isBigInt = true
	{{$recv}}._int64 = 0
	return nil
}
{{template "generated_marker" .}}
{{- end}}

{{define "bigint_alias_marshal"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} {{.Name}}) MarshalJSON() ([]byte, error) {
	{{- if .AllowsNull}}
	if {{$recv}}._isNull {
		return []byte("null"), nil
	}
	{{- end}}
	if {{$recv}}._isBigInt && {{$recv}}._bigInt != nil {
		return []byte({{$recv}}._bigInt.String()), nil
	}
	return json.Marshal({{$recv}}._int64)
}
{{- if .HasIdentity}}

// SchemagenJSONIdentity is {{$recv}}'s identity as JSON: the number, or the
// null, MarshalJSON writes. See rt.ID.
func ({{$recv}} *{{.Name}}) SchemagenJSONIdentity(_m *rt.Validation) (rt.ID, error) {
	{{- if .AllowsNull}}
	if {{$recv}}._isNull {
		return rt.IDNull(_m)
	}
	{{- end}}
	if {{$recv}}._isBigInt && {{$recv}}._bigInt != nil {
		return rt.IDNumberIn(json.Number({{$recv}}._bigInt.String()), _m)
	}
	return rt.IdentifyAt(&{{$recv}}._int64, _m)
}
{{- end}}
{{- end}}

{{define "bigint_alias_accessors"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} {{.Name}}) Int64() int64 { return {{$recv}}._int64 }
// BigInt returns the value as a *big.Int of the caller's own. The value's own
// is not handed out: a copy of the value shares it, and a caller writing
// through it would change both.
func ({{$recv}} {{.Name}}) BigInt() *big.Int {
	if {{$recv}}._isBigInt && {{$recv}}._bigInt != nil {
		return new(big.Int).Set({{$recv}}._bigInt)
	}
	return big.NewInt({{$recv}}._int64)
}
func ({{$recv}} {{.Name}}) IsBigInt() bool { return {{$recv}}._isBigInt }
{{- if .AllowsNull}}

// IsNull reports whether the value decoded from a JSON null. The accessors
// above answer 0 in that case, which is also what a literal 0 answers, so this
// is the only way to tell the two apart.
func ({{$recv}} {{.Name}}) IsNull() bool { return {{$recv}}._isNull }
{{- end}}
func ({{$recv}} {{.Name}}) String() string { return {{$recv}}.BigInt().String() }
{{- end}}

{{define "bigint_alias_validate"}}
{{- $recv := receiverName .Name -}}

// Validate checks {{.Name}} against its JSON Schema constraints.
func ({{$recv}} {{.Name}}) Validate() error {
	{{- if .AllowsNull}}
	// The numeric keywords say nothing about a null: under JSON Schema a
	// keyword that applies to numbers is satisfied vacuously by every other
	// instance type. Checking them against the zero the accessors answer for a
	// null would reject a value the schema permits.
	if {{$recv}}._isNull {
		return nil
	}
	{{- end}}
	{{- if or .Validations .AnyOfVariants .OneOfVariants}}
	// The value as the decimal it is, which the numeric keywords are decided on
	// through the exact core. The 256-bit big.Float this replaces admitted
	// 10^99+1 under a maximum of 10^99 and called 10^99 a multiple of 7.
	_num := json.Number({{$recv}}.String())
	_ = _num
	{{- end}}
	{{- range .Validations}}
	{{- if eq .RuleType "minimum"}}
	if {{numViolated . "_num"}} {
		return rt.ValueErrorf("%s is less than minimum {{fmtText .Value}}", _num)
	}
	{{- end}}
	{{- if eq .RuleType "maximum"}}
	if {{numViolated . "_num"}} {
		return rt.ValueErrorf("%s exceeds maximum {{fmtText .Value}}", _num)
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMinimum"}}
	if {{numViolated . "_num"}} {
		return rt.ValueErrorf("%s must be greater than {{fmtText .Value}}", _num)
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMaximum"}}
	if {{numViolated . "_num"}} {
		return rt.ValueErrorf("%s must be less than {{fmtText .Value}}", _num)
	}
	{{- end}}
	{{- if eq .RuleType "multipleOf"}}
	if {{numViolated . "_num"}} {
		return rt.ValueErrorf("%s is not a multiple of {{fmtText .Value}}", _num)
	}
	{{- end}}
	{{- end}}
	{{- if .AnyOfVariants}}
	// anyOf: at least one variant must be satisfied.
	{
		anyOfValid := false
		{{- range $vi, $variant := .AnyOfVariants}}
		if !anyOfValid {
			variantValid := true
			{{- template "bigint_alias_variant_checks" (mkBigIntVariantCtx $recv $variant)}}
			if variantValid { anyOfValid = true }
		}
		{{- end}}
		if !anyOfValid {
			return rt.ValueErrorf("value does not match any anyOf variant")
		}
	}
	{{- end}}
	{{- if .OneOfVariants}}
	// oneOf: exactly one variant must be satisfied.
	{
		oneOfCount := 0
		{{- range $vi, $variant := .OneOfVariants}}
		{
			variantValid := true
			{{- template "bigint_alias_variant_checks" (mkBigIntVariantCtx $recv $variant)}}
			if variantValid { oneOfCount++ }
		}
		{{- end}}
		if oneOfCount != 1 {
			return rt.ValueErrorf("value matches %d oneOf variants, expected exactly 1", oneOfCount)
		}
	}
	{{- end}}
	return nil
}
{{- end}}

{{/*
bigint_alias_variant_checks emits one anyOf / oneOf branch's constraints against
the arbitrary-precision value.

Only the numeric keywords are emitted. A branch keyword that speaks about
strings or arrays does not constrain an integer at all -- under JSON Schema it
is satisfied vacuously -- so leaving variantValid alone is what the branch
actually asserts, not a check being dropped. The generator drops those keywords
before they reach here (ruleVacuousForType); the emission side stays selective
so a rule arriving from elsewhere cannot be read as a numeric bound.

"never" is the one branch that asserts nothing and matches nothing: its own
"type" excludes every integer, so it is counted as unmatched rather than
dropped, because a oneOf whose branches are all impossible is satisfied by no
value at all.
*/}}
{{define "bigint_alias_variant_checks"}}
{{- $recv := .Recv -}}
{{- range .Rules}}
{{- if eq .RuleType "never"}}
// The branch's own "type" excludes every value this type can hold, so the
// branch matches nothing.
variantValid = false
{{- end}}
{{- if or (eq .RuleType "minimum") (eq .RuleType "maximum") (eq .RuleType "exclusiveMinimum") (eq .RuleType "exclusiveMaximum") (eq .RuleType "multipleOf")}}
if {{numViolated . "_num"}} { variantValid = false }
{{- end}}
{{- end}}
{{- end}}
