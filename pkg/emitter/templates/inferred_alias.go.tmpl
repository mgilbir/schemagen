{{define "inferred_alias"}}
{{- $recv := receiverName .Name -}}
{{- template "type_doc" .}}
// {{.Name}} accepts any JSON value. Constraints apply only when the value is {{.InferredJSONType}}.
{{- template "annotation_comment" mkAnnotationCtx .Annotations "" true}}
{{- /* Declared in the order the layout pass chose. It is not fixed because
       _value's type is not: the schema infers it, and a float64 belongs after
       _raw where a string belongs before it. See generator/members.go. */}}
type {{.Name}} struct {
{{- range .Members}}
	{{.Name}} {{goType .Type}}
{{- end}}
}

{{template "inferred_alias_unmarshal" .}}
{{template "inferred_alias_marshal" .}}
{{template "inferred_alias_accessors" .}}
{{template "inferred_alias_validate" .}}
{{- end}}

{{define "inferred_alias_unmarshal"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	{{- /* Replaced rather than merged into: the typed arm below leaves _raw as it
	       was, and a value decoded from a string after a number kept the number's
	       bytes beside its string. And _raw is a buffer of its own every time:
	       appended over the one it had, a copy of the value made earlier shared
	       that array and was rewritten by this decode. */}}
	*{{$recv}} = {{.Name}}{}
	{{- if .NeedsNullCheck}}
	if string(data) == "null" {
		return jsonValueErrorf("null is not allowed")
	}
	{{- else}}
	// Null is a non-matching type for inferred schemas — store as raw.
	if string(data) == "null" {
		{{$recv}}._raw = append(json.RawMessage(nil), data...)
		{{$recv}}._isRaw = true
		return nil
	}
	{{- end}}
	// Try typed unmarshal first.
	{{- if .IsExactNumber}}
	{{- /* Through the shadow, so that a JSON string holding digits is not
	       taken for the number this wrapper's constraints judge: json.Number
	       accepts "1.5" as readily as 1.5, and a string is a non-matching type
	       whose keywords do not apply. */}}
	if _err := json.Unmarshal(data, (*jsonNumber)(&{{$recv}}._value)); _err == nil {
	{{- else}}
	if _err := json.Unmarshal(data, &{{$recv}}._value); _err == nil {
	{{- end}}
		{{$recv}}._isRaw = false
		{{- if .JudgesLiteral}}
		{{- /* The document's bytes are kept beside the decoded value, and are
		       what Validate judges: the value is a float64, or holds float64s,
		       and the numeric keywords are about the digits a float64 rounds
		       away. Nothing reads them but Validate -- the marshaller and the
		       accessors go by _isRaw -- and a value assembled in Go, which has
		       none, is judged from _value as before. */}}
		{{$recv}}._raw = append({{$recv}}._raw[:0], data...)
		{{- end}}
		return nil
	}
	// Non-matching type — store raw bytes, accept silently per JSON Schema. A
	// value that is not JSON at all is not a value of some other type, and is
	// refused in encoding/json's words; encoding/json never hands one over, so
	// only a direct caller reaches that.
	if !json.Valid(data) {
		var _v json.RawMessage
		return jsonDecodeRefusal(json.Unmarshal(data, &_v))
	}
	{{$recv}}._raw = append(json.RawMessage(nil), data...)
	{{$recv}}._isRaw = true
	return nil
}
{{- end}}

{{define "inferred_alias_marshal"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} {{.Name}}) MarshalJSON() ([]byte, error) {
	if {{$recv}}._isRaw {
		if len({{$recv}}._raw) == 0 {
			return []byte("null"), nil
		}
		// A copy: the value's own bytes, handed out, are bytes a caller can
		// rewrite the value through.
		return append([]byte(nil), {{$recv}}._raw...), nil
	}
	return json.Marshal({{$recv}}._value)
}
{{- if .HasIdentity}}

// jsonIdentity is {{$recv}}'s identity as JSON: that of what MarshalJSON writes.
// See jsonID.
func ({{$recv}} *{{.Name}}) jsonIdentity(_m *jsonValidation) (jsonID, error) {
	if {{$recv}}._isRaw {
		if len({{$recv}}._raw) == 0 {
			return jsonIDNull(_m)
		}
		return jsonIDRawIn({{$recv}}._raw, _m)
	}
	return jsonIdentifyAt(&{{$recv}}._value, _m)
}
{{- end}}
{{- end}}

{{define "inferred_alias_accessors"}}
{{- $recv := receiverName .Name -}}

func ({{$recv}} {{.Name}}) {{.AccessorName}}() {{goType .InferredGoType}} { return {{$recv}}._value }
func ({{$recv}} {{.Name}}) {{.TypeCheckName}}() bool { return !{{$recv}}._isRaw }
func ({{$recv}} {{.Name}}) Raw() json.RawMessage {
	if {{$recv}}._isRaw {
		return append(json.RawMessage(nil), {{$recv}}._raw...)
	}
	_b, _ := json.Marshal({{$recv}}._value)
	return _b
}
func ({{$recv}} {{.Name}}) String() string {
	if {{$recv}}._isRaw {
		return string({{$recv}}._raw)
	}
	return fmt.Sprintf("%v", {{$recv}}._value)
}
{{- end}}

{{define "inferred_alias_validate"}}
{{- $recv := receiverName .Name -}}

// Validate checks {{.Name}} against its JSON Schema constraints.
func ({{$recv}} {{.Name}}) Validate() error {
	{{- if .JudgesNumber}}
	if {{$recv}}._isRaw {
		// Constraints don't apply to non-matching types -- but a number is not
		// one. 1e400 is a number no float64 holds, so the typed decode refused
		// it and it was kept here as bytes; every numeric keyword still applies
		// to it, and is read from those bytes below. It used to be passed over
		// as though it were a string.
		if _, _isNum := jsonRawNumber({{$recv}}._raw); !_isNum {
			return nil
		}
	}
	{{- else}}
	if {{$recv}}._isRaw {
		return nil // Constraints don't apply to non-matching types.
	}
	{{- end}}
	{{- if .JudgesNumber}}
	// The number as the document wrote it, where the value was decoded from
	// one; see UnmarshalJSON. A value assembled in Go is judged as the number
	// it marshals to.
	_num, _numText := any({{$recv}}._value), fmt.Sprint({{$recv}}._value)
	if len({{$recv}}._raw) > 0 {
		_num, _numText = json.RawMessage({{$recv}}._raw), string({{$recv}}._raw)
	}
	_, _ = _num, _numText
	{{- end}}
	{{- if .ItemsAreAny}}
	// The elements as the document wrote them, where the value was decoded
	// from one: decoded into []any they are float64s, which round the digits
	// the element keywords are about. Read again here keeping every number as
	// its literal; a value assembled in Go is judged as it stands.
	_items := {{$recv}}._value
	if len({{$recv}}._raw) > 0 {
		var _decoded any
		if jsonDecodeNumbers({{$recv}}._raw, &_decoded) == nil {
			if _arr, _ok := _decoded.([]any); _ok {
				_items = _arr
			}
		}
	}
	_ = _items
	{{- end}}
	{{- if .ValidateAs}}
	// Returned as it stands: the type this delegates to answers for the very same
	// value, so there is no step of path between the two and nothing to put in
	// front of its message. Wrapping it also lost what the message had recorded
	// about how a container must join it. See issue #279.
	{{- if .JudgesNumber}}
	// Not for a number kept as bytes: _value never held it.
	if !{{$recv}}._isRaw {
		if _err := ({{.ValidateAs}}({{$recv}}._value)).Validate(); _err != nil {
			return _err
		}
	}
	{{- else}}
	if _err := ({{.ValidateAs}}({{$recv}}._value)).Validate(); _err != nil {
		return _err
	}
	{{- end}}
	{{- end}}
	{{- range .Validations}}
	{{- if eq .RuleType "minLength"}}
	if utf8.RuneCountInString(string({{$recv}}._value)) < {{countExpr .Value}} {
		return jsonValueErrorf("length %d is less than minimum {{fmtText .Value}}", utf8.RuneCountInString(string({{$recv}}._value)))
	}
	{{- end}}
	{{- if eq .RuleType "maxLength"}}
	if utf8.RuneCountInString(string({{$recv}}._value)) > {{countExpr .Value}} {
		return jsonValueErrorf("length %d exceeds maximum {{fmtText .Value}}", utf8.RuneCountInString(string({{$recv}}._value)))
	}
	{{- end}}
	{{- /* The numeric keywords judge _num, the literal the document wrote.
	       Every numeric rule here reads its instance through the exact core;
	       see clearNumberOperands. */}}
	{{- if eq .RuleType "minimum"}}
	if {{numViolated . "_num"}} {
		return jsonValueErrorf("%s is less than minimum {{fmtText .Value}}", _numText)
	}
	{{- end}}
	{{- if eq .RuleType "maximum"}}
	if {{numViolated . "_num"}} {
		return jsonValueErrorf("%s exceeds maximum {{fmtText .Value}}", _numText)
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMinimum"}}
	if {{numViolated . "_num"}} {
		return jsonValueErrorf("%s must be greater than {{fmtText .Value}}", _numText)
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMaximum"}}
	if {{numViolated . "_num"}} {
		return jsonValueErrorf("%s must be less than {{fmtText .Value}}", _numText)
	}
	{{- end}}
	{{- if eq .RuleType "multipleOf"}}
	if {{numViolated . "_num"}} {
		return jsonValueErrorf("%s is not a multiple of {{fmtText .Value}}", _numText)
	}
	{{- end}}
	{{- if eq .RuleType "pattern"}}
	if _matched, _mErr := {{patternVar .Value}}.matches(string({{$recv}}._value)); _mErr != nil {
		return jsonValueErrorf("%w", _mErr)
	} else if !_matched {
		return jsonValueErrorf("%s does not match pattern %s", _schemagenQuote(string({{$recv}}._value)), {{printf "%q" .Value}})
	}
	{{- end}}
	{{- if eq .RuleType "format"}}
	{{- /*
	This wrapper is the shape a "format" with no declared "type" resolves to
	(issue #106). The guard at the top of Validate is what makes the check
	narrow: a number, an object or a null decoded into _raw and returned there,
	so this line is only ever reached for a value that arrived as a JSON string,
	which is the only kind of instance `format` says anything about.

	The rule only reaches a wrapper whose _value is a Go string --
	formatRuleShape decides that -- so every arm reads _value directly.
	*/}}
	{{- template "string_format_check" (mkStringFormatCtx (printf "string(%s._value)" $recv) "" .Value true)}}
	{{- end}}
	{{- if eq .RuleType "content"}}
	{{- /*
	The content vocabulary with no declared "type" resolves to this same wrapper
	(issue #115), and the guard at the top of Validate is what keeps it narrow in
	the same way: contentEncoding and contentMediaType say nothing about a
	number, an object or a null, all of which decoded into _raw and returned
	there, so this line is only reached for a JSON string.
	*/}}
	{{- template "string_content_check" (mkStringContentCtx (printf "string(%s._value)" $recv) "" .)}}
	{{- end}}
	{{- if eq .RuleType "minItems"}}
	if len({{$recv}}._value) < {{countExpr .Value}} {
		return jsonValueErrorf("has %d items, minimum is {{fmtText .Value}}", len({{$recv}}._value))
	}
	{{- end}}
	{{- if eq .RuleType "maxItems"}}
	if len({{$recv}}._value) > {{countExpr .Value}} {
		return jsonValueErrorf("has %d items, maximum is {{fmtText .Value}}", len({{$recv}}._value))
	}
	{{- end}}
	{{- if eq .RuleType "uniqueItems"}}
	{
		{{- /* Compared by identity; see the struct form in validation.go.tmpl.
		       Over the elements as the document wrote them where there are any
		       (_items keeps every number's literal), so 9007199254740992 and
		       9007199254740993 are two elements even where the wrapper holds
		       one float64 for both. The wrapper's own value is reached by no
		       check above it, so there is nothing kept to read back. */}}
		_uqArr := {{if $.ItemsAreAny}}_items{{else}}{{$recv}}._value{{end}}
		_ids, _i, _err := jsonIDsOf(_uqArr, nil, jsonIdentifyAt[any])
		if _err != nil {
			return jsonValueErrorf("uniqueItems check: marshal error at index %d: %w", _i, jsonMarshalError(&_uqArr[_i], _err))
		}
		if _i := jsonFirstDuplicate(_uqArr, _ids, jsonIdentifyAt[any]); _i >= 0 {
			return jsonValueErrorf("items are not unique (duplicate at index %d)", _i)
		}
	}
	{{- end}}
	{{- end}}
	{{- if .AnyOfVariants}}
	// anyOf: at least one variant must be satisfied.
	{
		_anyOfValid := false
		{{- range $vi, $variant := .AnyOfVariants}}
		if !_anyOfValid {
			_variantValid := true
			{{- range $variant}}
			{{- if eq .RuleType "never"}}
			// The branch's own "type" excludes every value this type can hold,
			// so the branch matches nothing.
			_variantValid = false
			{{- end}}
			{{- if eq .RuleType "minLength"}}
			if utf8.RuneCountInString(string({{$recv}}._value)) < {{countExpr .Value}} { _variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxLength"}}
			if utf8.RuneCountInString(string({{$recv}}._value)) > {{countExpr .Value}} { _variantValid = false }
			{{- end}}
			{{- if or (eq .RuleType "minimum") (eq .RuleType "maximum") (eq .RuleType "exclusiveMinimum") (eq .RuleType "exclusiveMaximum") (eq .RuleType "multipleOf")}}
			if {{numViolated . "_num"}} { _variantValid = false }
			{{- end}}
			{{- if eq .RuleType "pattern"}}
			if _matched, _mErr := {{patternVar .Value}}.matches(string({{$recv}}._value)); _mErr != nil {
				// A variant with no verdict leaves the count of matching
				// variants unknown.
				return jsonValueErrorf("%w", _mErr)
			} else if !_matched {
				_variantValid = false
			}
			{{- end}}
			{{- if eq .RuleType "minItems"}}
			if len({{$recv}}._value) < {{countExpr .Value}} { _variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxItems"}}
			if len({{$recv}}._value) > {{countExpr .Value}} { _variantValid = false }
			{{- end}}
			{{- end}}
			if _variantValid { _anyOfValid = true }
		}
		{{- end}}
		if !_anyOfValid {
			return jsonValueErrorf("value does not match any anyOf variant")
		}
	}
	{{- end}}
	{{- if .OneOfVariants}}
	// oneOf: exactly one variant must be satisfied.
	{
		_oneOfCount := 0
		{{- range $vi, $variant := .OneOfVariants}}
		{
			_variantValid := true
			{{- range $variant}}
			{{- if eq .RuleType "never"}}
			// The branch's own "type" excludes every value this type can hold,
			// so the branch matches nothing.
			_variantValid = false
			{{- end}}
			{{- if eq .RuleType "minLength"}}
			if utf8.RuneCountInString(string({{$recv}}._value)) < {{countExpr .Value}} { _variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxLength"}}
			if utf8.RuneCountInString(string({{$recv}}._value)) > {{countExpr .Value}} { _variantValid = false }
			{{- end}}
			{{- if or (eq .RuleType "minimum") (eq .RuleType "maximum") (eq .RuleType "exclusiveMinimum") (eq .RuleType "exclusiveMaximum") (eq .RuleType "multipleOf")}}
			if {{numViolated . "_num"}} { _variantValid = false }
			{{- end}}
			{{- if eq .RuleType "pattern"}}
			if _matched, _mErr := {{patternVar .Value}}.matches(string({{$recv}}._value)); _mErr != nil {
				// A variant with no verdict leaves the count of matching
				// variants unknown.
				return jsonValueErrorf("%w", _mErr)
			} else if !_matched {
				_variantValid = false
			}
			{{- end}}
			{{- if eq .RuleType "minItems"}}
			if len({{$recv}}._value) < {{countExpr .Value}} { _variantValid = false }
			{{- end}}
			{{- if eq .RuleType "maxItems"}}
			if len({{$recv}}._value) > {{countExpr .Value}} { _variantValid = false }
			{{- end}}
			{{- end}}
			if _variantValid { _oneOfCount++ }
		}
		{{- end}}
		if _oneOfCount != 1 {
			return jsonValueErrorf("value matches %d oneOf variants, expected exactly 1", _oneOfCount)
		}
	}
	{{- end}}
	{{- if .HasItemValidation}}
	// Item-level validation for inferred array.
	{{- if .ItemsFalse}}
	if len({{$recv}}._value) > 0 {
		return fmt.Errorf("items: no items are allowed (got %d)", len({{$recv}}._value))
	}
	{{- end}}
	{{- /* Every element check below reads _items, the elements as the document
	       wrote them, and asks whether an element is a number through the
	       exact core rather than by asserting float64 -- which is what a decode
	       into []any makes of a number, and what _items does not. */}}
	{{- if .ItemsType}}
	for _i, _elem := range _items {
		{{- if eq .ItemsType "integer"}}
		if !jsonIsInteger(_elem, {{if $.StrictInteger}}true{{else}}false{{end}}) {
			return fmt.Errorf("items[%d]: expected integer, got %T", _i, _elem)
		}
		{{- else if eq .ItemsType "number"}}
		if !jsonIsNumber(_elem) {
			return fmt.Errorf("items[%d]: expected number, got %T", _i, _elem)
		}
		{{- else if eq .ItemsType "string"}}
		if _, _sOk := _elem.(string); !_sOk {
			return fmt.Errorf("items[%d]: expected string, got %T", _i, _elem)
		}
		{{- else if eq .ItemsType "boolean"}}
		if _, _bOk := _elem.(bool); !_bOk {
			return fmt.Errorf("items[%d]: expected boolean, got %T", _i, _elem)
		}
		{{- else if eq .ItemsType "null"}}
		if _elem != nil {
			return fmt.Errorf("items[%d]: expected null, got %T", _i, _elem)
		}
		{{- else if eq .ItemsType "array"}}
		if _, _aOk := _elem.([]any); !_aOk {
			return fmt.Errorf("items[%d]: expected array, got %T", _i, _elem)
		}
		{{- else if eq .ItemsType "object"}}
		if _, _oOk := _elem.(map[string]any); !_oOk {
			return fmt.Errorf("items[%d]: expected object, got %T", _i, _elem)
		}
		{{- end}}
	}
	{{- end}}
	{{- if .ItemsNode}}
	{{- /* Each element judged as it is held, by the items schema compiled for
	       the evaluator (see ElementNode), rather than marshalled and decoded
	       into the items type -- as the document wrote it, where it did
	       (see _items). */}}
	for _i, _elem := range _items {
		_tv, _tvErr := jsonTreeView(_elem)
		if _tvErr != nil {
			return fmt.Errorf("items[%d]: %w", _i, jsonMarshalError(&_elem, _tvErr))
		}
		if _tr := _evalNode(&{{.ItemsNode.Var}}, _tv); !_tr.ok {
			return fmt.Errorf("items[%d]: %w", _i, _evalError(_tr))
		}
	}
	{{- else if .ItemsTypeName}}
	for _i, _elem := range _items {
		_raw, _mErr := json.Marshal(_elem)
		if _mErr != nil {
			return fmt.Errorf("items[%d]: %w", _i, _mErr)
		}
		var _typed {{.ItemsTypeName}}
		if _uErr := {{if .StrictReadWrite}}_decodeIgnoringReadOnly{{else}}json.Unmarshal{{end}}(_raw, &_typed); _uErr != nil {
			return fmt.Errorf("items[%d]: %w", _i, _uErr)
		}
		if _vErr := _typed.Validate(); _vErr != nil {
			return fmt.Errorf("items[%d]: %w", _i, _vErr)
		}
	}
	{{- end}}
	{{- if .ItemsChecks}}
	for _i, _elem := range _items {
		{{- range .ItemsChecks}}
		{{- if eq .CheckType "type"}}
		{{- if eq .Value "integer"}}
		if !jsonIsInteger(_elem, {{if $.StrictInteger}}true{{else}}false{{end}}) {
			return fmt.Errorf("items[%d]: expected integer, got %T", _i, _elem)
		}
		{{- else if eq .Value "number"}}
		if !jsonIsNumber(_elem) {
			return fmt.Errorf("items[%d]: expected number, got %T", _i, _elem)
		}
		{{- else if eq .Value "string"}}
		if _, _sOk := _elem.(string); !_sOk {
			return fmt.Errorf("items[%d]: expected string, got %T", _i, _elem)
		}
		{{- else if eq .Value "boolean"}}
		if _, _bOk := _elem.(bool); !_bOk {
			return fmt.Errorf("items[%d]: expected boolean, got %T", _i, _elem)
		}
		{{- else if eq .Value "null"}}
		if _elem != nil {
			return fmt.Errorf("items[%d]: expected null, got %T", _i, _elem)
		}
		{{- else if eq .Value "array"}}
		if _, _aOk := _elem.([]any); !_aOk {
			return fmt.Errorf("items[%d]: expected array, got %T", _i, _elem)
		}
		{{- else if eq .Value "object"}}
		if _, _oOk := _elem.(map[string]any); !_oOk {
			return fmt.Errorf("items[%d]: expected object, got %T", _i, _elem)
		}
		{{- end}}
		{{- else if eq .CheckType "minimum"}}
		if {{numAnyViolated .CheckType .Value "_elem"}} {
			return fmt.Errorf("items[%d]: %v is less than minimum {{fmtText .Value}}", _i, _elem)
		}
		{{- else if eq .CheckType "maximum"}}
		if {{numAnyViolated .CheckType .Value "_elem"}} {
			return fmt.Errorf("items[%d]: %v exceeds maximum {{fmtText .Value}}", _i, _elem)
		}
		{{- else if eq .CheckType "exclusiveMinimum"}}
		if {{numAnyViolated .CheckType .Value "_elem"}} {
			return fmt.Errorf("items[%d]: %v must be greater than {{fmtText .Value}}", _i, _elem)
		}
		{{- else if eq .CheckType "exclusiveMaximum"}}
		if {{numAnyViolated .CheckType .Value "_elem"}} {
			return fmt.Errorf("items[%d]: %v must be less than {{fmtText .Value}}", _i, _elem)
		}
		{{- else if eq .CheckType "multipleOf"}}
		if {{numAnyViolated .CheckType .Value "_elem"}} {
			return fmt.Errorf("items[%d]: %v is not a multiple of {{fmtText .Value}}", _i, _elem)
		}
		{{- end}}
		{{- end}}
	}
	{{- end}}
	{{- if .ItemsNested}}
	for _i, _elem := range _items {
		_nested, _nestedOk := _elem.([]any)
		if !_nestedOk {
			continue
		}
		{{- /* maporder: not a map: ranges a slice, _nested is asserted to []any above. */}}
		for _j, _nestedElem := range _nested {
			{{- if eq .ItemsNested.ItemsType "integer"}}
			if !jsonIsInteger(_nestedElem, {{if $.StrictInteger}}true{{else}}false{{end}}) {
				return fmt.Errorf("items[%d][%d]: expected integer, got %T", _i, _j, _nestedElem)
			}
			{{- else if eq .ItemsNested.ItemsType "number"}}
			if !jsonIsNumber(_nestedElem) {
				return fmt.Errorf("items[%d][%d]: expected number, got %T", _i, _j, _nestedElem)
			}
			{{- else if eq .ItemsNested.ItemsType "string"}}
			if _, _sOk := _nestedElem.(string); !_sOk {
				return fmt.Errorf("items[%d][%d]: expected string, got %T", _i, _j, _nestedElem)
			}
			{{- else if eq .ItemsNested.ItemsType "boolean"}}
			if _, _bOk := _nestedElem.(bool); !_bOk {
				return fmt.Errorf("items[%d][%d]: expected boolean, got %T", _i, _j, _nestedElem)
			}
			{{- else if eq .ItemsNested.ItemsType "null"}}
			if _nestedElem != nil {
				return fmt.Errorf("items[%d][%d]: expected null, got %T", _i, _j, _nestedElem)
			}
			{{- else if eq .ItemsNested.ItemsType "array"}}
			if _, _aOk := _nestedElem.([]any); !_aOk {
				return fmt.Errorf("items[%d][%d]: expected array, got %T", _i, _j, _nestedElem)
			}
			{{- else if eq .ItemsNested.ItemsType "object"}}
			if _, _oOk := _nestedElem.(map[string]any); !_oOk {
				return fmt.Errorf("items[%d][%d]: expected object, got %T", _i, _j, _nestedElem)
			}
			{{- end}}
		}
	}
	{{- end}}
	{{- if .TupleItems}}
	{
		{{- range $idx, $item := .TupleItems}}
		{{- if $item.IsFalse}}
		if len({{$recv}}._value) > {{$idx}} {
			return fmt.Errorf("items[{{$idx}}]: value is not allowed (schema is false)")
		}
		{{- else if $item.JSONType}}
		if len(_items) > {{$idx}} {
			_tElem := _items[{{$idx}}]
			{{- if eq $item.JSONType "integer"}}
			if !jsonIsInteger(_tElem, {{if $.StrictInteger}}true{{else}}false{{end}}) {
				return fmt.Errorf("items[{{$idx}}]: expected integer, got %T", _tElem)
			}
			{{- else if eq $item.JSONType "number"}}
			if !jsonIsNumber(_tElem) {
				return fmt.Errorf("items[{{$idx}}]: expected number, got %T", _tElem)
			}
			{{- else if eq $item.JSONType "string"}}
			if _, _sOk := _tElem.(string); !_sOk {
				return fmt.Errorf("items[{{$idx}}]: expected string, got %T", _tElem)
			}
			{{- else if eq $item.JSONType "boolean"}}
			if _, _bOk := _tElem.(bool); !_bOk {
				return fmt.Errorf("items[{{$idx}}]: expected boolean, got %T", _tElem)
			}
			{{- else if eq $item.JSONType "null"}}
			if _tElem != nil {
				return fmt.Errorf("items[{{$idx}}]: expected null, got %T", _tElem)
			}
			{{- else if eq $item.JSONType "array"}}
			if _, _aOk := _tElem.([]any); !_aOk {
				return fmt.Errorf("items[{{$idx}}]: expected array, got %T", _tElem)
			}
			{{- else if eq $item.JSONType "object"}}
			if _, _oOk := _tElem.(map[string]any); !_oOk {
				return fmt.Errorf("items[{{$idx}}]: expected object, got %T", _tElem)
			}
			{{- end}}
		}
		{{- else if $item.Node}}
		if len({{$recv}}._value) > {{$idx}} {
			{{- /* Judged as it is held; see ElementNode. */}}
			_tv, _tvErr := jsonTreeView({{$recv}}._value[{{$idx}}])
			if _tvErr != nil {
				return fmt.Errorf("items[{{$idx}}]: %w", jsonMarshalError(&{{$recv}}._value[{{$idx}}], _tvErr))
			}
			if _tr := _evalNode(&{{$item.Node.Var}}, _tv); !_tr.ok {
				return fmt.Errorf("items[{{$idx}}]: %w", _evalError(_tr))
			}
		}
		{{- else if $item.TypeName}}
		if len(_items) > {{$idx}} {
			_raw, _mErr := json.Marshal(_items[{{$idx}}])
			if _mErr != nil {
				return fmt.Errorf("items[{{$idx}}]: %w", _mErr)
			}
			var _typed {{$item.TypeName}}
			if _uErr := {{if $.StrictReadWrite}}_decodeIgnoringReadOnly{{else}}json.Unmarshal{{end}}(_raw, &_typed); _uErr != nil {
				return fmt.Errorf("items[{{$idx}}]: %w", _uErr)
			}
			if _vErr := _typed.Validate(); _vErr != nil {
				return fmt.Errorf("items[{{$idx}}]: %w", _vErr)
			}
		}
		{{- end}}
		{{- end}}
	}
	{{- end}}
	{{- if .AdditionalItemsFalse}}
	if len({{$recv}}._value) > {{len .TupleItems}} {
		return fmt.Errorf("additionalItems: %d extra items are not allowed", len({{$recv}}._value) - {{len .TupleItems}})
	}
	{{- end}}
	{{- if .AdditionalItemsNode}}
	{{- /* The tail judged as it is held; see ElementNode, and the typed arm below. */}}
	for _i := {{len .TupleItems}}; _i < len({{$recv}}._value); _i++ {
		_tv, _tvErr := jsonTreeView({{$recv}}._value[_i])
		if _tvErr != nil {
			return fmt.Errorf("additionalItems[%d]: %w", _i, jsonMarshalError(&{{$recv}}._value[_i], _tvErr))
		}
		if _tr := _evalNode(&{{.AdditionalItemsNode.Var}}, _tv); !_tr.ok {
			return fmt.Errorf("additionalItems[%d]: %w", _i, _evalError(_tr))
		}
	}
	{{- else if .AdditionalItemsTypeName}}
	{{- /*
	The tail's own generated type answers for everything its sub-schema states.
	AdditionalItemsType below can only say which JSON type the tail declares, so
	{"prefixItems":[...],"items":{"type":"object","required":["a"]}} accepted a
	trailing {} -- the element half of issue #166, one position along.
	*/}}
	for _i := {{len .TupleItems}}; _i < len(_items); _i++ {
		_raw, _mErr := json.Marshal(_items[_i])
		if _mErr != nil {
			return fmt.Errorf("additionalItems[%d]: %w", _i, _mErr)
		}
		var _typed {{.AdditionalItemsTypeName}}
		if _uErr := {{if .StrictReadWrite}}_decodeIgnoringReadOnly{{else}}json.Unmarshal{{end}}(_raw, &_typed); _uErr != nil {
			return fmt.Errorf("additionalItems[%d]: %w", _i, _uErr)
		}
		if _vErr := _typed.Validate(); _vErr != nil {
			return fmt.Errorf("additionalItems[%d]: %w", _i, _vErr)
		}
	}
	{{- end}}
	{{- if .AdditionalItemsType}}
	for _i := {{len .TupleItems}}; _i < len(_items); _i++ {
		_elem := _items[_i]
		{{- if eq .AdditionalItemsType "integer"}}
		if !jsonIsInteger(_elem, {{if .StrictInteger}}true{{else}}false{{end}}) {
			return fmt.Errorf("additionalItems[%d]: expected integer, got %T", _i, _elem)
		}
		{{- else if eq .AdditionalItemsType "number"}}
		if !jsonIsNumber(_elem) {
			return fmt.Errorf("additionalItems[%d]: expected number, got %T", _i, _elem)
		}
		{{- else if eq .AdditionalItemsType "string"}}
		if _, _sOk := _elem.(string); !_sOk {
			return fmt.Errorf("additionalItems[%d]: expected string, got %T", _i, _elem)
		}
		{{- else if eq .AdditionalItemsType "boolean"}}
		if _, _bOk := _elem.(bool); !_bOk {
			return fmt.Errorf("additionalItems[%d]: expected boolean, got %T", _i, _elem)
		}
		{{- else if eq .AdditionalItemsType "null"}}
		if _elem != nil {
			return fmt.Errorf("additionalItems[%d]: expected null, got %T", _i, _elem)
		}
		{{- else if eq .AdditionalItemsType "array"}}
		if _, _aOk := _elem.([]any); !_aOk {
			return fmt.Errorf("additionalItems[%d]: expected array, got %T", _i, _elem)
		}
		{{- else if eq .AdditionalItemsType "object"}}
		if _, _oOk := _elem.(map[string]any); !_oOk {
			return fmt.Errorf("additionalItems[%d]: expected object, got %T", _i, _elem)
		}
		{{- end}}
	}
	{{- end}}
	{{- end}}
	{{- if .HasContainsValidation}}
	{{- template "contains_check" (mkContainsCtx "_items" "contains" .Contains .MinContains .MaxContains)}}
	{{- end}}
	{{- if .HasUnevaluatedItems}}
	// unevaluatedItems validation
	{
		arr := _items
		if arr != nil {
			evaluatedCount := {{.UnevaluatedItems.EvaluatedCount}}
			allEvaluated := {{if .UnevaluatedItems.AllEvaluated}}true{{else}}false{{end}}
			{{- range .UnevaluatedItems.ConditionalEvals}}
			{{- if eq .Kind "allOf"}}
			// allOf: statically evaluated
			{{- if .AllEvaluated}}
			allEvaluated = true
			{{- else if gt .EvaluatedCount 0}}
			if {{.EvaluatedCount}} > evaluatedCount {
				evaluatedCount = {{.EvaluatedCount}}
			}
			{{- end}}
			{{- else if eq .Kind "ref"}}
			{{- if .AllEvaluated}}
			allEvaluated = true
			{{- else if gt .EvaluatedCount 0}}
			if {{.EvaluatedCount}} > evaluatedCount {
				evaluatedCount = {{.EvaluatedCount}}
			}
			{{- end}}
			{{- else if eq .Kind "anyOf"}}
			// anyOf: take maximum of any matching branch
			{
				branchEvals := []int{ {{- range $i, $b := .Branches}}{{if $i}}, {{end}}{{$b.EvaluatedCount}}{{end -}} }
				branchAllEval := []bool{ {{- range $i, $b := .Branches}}{{if $i}}, {{end}}{{$b.AllEvaluated}}{{end -}} }
				{{- /* maporder: not a map: ranges a slice, branchEvals is the []int declared above. */}}
				for _bi, _be := range branchEvals {
					if branchAllEval[_bi] {
						allEvaluated = true
						break
					}
					if _be > evaluatedCount {
						evaluatedCount = _be
					}
				}
			}
			{{- else if eq .Kind "oneOf"}}
			// oneOf: take maximum of any matching branch (exactly one matches)
			{
				branchEvals := []int{ {{- range $i, $b := .Branches}}{{if $i}}, {{end}}{{$b.EvaluatedCount}}{{end -}} }
				branchAllEval := []bool{ {{- range $i, $b := .Branches}}{{if $i}}, {{end}}{{$b.AllEvaluated}}{{end -}} }
				{{- /* maporder: not a map: ranges a slice, branchEvals is the []int declared above. */}}
				for _bi, _be := range branchEvals {
					if branchAllEval[_bi] {
						allEvaluated = true
						break
					}
					if _be > evaluatedCount {
						evaluatedCount = _be
					}
				}
			}
			{{- else if eq .Kind "ifThenElse"}}
			// if/then/else: evaluate if-condition at runtime to choose branch
			{
				{{- if and (not .IfItemChecks) (not .IfAllEval)}}
				{{- /* No runtime checks available — fall back to static max */}}
				{{- if .ThenAllEval}}
				allEvaluated = true
				{{- else if .ElseAllEval}}
				allEvaluated = true
				{{- else}}
				thenEval := {{.ThenEvalCount}}
				elseEval := {{.ElseEvalCount}}
				ifEval := {{.IfEvalCount}}
				maxEval := thenEval
				if ifEval > maxEval { maxEval = ifEval }
				if elseEval > maxEval { maxEval = elseEval }
				if maxEval > evaluatedCount { evaluatedCount = maxEval }
				{{- end}}
				{{- else}}
				{{- /* Runtime if-condition evaluation */}}
				_ifMatch := true
				{{- range .IfItemChecks}}
				if _ifMatch {
					if len(arr) <= {{.Index}} {
						_ifMatch = false
					} else {
						{{- /* Compared by identity (see jsonID): the item was
						       marshalled and its text compared with the const's
						       spelling. */}}
						_ib, _ie := jsonMatchesConstAt(&arr[{{.Index}}], jsonConstOf(false, {{printf "%q" .JSONValue}}))
						if _ie != nil || !_ib {
							_ifMatch = false
						}
					}
				}
				{{- end}}
				if _ifMatch {
					{{- if .IfAllEval}}
					allEvaluated = true
					{{- else if .ThenAllEval}}
					allEvaluated = true
					{{- else}}
					_branchEval := {{.IfEvalCount}}
					if {{.ThenEvalCount}} > _branchEval { _branchEval = {{.ThenEvalCount}} }
					if _branchEval > evaluatedCount { evaluatedCount = _branchEval }
					{{- end}}
				} else {
					{{- if .ElseAllEval}}
					allEvaluated = true
					{{- else}}
					if {{.ElseEvalCount}} > evaluatedCount { evaluatedCount = {{.ElseEvalCount}} }
					{{- end}}
				}
				{{- end}}
			}
			{{- end}}
			{{- end}}

			if !allEvaluated && len(arr) > evaluatedCount {
			{{- if .UnevaluatedItems.ContainsEvaluates}}
			// contains evaluates matching items at runtime — check each item beyond evaluatedCount
			for _ui := evaluatedCount; _ui < len(arr); _ui++ {
				_uiElem := arr[_ui]
				_evaluatedByContains := false
				{{- if .Contains}}
				{{- if .Contains.IsTrue}}
				_evaluatedByContains = true
				{{- else if .Contains.ConstJSON}}
				{
					{{- /* Compared by identity, as the cardinality check compares it. */}}
					_cOK, _cErr := jsonMatchesConstAt(&_uiElem, jsonConstOf(false, {{printf "%q" .Contains.ConstJSON}}))
					if _cErr == nil && _cOK {
						_evaluatedByContains = true
					}
				}
				{{- else if .Contains.EnumJSON}}
				{{- /* An enum `contains` evaluates the items it matches, as a const
				       one does, compared by identity as the cardinality check
				       compares it. This arm was missing, so no item counted as
				       evaluated by it and unevaluatedItems refused them. */}}
				{
					_cOK, _cErr := jsonMatchesConstAt(&_uiElem, jsonConstOf(false,
						{{- range .Contains.EnumJSON}}
						{{printf "%q" .}},
						{{- end}}
					))
					if _cErr == nil && _cOK {
						_evaluatedByContains = true
					}
				}
				{{- else if .Contains.Node}}
				{{- /* The same test the cardinality check makes, asked of one item,
				       as it is held; see ElementNode. */}}
				if _cTv, _cTvErr := jsonTreeView(_uiElem); _cTvErr == nil {
					_cr := _evalNode(&{{.Contains.Node.Var}}, _cTv)
					if _cr.undecided != nil {
						// Whether contains evaluated this item has no answer.
						return fmt.Errorf("contains[%d]: %w", _ui, _evalError(_cr))
					}
					_evaluatedByContains = _cr.ok
				}
				{{- else if .Contains.TypeName}}
				{{- /*
				The same test the cardinality check makes, asked of one item:
				an item `contains` matches is an item `contains` evaluated, and
				a delegated sub-schema has to answer that too. Without this arm
				the item counted as unevaluated and unevaluatedItems: false
				refused a document its own contains had accounted for.
				*/}}
				{
					_cBytes, _cErr := json.Marshal(_uiElem)
					if _cErr == nil {
						var _cTyped {{.Contains.TypeName}}
						_cDErr := {{if .Contains.StrictReadWrite}}_decodeIgnoringReadOnly{{else}}json.Unmarshal{{end}}(_cBytes, &_cTyped)
						if _cDErr == nil {
							_cDErr = _cTyped.Validate()
						}
						if _cDErr == nil {
							_evaluatedByContains = true
						} else if _schemagenUndecided(_cDErr) {
							// Whether contains evaluated this item has no answer.
							return fmt.Errorf("contains[%d]: %w", _ui, _cDErr)
						}
					}
				}
				{{- else if .Contains.Checks}}
				{
					_cMatch := true
					{{- range .Contains.Checks}}
					{{- if eq .CheckType "type"}}
					{{- if eq .Value "integer"}}
					if _cMatch && !jsonIsInteger(_uiElem, false) {
						_cMatch = false
					}
					{{- else if eq .Value "number"}}
					if _cMatch && !jsonIsNumber(_uiElem) {
						_cMatch = false
					}
					{{- else if eq .Value "string"}}
					if _cMatch {
						if _, _csOk := _uiElem.(string); !_csOk {
							_cMatch = false
						}
					}
					{{- else if eq .Value "boolean"}}
					if _cMatch {
						if _, _cbOk := _uiElem.(bool); !_cbOk {
							_cMatch = false
						}
					}
					{{- else if eq .Value "null"}}
					if _cMatch {
						if _uiElem != nil {
							_cMatch = false
						}
					}
					{{- else if eq .Value "array"}}
					if _cMatch {
						if _, _caOk := _uiElem.([]any); !_caOk {
							_cMatch = false
						}
					}
					{{- else if eq .Value "object"}}
					if _cMatch {
						if _, _coOk := _uiElem.(map[string]any); !_coOk {
							_cMatch = false
						}
					}
					{{- end}}
					{{- else if or (eq .CheckType "minimum") (eq .CheckType "maximum") (eq .CheckType "exclusiveMinimum") (eq .CheckType "exclusiveMaximum") (eq .CheckType "multipleOf")}}
					{{- /* A numeric keyword says nothing about a value that is not a
					       number, which therefore satisfies it; the helper answers
					       false for one. The exclusive bounds and multipleOf had no
					       arm here, so an item contains refused on one of them was
					       still counted as evaluated. */}}
					if _cMatch && {{numAnyViolated .CheckType .Value "_uiElem"}} {
						_cMatch = false
					}
					{{- else if eq .CheckType "pattern"}}
					{{- /* A string only: a pattern says nothing about any other
					       value, which it therefore does not refuse. This arm
					       was missing, so an item contains' pattern refused was
					       still counted as evaluated by contains. */}}
					if _cMatch {
						if _cs, _csOk := _uiElem.(string); _csOk {
							_cm, _cmErr := {{patternVar .Value}}.matches(_cs)
							if _cmErr != nil {
								return fmt.Errorf("contains[%d]: %w", _ui, _cmErr)
							}
							if !_cm {
								_cMatch = false
							}
						}
					}
					{{- end}}
					{{- end}}
					_evaluatedByContains = _cMatch
				}
				{{- end}}
				{{- end}}
				if !_evaluatedByContains {
					{{- if .UnevaluatedItems.IsForbidden}}
					return fmt.Errorf("unevaluatedItems: item at index %d is not evaluated", _ui)
					{{- else}}
					_ = _uiElem
					{{- if .UnevaluatedItems.ValueType}}
					{{- if eq .UnevaluatedItems.ValueType "string"}}
					if _, ok := _uiElem.(string); !ok {
						return fmt.Errorf("unevaluatedItems[%d]: must be a string", _ui)
					}
					{{- else if eq .UnevaluatedItems.ValueType "integer"}}
					if !jsonIsInteger(_uiElem, false) {
						return fmt.Errorf("unevaluatedItems[%d]: must be an integer", _ui)
					}
					{{- else if eq .UnevaluatedItems.ValueType "number"}}
					if !jsonIsNumber(_uiElem) {
						return fmt.Errorf("unevaluatedItems[%d]: must be a number", _ui)
					}
					{{- else if eq .UnevaluatedItems.ValueType "boolean"}}
					if _, ok := _uiElem.(bool); !ok {
						return fmt.Errorf("unevaluatedItems[%d]: must be a boolean", _ui)
					}
					{{- end}}
					{{- end}}
					{{- end}}
				}
			}
			{{- else}}
			{{- if .UnevaluatedItems.IsForbidden}}
				return fmt.Errorf("unevaluatedItems: %d unevaluated items found (only %d items are evaluated)", len(arr)-evaluatedCount, evaluatedCount)
				{{- else}}
				for _ui := evaluatedCount; _ui < len(arr); _ui++ {
					_uiElem := arr[_ui]
					_ = _uiElem
					{{- if .UnevaluatedItems.ValueType}}
					{{- if eq .UnevaluatedItems.ValueType "string"}}
					if _, ok := _uiElem.(string); !ok {
						return fmt.Errorf("unevaluatedItems[%d]: must be a string", _ui)
					}
					{{- else if eq .UnevaluatedItems.ValueType "integer"}}
					{{- /* float64(int64(x)) is not an integer test past 2^63, where
					       the conversion is undefined. */}}
					if !jsonIsInteger(_uiElem, false) {
						return fmt.Errorf("unevaluatedItems[%d]: must be an integer", _ui)
					}
					{{- else if eq .UnevaluatedItems.ValueType "number"}}
					if !jsonIsNumber(_uiElem) {
						return fmt.Errorf("unevaluatedItems[%d]: must be a number", _ui)
					}
					{{- else if eq .UnevaluatedItems.ValueType "boolean"}}
					if _, ok := _uiElem.(bool); !ok {
						return fmt.Errorf("unevaluatedItems[%d]: must be a boolean", _ui)
					}
					{{- else if eq .UnevaluatedItems.ValueType "object"}}
					if _, ok := _uiElem.(map[string]any); !ok {
						return fmt.Errorf("unevaluatedItems[%d]: must be an object", _ui)
					}
					{{- else if eq .UnevaluatedItems.ValueType "array"}}
					if _, ok := _uiElem.([]any); !ok {
						return fmt.Errorf("unevaluatedItems[%d]: must be an array", _ui)
					}
					{{- else if eq .UnevaluatedItems.ValueType "null"}}
					if _uiElem != nil {
						return fmt.Errorf("unevaluatedItems[%d]: must be null", _ui)
					}
					{{- end}}
					{{- end}}
					{{- template "uneval_item_checks" (mkUnevalItemsCtx "" "unevaluatedItems" .UnevaluatedItems)}}
				}
				{{- end}}
			{{- end}}
			}
		}
	}
	{{- end}}
	return nil
}
{{- end}}
