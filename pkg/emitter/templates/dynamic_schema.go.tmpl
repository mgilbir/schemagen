{{define "dynamic_schema"}}
{{- $recv := receiverName .Name -}}
{{- template "type_doc" .}}
// {{.Name}} accepts any JSON value. The schema declares no type of its own, so
// the constraints come entirely from its applicators and are checked against
// the decoded value by Validate.
{{- template "annotation_comment" mkAnnotationCtx .Annotations "" true}}
type {{.Name}} struct {
	_raw json.RawMessage
}

{{template "raw_holder_methods" .}}

// IsZero reports whether no value was present, so an optional field tagged
// ",omitzero" is omitted when absent rather than marshalled as null.
func ({{$recv}} {{.Name}}) IsZero() bool { return len({{$recv}}._raw) == 0 }

func ({{$recv}} {{.Name}}) String() string { return string({{$recv}}._raw) }

// Validate checks {{.Name}} against its JSON Schema constraints.
func ({{$recv}} {{.Name}}) Validate() error {
	// No value was present. A constraint applies to a value that is there; an
	// absent optional property is the parent's business (required), not this
	// type's.
	if len({{$recv}}._raw) == 0 {
		return nil
	}
	var _v any
	if _err := json.Unmarshal({{$recv}}._raw, &_v); _err != nil {
		return fmt.Errorf("cannot decode value: %w", _err)
	}
	{{- $undecided := .NeedsPattern}}
	{{- if $undecided}}
	// A pattern the engine could not decide is recorded here by the branch
	// that met it, and returned before that branch's answer is used: it is
	// neither a match nor a failure. See dyn_branch.
	var _undecided error
	{{- end}}
	{{- if .OneOf}}
	{
		_matches := 0
		{{- range $bi, $branch := .OneOf}}
		if {{template "dyn_branch" $branch}} {
			_matches++
		}
		{{- end}}
		{{- if $undecided}}
		if _undecided != nil {
			return fmt.Errorf("oneOf: %w", _undecided)
		}
		{{- end}}
		if _matches != 1 {
			return fmt.Errorf("oneOf: value matches %d variants, expected exactly 1", _matches)
		}
	}
	{{- end}}
	{{- if .AnyOf}}
	{
		_matches := 0
		{{- range $bi, $branch := .AnyOf}}
		if {{template "dyn_branch" $branch}} {
			_matches++
		}
		{{- end}}
		{{- if $undecided}}
		if _undecided != nil {
			return fmt.Errorf("anyOf: %w", _undecided)
		}
		{{- end}}
		if _matches == 0 {
			return fmt.Errorf("anyOf: value matches no variant")
		}
	}
	{{- end}}
	{{- if and .HasIfThenElse $undecided}}
	_ifHolds := {{template "dyn_branch" .If}}
	if _undecided != nil {
		return fmt.Errorf("if: %w", _undecided)
	}
	if _ifHolds {
		{{- if .HasThen}}
		_thenHolds := {{template "dyn_branch" .Then}}
		if _undecided != nil {
			return fmt.Errorf("then: %w", _undecided)
		}
		if !_thenHolds {
			return fmt.Errorf("then: value does not satisfy the then schema")
		}
		{{- end}}
	} else {
		{{- if .HasElse}}
		_elseHolds := {{template "dyn_branch" .Else}}
		if _undecided != nil {
			return fmt.Errorf("else: %w", _undecided)
		}
		if !_elseHolds {
			return fmt.Errorf("else: value does not satisfy the else schema")
		}
		{{- end}}
	}
	{{- else if .HasIfThenElse}}
	if {{template "dyn_branch" .If}} {
		{{- if .HasThen}}
		if !({{template "dyn_branch" .Then}}) {
			return fmt.Errorf("then: value does not satisfy the then schema")
		}
		{{- end}}
	} else {
		{{- if .HasElse}}
		if !({{template "dyn_branch" .Else}}) {
			return fmt.Errorf("else: value does not satisfy the else schema")
		}
		{{- end}}
	}
	{{- end}}
	return nil
}
{{- end}}

{{/*
dyn_branch renders a boolean expression that is true when the decoded value _v
satisfies every check in the branch. An empty branch matches everything.

A "pattern" check records a match the engine could not decide in the local
error _undecided and answers true, so a caller rendering a branch with one
(dynChecksMatchPattern) declares _undecided beforehand and returns it, when
set, before it acts on the expression's value: an undecided match is neither a
match nor a failure.

Every keyword except "type" is vacuously satisfied by a value of an
inapplicable type, per JSON Schema: {"minimum":2} accepts "abc". That is why
each numeric and string check is written as "not of this type, OR constraint
holds".
*/}}
{{define "dyn_branch"}}
{{- if not .}}true
{{- else}}
{{- range $i, $c := .}}{{if $i}} && {{end}}
{{- if eq $c.Kind "type"}}
{{- if eq $c.Value "integer"}}_dynIsInteger(_v)
{{- else if eq $c.Value "number"}}_dynIsNumber(_v)
{{- else if eq $c.Value "string"}}_dynIsString(_v)
{{- else if eq $c.Value "boolean"}}_dynIsBool(_v)
{{- else if eq $c.Value "object"}}_dynIsObject(_v)
{{- else if eq $c.Value "array"}}_dynIsArray(_v)
{{- else if eq $c.Value "null"}}_v == nil
{{- else}}true
{{- end}}
{{- else if eq $c.Kind "const"}}_dynConstOK(_v, {{printf "%q" $c.Value}})
{{- else if eq $c.Kind "minimum"}}_dynNumOK(_v, func(_n float64) bool { return _n >= {{dynNum $c.Value}} })
{{- else if eq $c.Kind "maximum"}}_dynNumOK(_v, func(_n float64) bool { return _n <= {{dynNum $c.Value}} })
{{- else if eq $c.Kind "exclusiveMinimum"}}_dynNumOK(_v, func(_n float64) bool { return _n > {{dynNum $c.Value}} })
{{- else if eq $c.Kind "exclusiveMaximum"}}_dynNumOK(_v, func(_n float64) bool { return _n < {{dynNum $c.Value}} })
{{- else if eq $c.Kind "multipleOf"}}_dynNumOK(_v, func(_n float64) bool { return math.Mod(_n, {{dynNum $c.Value}}) == 0 })
{{- else if eq $c.Kind "minLength"}}_dynStrOK(_v, func(_str string) bool { return utf8.RuneCountInString(_str) >= {{countExpr $c.Value}} })
{{- else if eq $c.Kind "maxLength"}}_dynStrOK(_v, func(_str string) bool { return utf8.RuneCountInString(_str) <= {{countExpr $c.Value}} })
{{- else if eq $c.Kind "pattern"}}{{patternVar $c.Value}}.matchesValue(_v, &_undecided)
{{- else}}true
{{- end}}
{{- end}}
{{- end}}
{{- end}}
