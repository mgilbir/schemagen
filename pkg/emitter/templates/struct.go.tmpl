{{define "struct"}}
{{- template "type_doc" .}}
{{- template "annotation_comment" mkAnnotationCtx .Annotations "" .HasProse}}
{{- /* Members are in the order the layout pass chose, which is the order they
       cost the least room and the least garbage-collector scanning in. The
       three kinds are the schema's own properties, the sealed-interface field a
       oneOf becomes, and the members this generator adds for itself. See
       generator/members.go. */}}
type {{.Name}} struct {
{{- range .Members}}
{{- if .IsProperty}}{{with .Field}}
	{{- template "member_doc" .}}
	{{- template "annotation_comment" mkAnnotationCtx .Annotations "\t" .HasProse}}
	{{- if .ManualJSON}}
	{{.Name}} {{goType .Type}} `json:"-"`
	{{- else}}
	{{.Name}} {{goType .Type}} `json:"{{.JSONName}}{{if .OmitZero}},omitzero{{else if .OmitEmpty}},omitempty{{end}}"`
	{{- end}}
{{- end}}
{{- else if .IsUnion}}{{with .OneOf}}
	{{- template "member_doc" .}}
	{{- template "annotation_comment" mkAnnotationCtx .Annotations "\t" .HasProse}}
	{{.FieldName}} {{.InterfaceName}} `json:"-"`
{{- end}}
{{- else}}
	{{.Name}} {{goType .Type}}{{if .Tag}} `{{.Tag}}`{{end}}{{if .Comment}} // {{.Comment}}{{end}}
{{- end}}
{{- end}}
}
{{- if .AccessRules}}

// {{.Name}}AccessRules is what --strict-read-write has to say about the values
// below this struct's own members: which of them a document may not set, and
// which are never written back out. The two key lists in UnmarshalJSON and
// MarshalJSON answer for the members themselves, which is what a Go field can
// carry; these are paths down to a member of a value the generated code keeps as
// raw JSON, where there is no field and no nested decode. See _accessRule.
var {{.Name}}AccessRules = {{accessRules .AccessRules}}
{{- end}}
{{- range .OneOfs}}
{{template "oneof_interface" mkOneOfCtx . $.Name}}
{{template "oneof_getters" mkOneOfCtx . $.Name}}
{{- end}}
{{- if .NeedsUnmarshal}}
{{template "unmarshal" .}}
{{- end}}
{{- if .NeedsMarshal}}
{{template "marshal" .}}
{{- end}}
{{- if .HasDefaults}}
{{template "set_defaults" .}}
{{- end}}
{{template "validate" .}}
{{- end}}
