		// astronomical and the answer is smaller than _dm either way.
		_p := new(big.Int).Exp(_ten, big.NewInt(_k), _dm)
		_r := new(big.Int).Mod(_dv, _dm)
		_r.Mul(_r, _p)
		_r.Mod(_r, _dm)
