// jsonIdentity is the identity of a value read lazily from a document (see
// jsonLazy.jsonDocID), or, reading trees, its tree: the value as encoding/json
// decodes it into an any, every number a float64.
func (l jsonLazy) jsonIdentity(m *jsonValidation) (jsonID, error) {
	if m.reading() {
		t, err := jsonTreeRaw(l.d.raw(l.sp), true)
		if err != nil {
			return jsonID{}, err
		}
		m.push(t)
		return jsonID{}, nil
	}
	return l.jsonDocID()
}
