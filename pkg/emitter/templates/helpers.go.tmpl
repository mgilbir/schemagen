func _jsonCanonicalValue(b *strings.Builder, v any) {
	switch _t := v.(type) {
	case nil:
		b.WriteString("null")
	case bool:
		if _t {
			b.WriteString("true")
		} else {
			b.WriteString("false")
		}
	case json.Number:
		b.WriteString(_jsonCanonicalNumber(string(_t)))
	case string:
