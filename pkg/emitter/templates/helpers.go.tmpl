		_i++
	}
	_int := s[_start:_i]
	_frac := ""
	if _i < len(s) && s[_i] == '.' {
		_i++
		_start = _i
		for _i < len(s) && s[_i] >= '0' && s[_i] <= '9' {
			_i++
		}
		_frac = s[_start:_i]
