// one -- the decode goes through jsonNumber, which refuses anything that is not
// a number token -- so it takes a caller assigning a literal by hand, and
// json.Number's own MarshalJSON refuses that value in turn.
func jsonNumberParts(s string) (neg bool, digits string, scale int64, ok bool) {
