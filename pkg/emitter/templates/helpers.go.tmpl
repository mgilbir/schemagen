		return true
	}
	if _vDig == "" {
		// Zero is a multiple of every number.
		return true
	}
	_dv, _dvOK := new(big.Int).SetString(_vDig, 10)
	_dm, _dmOK := new(big.Int).SetString(_mDig, 10)
