{{define "enum"}}
{{- if .IsRaw}}{{template "enum_raw" .}}
{{- else}}{{template "enum_const" .}}
{{- end}}
{{- end}}

{{/* enum_null_guard is the first statement of whichever UnmarshalJSON a const
     enum ends up with. It is a template rather than three copies because which
     decoder the type declares is decided by its base type and its draft, and
     the refusal is decided by its schema -- the two are independent, and every
     combination has to carry it. */}}
{{define "enum_null_guard"}}
{{- if .NeedsNullCheck}}
	if string(data) == "null" {
		return fmt.Errorf("null is not allowed for type {{.Name}}")
	}
{{- end}}
{{- end}}

{{define "enum_const"}}
{{- if .Description}}
// {{.Name}} - {{comment "" .Description}}
{{- end}}
{{- template "annotation_comment" mkAnnotationCtx .Annotations "" (ne .Description "")}}
type {{.Name}} {{goType .BaseType}}

const (
{{- range .Values}}
	{{.Name}} {{$.Name}} = {{if $.IsNumberBase}}{{numberEnumValue .Value}}{{else}}{{enumValue .Value}}{{end}}
{{- end}}
)
{{- $recv := receiverName .Name}}
{{- if .IsNumberBase}}

// UnmarshalJSON decodes the number as the literal it was written as, which is
// what this type holds it as. It goes through jsonNumber rather than straight
// into the named type for two reasons: a named type over json.Number is a plain
// Go string to encoding/json and refuses a number outright, and json.Number
// itself would take a JSON *string* for a number, which the schema does not.
func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	{{- template "enum_null_guard" .}}
	var _nv jsonNumber
	if _err := _nv.UnmarshalJSON(data); _err != nil {
		return _err
	}
	*{{$recv}} = {{.Name}}(_nv)
	return nil
}

// MarshalJSON writes the literal back out as the number it is. Without it the
// named type is a Go string to encoding/json and the member leaves quoted --
// 1.5 written back out as "1.5", with nothing failing to say so.
func ({{$recv}} {{.Name}}) MarshalJSON() ([]byte, error) {
	return json.Marshal(json.Number({{$recv}}))
}
{{- end}}
{{- if .IntegerToken}}

// UnmarshalJSON decodes an integer written any way its draft allows -- 1, 1.0
// or 1e0 all name the same member from draft 6 on. Without it the bare named
// type is an int64 to encoding/json, which takes only the first spelling, and
// the enum would reject a document its own schema admits.
func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	{{- template "enum_null_guard" .}}
	var _iv jsonInteger
	if _err := _iv.UnmarshalJSON(data); _err != nil {
		return _err
	}
	*{{$recv}} = {{.Name}}(_iv)
	return nil
}
{{- end}}
{{- if and .NeedsNullCheck (not .IsNumberBase) (not .IntegerToken)}}

// UnmarshalJSON refuses a JSON null, which the schema's own type excludes.
//
// Without it the named type has no decoder at all, and encoding/json leaves a
// named string, bool or int64 exactly as it found it for a null -- so the
// document was accepted and Validate judged the zero value it never wrote. That
// is invisible whenever the zero is a member of the enum. The two arms above
// carry the same guard inside the decoders they already declare.
func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	{{- template "enum_null_guard" .}}
	{{- /* The same spelling the alias template's own fallback uses: the local
	       type carries the base type and none of the methods, so the decode
	       cannot re-enter this one. */}}
	type Alias {{.Name}}
	return json.Unmarshal(data, (*Alias)({{$recv}}))
}
{{- end}}

// Validate checks {{.Name}} against its JSON Schema constraints.
func ({{$recv}} {{.Name}}) Validate() error {
	{{- if .IsNumberBase}}
	{{- /* Compared as numbers rather than as the strings they are held as: the
	       member spelled 1.5 is the same number as a document's 1.50 or 15e-1,
	       and an equality on the literal would admit only the first. */}}
	switch {
	{{- range .Values}}
	case jsonNumberCmp(json.Number({{$recv}}), {{numberEnumValue .Value}}) == 0:
		return nil
	{{- end}}
	}
	return fmt.Errorf("invalid {{.Name}} value: %v", {{$recv}})
	{{- else}}
	switch {{$recv}} {
	case {{range $i, $v := .Values}}{{if $i}}, {{end}}{{$v.Name}}{{end}}:
		return nil
	default:
		return fmt.Errorf("invalid {{.Name}} value: %v", {{$recv}})
	}
	{{- end}}
}
{{- end}}

{{define "enum_raw"}}
{{- if .Description}}
// {{.Name}} - {{comment "" .Description}}
{{- end}}
{{- template "annotation_comment" mkAnnotationCtx .Annotations "" (ne .Description "")}}
type {{.Name}} json.RawMessage
{{- $recv := receiverName .Name}}
{{- $allowedVar := lowerFirst .Name | printf "%sAllowedJSON"}}

// The members as the schema wrote them, reduced at package initialisation to
// the one spelling every JSON value equal to each of them shares -- which is
// the same reduction Validate puts the instance through. See _jsonCanonical.
var {{$allowedVar}} = _jsonCanonicalTexts([]string{
{{- range .Values}}
	{{goStringQuote .RawJSON}},
{{- end}}
})

func ({{$recv}} *{{.Name}}) UnmarshalJSON(data []byte) error {
	*{{$recv}} = {{.Name}}(data)
	return nil
}

func ({{$recv}} {{.Name}}) MarshalJSON() ([]byte, error) {
	if len({{$recv}}) == 0 {
		return []byte("null"), nil
	}
	return json.RawMessage({{$recv}}).MarshalJSON()
}

// Validate checks {{.Name}} against its JSON Schema constraints.
func ({{$recv}} {{.Name}}) Validate() error {
	{{- /* _canon, not `s`: the receiver is the type name's first letter
	lowercased, so every raw enum whose type name begins with S or s declared
	this local over its own receiver -- `no new variables on left side of :=`,
	and then a comparison between the named type and a string. The underscore
	prefix is the convention the rest of the generated code uses for exactly
	this, and a receiver is one letter and can never carry it. */}}
	// Reduced to one spelling per JSON value, which is what the member list was
	// reduced to as well: whitespace, member order and number spelling are not
	// what an enum is decided on.
	_canon, _canonErr := _jsonCanonical([]byte({{$recv}}))
	if _canonErr != nil {
		return fmt.Errorf("invalid {{.Name}} value: %s", string({{$recv}}))
	}
	for _, allowed := range {{$allowedVar}} {
		if _canon == allowed {
			return nil
		}
	}
	return fmt.Errorf("invalid {{.Name}} value: %s", _canon)
}
{{- end}}