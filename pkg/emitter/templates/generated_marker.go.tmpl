{{/*
generated_marker declares SchemagenGenerated on a type that has an UnmarshalJSON
of its own. The runtime module tells the types schemagen generated from every
other decoder by the method, not by the package they are declared in -- the
generated types of any number of packages share the one runtime -- and calls
their UnmarshalJSON on bytes it has already checked, where encoding/json is
handed the bytes of any other type and checks them again. Emitted wherever an
UnmarshalJSON is, and nowhere else.
*/}}
{{define "generated_marker"}}
{{- $recv := receiverName .Name}}

// SchemagenGenerated marks {{.Name}} as generated by schemagen, so that its
// UnmarshalJSON is handed bytes the runtime has already checked.
func ({{$recv}} *{{.Name}}) SchemagenGenerated() {}
{{- end}}
