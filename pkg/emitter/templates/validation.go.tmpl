					{{- else}}
					_branchMatches = false
					{{- end}}
				}
			}
{{- end}}
{{- end}}

{{define "least_key_close"}}
		}(); _err != nil {
			_least, _failed = {{.Key}}, _err
		}
	}
	if _failed != nil {
		return {{.Ret}}
	}
}
{{- end}}
