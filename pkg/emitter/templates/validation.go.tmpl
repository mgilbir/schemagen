{{define "validate"}}
{{- $struct := . -}}
{{- $recv := receiverName .Name -}}

// Validate checks {{$struct.Name}} against its JSON Schema constraints.
func ({{$recv}} {{$struct.Name}}) Validate() error {
	{{- if $struct.AcceptNonObject}}
	// Non-object data was silently accepted — validate non-object constraints if any.
	if {{$recv}}._nonObject {
		{{- if gt (len $struct.NonObjectValidations) 0}}
		v := {{$recv}}._rawNonObject
		_ = v
		{{- range $struct.NonObjectValidations}}
		{{- if or (eq .RuleType "ppMinimum") (eq .RuleType "ppMaximum") (eq .RuleType "ppExclusiveMinimum") (eq .RuleType "ppExclusiveMaximum") (eq .RuleType "ppMultipleOf")}}
		{
			var num float64
			if err := json.Unmarshal(v, &num); err == nil {
				{{- if eq .RuleType "ppMinimum"}}
				if num < {{.Value}} {
					return fmt.Errorf("value %v is less than minimum {{.Value}}", num)
				}
				{{- end}}
				{{- if eq .RuleType "ppMaximum"}}
				if num > {{.Value}} {
					return fmt.Errorf("value %v exceeds maximum {{.Value}}", num)
				}
				{{- end}}
				{{- if eq .RuleType "ppExclusiveMinimum"}}
				if num <= {{.Value}} {
					return fmt.Errorf("value %v must be greater than {{.Value}}", num)
				}
				{{- end}}
				{{- if eq .RuleType "ppExclusiveMaximum"}}
				if num >= {{.Value}} {
					return fmt.Errorf("value %v must be less than {{.Value}}", num)
				}
				{{- end}}
				{{- if eq .RuleType "ppMultipleOf"}}
				q := num / {{.Value}}
				if math.Abs(q - math.Round(q)) > 1e-9 {
					return fmt.Errorf("value %v is not a multiple of {{.Value}}", num)
				}
				{{- end}}
			}
		}
		{{- end}}
		{{- if or (eq .RuleType "ppMinLength") (eq .RuleType "ppMaxLength")}}
		{
			var s string
			if err := json.Unmarshal(v, &s); err == nil {
				{{- if eq .RuleType "ppMinLength"}}
				if utf8.RuneCountInString(s) < {{.Value}} {
					return fmt.Errorf("string length is less than minLength {{.Value}}")
				}
				{{- end}}
				{{- if eq .RuleType "ppMaxLength"}}
				if utf8.RuneCountInString(s) > {{.Value}} {
					return fmt.Errorf("string length exceeds maxLength {{.Value}}")
				}
				{{- end}}
			}
		}
		{{- end}}
		{{- if eq .RuleType "ppPattern"}}
		{
			var s string
			if err := json.Unmarshal(v, &s); err == nil {
				if matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, s); !matched {
					return fmt.Errorf("value does not match pattern {{.Value}}")
				}
			}
		}
		{{- end}}
		{{- if or (eq .RuleType "ppMinItems") (eq .RuleType "ppMaxItems")}}
		{
			var arr []json.RawMessage
			if err := json.Unmarshal(v, &arr); err == nil {
				{{- if eq .RuleType "ppMinItems"}}
				if len(arr) < {{.Value}} {
					return fmt.Errorf("array length %d is less than minItems {{.Value}}", len(arr))
				}
				{{- end}}
				{{- if eq .RuleType "ppMaxItems"}}
				if len(arr) > {{.Value}} {
					return fmt.Errorf("array length %d exceeds maxItems {{.Value}}", len(arr))
				}
				{{- end}}
			}
		}
		{{- end}}
		{{- if eq .RuleType "ppType"}}
		{
			b := bytes.TrimSpace(v)
			var jt string
			if len(b) == 0 {
				jt = "unknown"
			} else {
				switch b[0] {
				case '"': jt = "string"
				case '{': jt = "object"
				case '[': jt = "array"
				case 't', 'f': jt = "boolean"
				case 'n': jt = "null"
				default:
					jt = "number"
					isInt := true
					for _, c := range b {
						if c == '.' || c == 'e' || c == 'E' {
							isInt = false
							break
						}
					}
					if isInt {
						jt = "integer"
					}
				}
			}
			{{- $wants := ppTypeValues .Value}}
			{{- if eq (len $wants) 1}}
			{{- $want := index $wants 0}}
			{{- if eq $want "integer"}}
			if jt != "integer" {
				return fmt.Errorf("value must be integer")
			}
			{{- else if eq $want "number"}}
			if jt != "integer" && jt != "number" {
				return fmt.Errorf("value must be number")
			}
			{{- else}}
			if jt != {{printf "%q" $want}} {
				return fmt.Errorf("value must be {{$want}}")
			}
			{{- end}}
			{{- else}}
			_ppTypeOK := false
			{{- range $wants}}
			{{- if eq . "integer"}}
			if jt == "integer" { _ppTypeOK = true }
			{{- else if eq . "number"}}
			if jt == "integer" || jt == "number" { _ppTypeOK = true }
			{{- else}}
			if jt == {{printf "%q" .}} { _ppTypeOK = true }
			{{- end}}
			{{- end}}
			if !_ppTypeOK {
				return fmt.Errorf("value must be one of: {{ppTypeValuesMsg .Value}}")
			}
			{{- end}}
		}
		{{- end}}
		{{- end}}
		{{- end}}
		return nil
	}
	{{- end}}
	{{- if $struct.HasRequiredFields}}
	// Required properties must be present in the source JSON. _jsonKeys is
	// populated by UnmarshalJSON; when nil (the value was not built from JSON)
	// presence is untracked and the check is skipped, consistent with how
	// optional-property validation below treats _jsonKeys.
	if {{$recv}}._jsonKeys != nil {
		for _, _req := range []string{ {{- range $i, $r := $struct.RequiredJSON}}{{if $i}}, {{end}}{{printf "%q" $r}}{{- end -}} } {
			if !{{$recv}}._jsonKeys[_req] {
				return fmt.Errorf("%s: required property is missing", _req)
			}
		}
	}
	{{- end}}
	{{- range $struct.Validations}}
	{{- if .Optional}}
	if {{$recv}}._jsonKeys[{{printf "%q" .JSONName}}] {
	{{- end}}
	{{- $value := validationValue $recv .}}
	{{- if eq .RuleType "minLength"}}
	{{- if .IsPointer}}
	if {{validationNonNil $recv .}} && utf8.RuneCountInString({{$value}}) < {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: length %d is less than minimum {{.Value}}", utf8.RuneCountInString({{$value}}))
	}
	{{- else}}
	if utf8.RuneCountInString({{$value}}) < {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: length %d is less than minimum {{.Value}}", utf8.RuneCountInString({{$value}}))
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "maxLength"}}
	{{- if .IsPointer}}
	if {{validationNonNil $recv .}} && utf8.RuneCountInString({{$value}}) > {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: length %d exceeds maximum {{.Value}}", utf8.RuneCountInString({{$value}}))
	}
	{{- else}}
	if utf8.RuneCountInString({{$value}}) > {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: length %d exceeds maximum {{.Value}}", utf8.RuneCountInString({{$value}}))
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "minimum"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && float64(*{{$recv}}.{{.FieldName}}) < {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v is less than minimum {{.Value}}", *{{$recv}}.{{.FieldName}})
	}
	{{- else}}
	if float64({{$recv}}.{{.FieldName}}) < {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v is less than minimum {{.Value}}", {{$recv}}.{{.FieldName}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "maximum"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && float64(*{{$recv}}.{{.FieldName}}) > {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v exceeds maximum {{.Value}}", *{{$recv}}.{{.FieldName}})
	}
	{{- else}}
	if float64({{$recv}}.{{.FieldName}}) > {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v exceeds maximum {{.Value}}", {{$recv}}.{{.FieldName}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "exclusiveMinimum"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && float64(*{{$recv}}.{{.FieldName}}) <= {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v must be greater than {{.Value}}", *{{$recv}}.{{.FieldName}})
	}
	{{- else}}
	if float64({{$recv}}.{{.FieldName}}) <= {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v must be greater than {{.Value}}", {{$recv}}.{{.FieldName}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "exclusiveMaximum"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && float64(*{{$recv}}.{{.FieldName}}) >= {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v must be less than {{.Value}}", *{{$recv}}.{{.FieldName}})
	}
	{{- else}}
	if float64({{$recv}}.{{.FieldName}}) >= {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v must be less than {{.Value}}", {{$recv}}.{{.FieldName}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "multipleOf"}}
	{
		{{- if .IsPointer}}
		if {{$recv}}.{{.FieldName}} != nil {
		q := float64(*{{$recv}}.{{.FieldName}}) / {{.Value}}
		if math.Abs(q - math.Round(q)) > 1e-9 {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v is not a multiple of {{.Value}}", *{{$recv}}.{{.FieldName}})
		}
		}
		{{- else}}
		q := float64({{$recv}}.{{.FieldName}}) / {{.Value}}
		if math.Abs(q - math.Round(q)) > 1e-9 {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v is not a multiple of {{.Value}}", {{$recv}}.{{.FieldName}})
		}
		{{- end}}
	}
	{{- end}}
	{{- if eq .RuleType "pattern"}}
	{{- if .IsPointer}}
	if {{validationNonNil $recv .}} {
		if matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, {{$value}}); !matched {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q does not match pattern %s", {{$value}}, {{printf "%q" .Value}})
		}
	}
	{{- else}}
	if matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, {{$value}}); !matched {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q does not match pattern %s", {{$value}}, {{printf "%q" .Value}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "minItems"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && len(*{{$recv}}.{{.FieldName}}) < {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: has %d items, minimum is {{.Value}}", len(*{{$recv}}.{{.FieldName}}))
	}
	{{- else}}
	if len({{$recv}}.{{.FieldName}}) < {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: has %d items, minimum is {{.Value}}", len({{$recv}}.{{.FieldName}}))
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "maxItems"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && len(*{{$recv}}.{{.FieldName}}) > {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: has %d items, maximum is {{.Value}}", len(*{{$recv}}.{{.FieldName}}))
	}
	{{- else}}
	if len({{$recv}}.{{.FieldName}}) > {{.Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: has %d items, maximum is {{.Value}}", len({{$recv}}.{{.FieldName}}))
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "uniqueItems"}}
	{
		{{- if .IsPointer}}
		arr := *{{$recv}}.{{.FieldName}}
		{{- else}}
		arr := {{$recv}}.{{.FieldName}}
		{{- end}}
		seen := make(map[string]bool, len(arr))
		for i, item := range arr {
			b, err := json.Marshal(item)
			if err != nil {
				return fmt.Errorf("{{jsonErrorName .JSONName}}: uniqueItems check: marshal error at index %d: %w", i, err)
			}
			key := string(b)
			if seen[key] {
				return fmt.Errorf("{{jsonErrorName .JSONName}}: items are not unique (duplicate at index %d)", i)
			}
			seen[key] = true
		}
	}
	{{- end}}
	{{- if eq .RuleType "forbidden"}}
	if {{$recv}}.{{.FieldName}} != nil {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: property is forbidden (not: {})")
	}
	{{- end}}
	{{- if eq .RuleType "const"}}
	{
		_constGot, _constErr := json.Marshal({{$recv}}.{{.FieldName}})
		if _constErr != nil {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: failed to marshal for const check: %w", _constErr)
		}
		if string(_constGot) != {{printf "%q" .Value}} {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value must be %s, got %s", {{printf "%q" .Value}}, string(_constGot))
		}
	}
	{{- end}}
	{{- if eq .RuleType "maxProperties"}}
	{
		// Count properties actually present in the source JSON. _jsonKeys is
		// populated by UnmarshalJSON; when nil (value not built from JSON) fall
		// back to the overflow map count.
		totalProps := len({{$recv}}.AdditionalProperties)
		if {{$recv}}._jsonKeys != nil {
			totalProps = len({{$recv}}._jsonKeys)
		}
		if totalProps > {{.Value}} {
			return fmt.Errorf("too many properties: %d exceeds maximum {{.Value}}", totalProps)
		}
	}
	{{- end}}
	{{- if eq .RuleType "minProperties"}}
	{
		totalProps := len({{$recv}}.AdditionalProperties)
		if {{$recv}}._jsonKeys != nil {
			totalProps = len({{$recv}}._jsonKeys)
		}
		if totalProps < {{.Value}} {
			return fmt.Errorf("too few properties: %d is less than minimum {{.Value}}", totalProps)
		}
	}
	{{- end}}
	{{- if eq .RuleType "format"}}
	{{- if eq .Value "date"}}
	if {{validationStringSet $recv .}} {
		if _, _err := time.Parse("2006-01-02", {{$value}}); _err != nil {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid date (YYYY-MM-DD): %w", {{$value}}, _err)
		}
	}
	{{- end}}
	{{- if eq .Value "time"}}
	if {{validationStringSet $recv .}} {
		_valid := false
		for _, _layout := range []string{"15:04:05Z07:00", "15:04:05"} {
			if _, _err := time.Parse(_layout, {{$value}}); _err == nil {
				_valid = true
				break
			}
		}
		if !_valid {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid time (HH:MM:SS or with offset)", {{$value}})
		}
	}
	{{- end}}
	{{- if eq .Value "email"}}
	if {{validationStringSet $recv .}} {
		if _, err := mail.ParseAddress({{$value}}); err != nil {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid email address: %w", {{$value}}, err)
		}
	}
	{{- end}}
	{{- if eq .Value "idn-email"}}
	if {{validationStringSet $recv .}} {
		if _, err := mail.ParseAddress({{$value}}); err != nil {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid email address: %w", {{$value}}, err)
		}
	}
	{{- end}}
	{{- if eq .Value "uri"}}
	if {{validationStringSet $recv .}} {
		if _u, _err := url.Parse({{$value}}); _err != nil || _u.Scheme == "" {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid URI", {{$value}})
		}
	}
	{{- end}}
	{{- if or (eq .Value "uri-reference") (eq .Value "iri-reference") (eq .Value "uri-template")}}
	if {{validationStringSet $recv .}} {
		if _, _err := url.Parse({{$value}}); _err != nil {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid URI reference", {{$value}})
		}
	}
	{{- end}}
	{{- if eq .Value "iri"}}
	if {{validationStringSet $recv .}} {
		if _u, _err := url.Parse({{$value}}); _err != nil || _u.Scheme == "" {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid IRI", {{$value}})
		}
	}
	{{- end}}
	{{- if eq .Value "uuid"}}
	if {{validationStringSet $recv .}} {
		if !regexp.MustCompile(`^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$`).MatchString({{$value}}) {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid UUID", {{$value}})
		}
	}
	{{- end}}
	{{- if eq .Value "hostname"}}
	if {{validationStringSet $recv .}} {
		if !regexp.MustCompile(`^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)*$`).MatchString({{$value}}) {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid hostname", {{$value}})
		}
	}
	{{- end}}
	{{- if eq .Value "idn-hostname"}}
	if {{validationStringSet $recv .}} {
		if !regexp.MustCompile(`^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)*$`).MatchString({{$value}}) {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid hostname", {{$value}})
		}
	}
	{{- end}}
	{{- if eq .Value "json-pointer"}}
	if {{validationStringSet $recv .}} {
		if !regexp.MustCompile(`^(/([^~/]|~0|~1)*)*$`).MatchString({{$value}}) {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid JSON Pointer", {{$value}})
		}
	}
	{{- end}}
	{{- if eq .Value "relative-json-pointer"}}
	if {{validationStringSet $recv .}} {
		if !regexp.MustCompile(`^(0|[1-9][0-9]*)(#|(/([^~/]|~0|~1)*)*)$`).MatchString({{$value}}) {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid relative JSON Pointer", {{$value}})
		}
	}
	{{- end}}
	{{- if eq .Value "regex"}}
	if {{validationStringSet $recv .}} {
		if _, _err := regexp.Compile({{$value}}); _err != nil {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid regex: %w", {{$value}}, _err)
		}
	}
	{{- end}}
	{{- if eq .Value "duration"}}
	if {{validationStringSet $recv .}} {
		if !regexp.MustCompile(`^P(\d+Y)?(\d+M)?(\d+W)?(\d+D)?(T(\d+H)?(\d+M)?(\d+(\.\d+)?S)?)?$`).MatchString({{$value}}) {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid ISO 8601 duration", {{$value}})
		}
	}
	{{- end}}
	{{- if eq .Value "ipv4"}}
	if {{$recv}}.{{.FieldName}}.IsValid() && !{{$recv}}.{{.FieldName}}.Is4() {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid IPv4 address", {{$recv}}.{{.FieldName}})
	}
	{{- end}}
	{{- if eq .Value "ipv6"}}
	if {{$recv}}.{{.FieldName}}.IsValid() && !{{$recv}}.{{.FieldName}}.Is6() {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %q is not a valid IPv6 address", {{$recv}}.{{.FieldName}})
	}
	{{- end}}
	{{- end}}
	{{- if .Optional}}
	}
	{{- end}}
	{{- end}}
	{{- if and $struct.AdditionalProperties $struct.AdditionalProperties.Forbidden}}
	if len({{$recv}}.AdditionalProperties) > 0 {
		for k := range {{$recv}}.AdditionalProperties {
			return fmt.Errorf("additional property %q is not allowed", k)
		}
	}
	{{- end}}
	{{- range $oi, $oneOf := $struct.ObjectOneOfs}}
	// object-level oneOf: exactly one flattened variant must match.
	// This check depends on JSON key presence (_jsonKeys), so it is skipped
	// for hand-constructed values (nil _jsonKeys), consistent with how the
	// required-property check above treats untracked presence.
	if {{$recv}}._jsonKeys != nil {
		_oneOfMatches := 0
		{{- range $bi, $branch := $oneOf.Branches}}
		{
			_branchMatches := true
			{{- range $branch.RequiredKeys}}
			if !{{$recv}}._jsonKeys[{{printf "%q" .}}] {
				_branchMatches = false
			}
			{{- end}}
			{{- range $branch.Checks}}
			if _branchMatches {
				if _raw, _ok := {{$recv}}._jsonRawProps[{{printf "%q" .JSONName}}]; _ok {
					{{- if .JSONType}}
					_jt := "unknown"
					_b := bytes.TrimSpace(_raw)
					if len(_b) > 0 {
						switch _b[0] {
						case '"': _jt = "string"
						case '{': _jt = "object"
						case '[': _jt = "array"
						case 't', 'f': _jt = "boolean"
						case 'n': _jt = "null"
						default:
							_jt = "number"
							_isInt := true
							for _, _c := range _b {
								if _c == '.' || _c == 'e' || _c == 'E' {
									_isInt = false
									break
								}
							}
							if _isInt {
								_jt = "integer"
							}
						}
					}
					{{- if eq .JSONType "number"}}
					if _jt != "number" && _jt != "integer" {
						_branchMatches = false
					}
					{{- else}}
					if _jt != {{printf "%q" .JSONType}} {
						_branchMatches = false
					}
					{{- end}}
					{{- end}}
					{{- if .AllowedValues}}
					if _branchMatches {
						_valueMatches := false
						switch string(bytes.TrimSpace(_raw)) {
						{{- range .AllowedValues}}
						case {{printf "%q" .}}:
							_valueMatches = true
						{{- end}}
						}
						if !_valueMatches {
							_branchMatches = false
						}
					}
					{{- end}}
				}
			}
			{{- end}}
			if _branchMatches {
				_oneOfMatches++
			}
		}
		{{- end}}
		if _oneOfMatches != 1 {
			return fmt.Errorf("oneOf: matched %d variants, expected exactly 1", _oneOfMatches)
		}
	}
	{{- end}}
	{{- range $ai, $anyOf := $struct.ObjectAnyOfs}}
	// object-level anyOf: at least one flattened variant must match.
	// This check depends on JSON key presence (_jsonKeys), so it is skipped
	// for hand-constructed values (nil _jsonKeys), consistent with how the
	// required-property check above treats untracked presence.
	if {{$recv}}._jsonKeys != nil {
		_anyOfMatches := 0
		{{- range $bi, $branch := $anyOf.Branches}}
		{
			_branchMatches := true
			{{- range $branch.RequiredKeys}}
