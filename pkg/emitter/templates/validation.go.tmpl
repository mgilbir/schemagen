{{define "validate"}}
{{- $struct := . -}}
{{- $recv := receiverName .Name -}}

// Validate checks {{$struct.Name}} against its JSON Schema constraints.
{{- if $struct.ValidateIn}}
func ({{$recv}} {{$struct.Name}}) Validate() error { return {{$recv}}.validateIn(nil) }

// validateIn is Validate, sharing _vc with the values below it: the element
// identities a uniqueItems check keeps. See rt.Validation.
func ({{$recv}} {{$struct.Name}}) validateIn(_vc *rt.Validation) error {
{{- else}}
func ({{$recv}} {{$struct.Name}}) Validate() error {
{{- end}}
	{{- if $struct.AcceptNonObject}}
	// Non-object data was silently accepted — validate non-object constraints if any.
	if {{$recv}}._nonObject {
		{{- if gt (len $struct.NonObjectValidations) 0}}
		_nonObj := {{$recv}}._rawNonObject
		_ = _nonObj
		{{- range $struct.NonObjectValidations}}
		{{- if or (eq .RuleType "ppMinimum") (eq .RuleType "ppMaximum") (eq .RuleType "ppExclusiveMinimum") (eq .RuleType "ppExclusiveMaximum") (eq .RuleType "ppMultipleOf")}}
		{
			// Read as the literal the document wrote, and only when it is a
			// number: a numeric keyword does not apply to anything else, and a
			// null in particular is not a zero (issue #270). The literal is
			// what the keyword is about -- a float64 would round 9007199254740993
			// onto its neighbour, and refuse 1e400 outright.
			if _lit, _isNum := rt.RawNumber(_nonObj); _isNum {
				{{- if eq .RuleType "ppMinimum"}}
				if {{numViolated . "json.Number(_lit)"}} {
					return rt.ValueErrorf("value %s is less than minimum {{fmtText .Value}}", _lit)
				}
				{{- end}}
				{{- if eq .RuleType "ppMaximum"}}
				if {{numViolated . "json.Number(_lit)"}} {
					return rt.ValueErrorf("value %s exceeds maximum {{fmtText .Value}}", _lit)
				}
				{{- end}}
				{{- if eq .RuleType "ppExclusiveMinimum"}}
				if {{numViolated . "json.Number(_lit)"}} {
					return rt.ValueErrorf("value %s must be greater than {{fmtText .Value}}", _lit)
				}
				{{- end}}
				{{- if eq .RuleType "ppExclusiveMaximum"}}
				if {{numViolated . "json.Number(_lit)"}} {
					return rt.ValueErrorf("value %s must be less than {{fmtText .Value}}", _lit)
				}
				{{- end}}
				{{- if eq .RuleType "ppMultipleOf"}}
				if {{numViolated . "json.Number(_lit)"}} {
					return rt.ValueErrorf("value %s is not a multiple of {{fmtText .Value}}", _lit)
				}
				{{- end}}
			}
		}
		{{- end}}
		{{- if or (eq .RuleType "ppMinLength") (eq .RuleType "ppMaxLength")}}
		{
			// Through a pointer, so that a null is not measured as the empty
			// string. See the numeric block above.
			var _s *string
			if err := json.Unmarshal(_nonObj, &_s); err == nil && _s != nil {
				_str := *_s
				{{- if eq .RuleType "ppMinLength"}}
				if utf8.RuneCountInString(_str) < {{countExpr .Value}} {
					return rt.ValueErrorf("string length is less than minLength {{fmtText .Value}}")
				}
				{{- end}}
				{{- if eq .RuleType "ppMaxLength"}}
				if utf8.RuneCountInString(_str) > {{countExpr .Value}} {
					return rt.ValueErrorf("string length exceeds maxLength {{fmtText .Value}}")
				}
				{{- end}}
			}
		}
		{{- end}}
		{{- if eq .RuleType "ppPattern"}}
		{
			// Through a pointer, so that a null is not matched as the empty
			// string. See the numeric block above.
			var _s *string
			if err := json.Unmarshal(_nonObj, &_s); err == nil && _s != nil {
				_str := *_s
				_matched, _err := {{patternVar .Value}}.Matches(_str)
				if _err != nil {
					return rt.ValueErrorf("%w", _err)
				}
				if !_matched {
					return rt.ValueErrorf("value does not match pattern {{fmtText .Value}}")
				}
			}
		}
		{{- end}}
		{{- if or (eq .RuleType "ppMinItems") (eq .RuleType "ppMaxItems")}}
		{
			// Through a pointer, so that a null is not measured as the empty
			// array. See the numeric block above.
			var _arr *[]json.RawMessage
			if err := json.Unmarshal(_nonObj, &_arr); err == nil && _arr != nil {
				arr := *_arr
				{{- if eq .RuleType "ppMinItems"}}
				if len(arr) < {{countExpr .Value}} {
					return rt.ValueErrorf("array length %d is less than minItems {{fmtText .Value}}", len(arr))
				}
				{{- end}}
				{{- if eq .RuleType "ppMaxItems"}}
				if len(arr) > {{countExpr .Value}} {
					return rt.ValueErrorf("array length %d exceeds maxItems {{fmtText .Value}}", len(arr))
				}
				{{- end}}
			}
		}
		{{- end}}
		{{- if eq .RuleType "ppType"}}
		{
			{{- /* The JSON type the raw value is, with "integer" read the way the
			       schema's draft reads it: off the token under draft 3 and 4, off
			       the value -- so 1.0 is one -- from draft 6 on. This scanned the
			       token under every draft. See rt.RawKind. */}}
			jt := rt.RawKind(_nonObj, {{if .StrictInteger}}true{{else}}false{{end}})
			{{- $wants := ppTypeValues .Value}}
			{{- if eq (len $wants) 1}}
			{{- $want := index $wants 0}}
			{{- if eq $want "integer"}}
			if jt != "integer" {
				return rt.ValueErrorf("value must be integer")
			}
			{{- else if eq $want "number"}}
			if jt != "integer" && jt != "number" {
				return rt.ValueErrorf("value must be number")
			}
			{{- else}}
			if jt != {{printf "%q" $want}} {
				return rt.ValueErrorf("value must be {{fmtText $want}}")
			}
			{{- end}}
			{{- else}}
			_ppTypeOK := false
			{{- range $wants}}
			{{- if eq . "integer"}}
			if jt == "integer" { _ppTypeOK = true }
			{{- else if eq . "number"}}
			if jt == "integer" || jt == "number" { _ppTypeOK = true }
			{{- else}}
			if jt == {{printf "%q" .}} { _ppTypeOK = true }
			{{- end}}
			{{- end}}
			if !_ppTypeOK {
				return rt.ValueErrorf("value must be one of: {{ppTypeValuesMsg .Value}}")
			}
			{{- end}}
		}
		{{- end}}
		{{- end}}
		{{- end}}
		return nil
	}
	{{- end}}
	{{- if $struct.HasRequiredFields}}
	// Required properties must be present in the source JSON. _jsonKeys is
	// populated by UnmarshalJSON; when nil (the value was not built from JSON)
	// presence is untracked and the check is skipped, consistent with how
	// optional-property validation below treats _jsonKeys.
	if {{$recv}}._jsonKeys != nil {
		{{- /* maporder: not a map: ranges a slice literal. */}}
		for _, _req := range []string{ {{- range $i, $r := $struct.RequiredJSON}}{{if $i}}, {{end}}{{printf "%q" $r}}{{- end -}} } {
			if !{{$recv}}._jsonKeys[_req] {
				return fmt.Errorf("%s: required property is missing", _req)
			}
		}
	}
	{{- end}}
	{{- range $struct.Validations}}
	{{- if or .Optional .NullKey}}
	{{- /* A present null satisfies this keyword whatever its argument, and the
	       decoded value no longer says the null was there -- it left the same
	       zero an absent property does. _jsonNulls records it. See issue #110. */}}
	if {{if .Optional}}{{$recv}}._jsonKeys[{{printf "%q" .JSONName}}]{{end}}{{if and .Optional .NullKey}} && {{end}}{{if .NullKey}}!{{$recv}}._jsonNulls[{{printf "%q" .NullKey}}]{{end}} {
	{{- end}}
	{{- $value := validationValue $recv .}}
	{{- if eq .RuleType "minLength"}}
	{{- if .IsPointer}}
	if {{validationNonNil $recv .}} && utf8.RuneCountInString({{$value}}) < {{countExpr .Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: length %d is less than minimum {{fmtText .Value}}", utf8.RuneCountInString({{$value}}))
	}
	{{- else}}
	if utf8.RuneCountInString({{$value}}) < {{countExpr .Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: length %d is less than minimum {{fmtText .Value}}", utf8.RuneCountInString({{$value}}))
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "maxLength"}}
	{{- if .IsPointer}}
	if {{validationNonNil $recv .}} && utf8.RuneCountInString({{$value}}) > {{countExpr .Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: length %d exceeds maximum {{fmtText .Value}}", utf8.RuneCountInString({{$value}}))
	}
	{{- else}}
	if utf8.RuneCountInString({{$value}}) > {{countExpr .Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: length %d exceeds maximum {{fmtText .Value}}", utf8.RuneCountInString({{$value}}))
	}
	{{- end}}
	{{- end}}
	{{- /* The numeric keywords. numViolated writes the condition under which the
	       rule is broken, for the Go type the field holds its number as, and
	       every form it writes is exact -- see numViolatedFunc. */}}
	{{- if eq .RuleType "minimum"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && {{numViolated . (printf "*%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v is less than minimum {{numBoundMsg .}}", *{{$recv}}.{{.FieldName}})
	}
	{{- else}}
	if {{numViolated . (printf "%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v is less than minimum {{numBoundMsg .}}", {{$recv}}.{{.FieldName}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "maximum"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && {{numViolated . (printf "*%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v exceeds maximum {{numBoundMsg .}}", *{{$recv}}.{{.FieldName}})
	}
	{{- else}}
	if {{numViolated . (printf "%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v exceeds maximum {{numBoundMsg .}}", {{$recv}}.{{.FieldName}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "exclusiveMinimum"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && {{numViolated . (printf "*%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v must be greater than {{numBoundMsg .}}", *{{$recv}}.{{.FieldName}})
	}
	{{- else}}
	if {{numViolated . (printf "%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v must be greater than {{numBoundMsg .}}", {{$recv}}.{{.FieldName}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "exclusiveMaximum"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && {{numViolated . (printf "*%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v must be less than {{numBoundMsg .}}", *{{$recv}}.{{.FieldName}})
	}
	{{- else}}
	if {{numViolated . (printf "%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v must be less than {{numBoundMsg .}}", {{$recv}}.{{.FieldName}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "multipleOf"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && {{numViolated . (printf "*%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v is not a multiple of {{numBoundMsg .}}", *{{$recv}}.{{.FieldName}})
	}
	{{- else}}
	if {{numViolated . (printf "%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %v is not a multiple of {{numBoundMsg .}}", {{$recv}}.{{.FieldName}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "pattern"}}
	{{- if .IsPointer}}
	if {{validationNonNil $recv .}} {
		if _matched, _err := {{patternVar .Value}}.Matches({{$value}}); _err != nil {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: %w", _err)
		} else if !_matched {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value %s does not match pattern %s", rt.Quote({{$value}}), {{printf "%q" .Value}})
		}
	}
	{{- else}}
	if _matched, _err := {{patternVar .Value}}.Matches({{$value}}); _err != nil {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: %w", _err)
	} else if !_matched {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value %s does not match pattern %s", rt.Quote({{$value}}), {{printf "%q" .Value}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "minItems"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && len(*{{$recv}}.{{.FieldName}}) < {{countExpr .Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: has %d items, minimum is {{fmtText .Value}}", len(*{{$recv}}.{{.FieldName}}))
	}
	{{- else}}
	if len({{$recv}}.{{.FieldName}}) < {{countExpr .Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: has %d items, minimum is {{fmtText .Value}}", len({{$recv}}.{{.FieldName}}))
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "maxItems"}}
	{{- if .IsPointer}}
	if {{$recv}}.{{.FieldName}} != nil && len(*{{$recv}}.{{.FieldName}}) > {{countExpr .Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: has %d items, maximum is {{fmtText .Value}}", len(*{{$recv}}.{{.FieldName}}))
	}
	{{- else}}
	if len({{$recv}}.{{.FieldName}}) > {{countExpr .Value}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: has %d items, maximum is {{fmtText .Value}}", len({{$recv}}.{{.FieldName}}))
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "uniqueItems"}}
	{
		{{- if .IsPointer}}
		arr := *{{$recv}}.{{.FieldName}}
		{{- else}}
		arr := {{$recv}}.{{.FieldName}}
		{{- end}}
		{{- /* Compared by identity, read off each element as it is held: equal
		       as JSON -- 1 and 1.0, members in any order -- is one identity. The
		       elements were marshalled and compared as text, which at every
		       level of a document wrote out every subtree below it. See rt.ID. */}}
		{{- if .KeepIDs}}
		if _vc == nil {
			_vc = &rt.Validation{}
		}
		{{- end}}
		_ids, _at, _err := rt.IDsOf(arr, {{if .KeepIDs}}_vc{{else}}nil{{end}}, {{.Identifier}})
		if _err != nil {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: uniqueItems check: marshal error at index %d: %w", _at, rt.MarshalError(&arr[_at], _err))
		}
		if _at := rt.FirstDuplicate(arr, _ids, {{.Identifier}}); _at >= 0 {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: items are not unique (duplicate at index %d)", _at)
		}
	}
	{{- end}}
	{{- if eq .RuleType "forbidden"}}
	{{- /* The key's presence is the violation, so the document's own keys are
	       what decide it: an explicit null decodes to exactly what an absent
	       property leaves, and the nil test alone passed over it. _jsonKeys is
	       nil for a value not built from JSON, where indexing it is false and
	       the nil test is all there is -- the same reading the required-property
	       check gives untracked presence.

	       An optional rule is inside the guard that opens this block, and that
	       guard is `_jsonKeys[name]` -- the very question, already asked. So
	       there is nothing left to test and the refusal is unconditional. (The
	       guard's other half, _jsonNulls, never appears on this rule: a `false`
	       schema forbids a null as much as anything else, and ruleVacuousForNull
	       does not name it.)

	       Where there is no guard -- a required property, or a `false` schema,
	       which is read before the optional marking -- the two sources are asked
	       together, and neither is assumed. The nil test needs a field with a
	       nil state, which under the default configuration every optional
	       property has and under --omit-empty=false a scalar one does not:
	       emitting it there was not a weaker check but a package that did not
	       build, since nothing may be compared to nil but a pointer, a slice, a
	       map or an interface. See ValidationRule.FieldNilable. A value built in
	       Go rather than decoded then has no evidence to offer about a scalar
	       property -- the same blind spot an optional scalar's default and its
	       required check already have, and for the same reason: its zero is what
	       both a written "" and an absent property leave behind. */}}
	{{- if .Optional}}
	return fmt.Errorf("{{jsonErrorName .JSONName}}: property is forbidden (no value satisfies its schema)")
	{{- else if or .FieldNilable .PresenceTracked}}
	if {{if .FieldNilable}}{{$recv}}.{{.FieldName}} != nil{{if .PresenceTracked}} || {{end}}{{end}}{{if .PresenceTracked}}{{$recv}}._jsonKeys[{{printf "%q" .JSONName}}]{{end}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: property is forbidden (no value satisfies its schema)")
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "const"}}
	{{- if .ExactValue}}
	{{- /* A numeric const is compared as a number, by value: 1.0 and 1e0 are
	       the const 1 whatever the field holds them as. */}}
	{{- if .IsPointer}}
	{{- /* A nil pointer is a null the document wrote, or an absence the
	       required check has already answered for; neither is the const. */}}
	if {{$recv}}.{{.FieldName}} == nil {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value must be %s, got null", {{printf "%q" .Value}})
	}
	if {{numViolated . (printf "*%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value must be %s, got %s", {{printf "%q" .Value}}, rt.ClipText(fmt.Sprint(*{{$recv}}.{{.FieldName}})))
	}
	{{- else}}
	if {{numViolated . (printf "%s.%s" $recv .FieldName)}} {
		return fmt.Errorf("{{jsonErrorName .JSONName}}: value must be %s, got %s", {{printf "%q" .Value}}, rt.ClipText(fmt.Sprint({{$recv}}.{{.FieldName}})))
	}
	{{- end}}
	{{- else}}
	{{- /* Compared by identity (see rt.ID): equal as JSON is the const,
	       whatever the spelling. The value was marshalled and its text compared
	       with the const's, which is a comparison of spellings: an object whose
	       fields are declared in another order than the const writes its keys was
	       refused. */}}
	{
		{{- /* A copy, so that the receiver, whose field's address would otherwise
		       be taken, stays where it is. */}}
		_constV := {{$recv}}.{{.FieldName}}
		_constOK, _constErr := rt.MatchesConst(&_constV, {{.Identifier}}, rt.ConstOf(false, {{printf "%q" .Value}}))
		if _constErr != nil {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: failed to marshal for const check: %w", rt.MarshalError(&_constV, _constErr))
		}
		if !_constOK {
			return fmt.Errorf("{{jsonErrorName .JSONName}}: value must be %s, got %s", {{printf "%q" .Value}}, rt.ClipText(rt.MarshalText(&_constV)))
		}
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "maxProperties"}}
	{
		// Count properties actually present in the source JSON. _jsonKeys is
		// populated by UnmarshalJSON; when nil (value not built from JSON) fall
		// back to the overflow map count.
		totalProps := len({{$recv}}.AdditionalProperties)
		if {{$recv}}._jsonKeys != nil {
			totalProps = len({{$recv}}._jsonKeys)
		}
		if totalProps > {{countExpr .Value}} {
			return rt.ValueErrorf("too many properties: %d exceeds maximum {{fmtText .Value}}", totalProps)
		}
	}
	{{- end}}
	{{- if eq .RuleType "minProperties"}}
	{
		totalProps := len({{$recv}}.AdditionalProperties)
		if {{$recv}}._jsonKeys != nil {
			totalProps = len({{$recv}}._jsonKeys)
		}
		if totalProps < {{countExpr .Value}} {
			return rt.ValueErrorf("too few properties: %d is less than minimum {{fmtText .Value}}", totalProps)
		}
	}
	{{- end}}
	{{- if eq .RuleType "format"}}
	{{- /*
	One arm, dispatching to the shared helper for the format. The check used to
	be written out here, again in the alias template and again in the wrapper's,
	and the three drifted: an ipv4 check written for netip.Addr was emitted
	against a *string and did not compile, and a format behind a $ref asserted
	nothing while the same subschema inline was checked. See format_helpers.

	The netip.Addr and time.Time arms are gone with them. A field of one of those
	types was already refused at decode by anything the parser rejects, and
	formatRuleShape drops the rule there rather than emit a check that cannot
	fail -- so every rule reaching this line holds the JSON string itself.
	*/ -}}
	{{- if .IsPointer}}
	if {{validationNonNil $recv .}} {
	{{- template "string_format_check" (mkStringFormatCtx $value (jsonErrorName .JSONName) .Value .StringBacked)}}
	}
	{{- else}}
	{{- template "string_format_check" (mkStringFormatCtx $value (jsonErrorName .JSONName) .Value .StringBacked)}}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "content"}}
	{{- if .IsPointer}}
	if {{validationNonNil $recv .}} {
	{{- template "string_content_check" (mkStringContentCtx $value (jsonErrorName .JSONName) .)}}
	}
	{{- else}}
	{{- template "string_content_check" (mkStringContentCtx $value (jsonErrorName .JSONName) .)}}
	{{- end}}
	{{- end}}
	{{- if or .Optional .NullKey}}
	}
	{{- end}}
	{{- end}}
	{{- if and $struct.AdditionalProperties $struct.AdditionalProperties.Forbidden}}
	{{- /* Every map loop below that can refuse a member is opened with
	       least_key_open, so that a document with several bad members is
	       refused for the same one -- the least key -- on every run. A plain
	       range returning at the first refusal named whichever member Go's
	       randomised map order reached first. */}}
	{{- $lk := leastKey "_key" "_" (printf "%s.AdditionalProperties" $recv) "_failed"}}
	{{- template "least_key_open" $lk}}
		return rt.ValueErrorf("additional property %s is not allowed", rt.Quote(_key))
	{{- template "least_key_close" $lk}}
	{{- end}}
	{{- range $oi, $oneOf := $struct.ObjectOneOfs}}
	// object-level oneOf: exactly one flattened variant must match.
	// This check depends on JSON key presence (_jsonKeys), so it is skipped
	// for hand-constructed values (nil _jsonKeys), consistent with how the
	// required-property check above treats untracked presence.
	if {{$recv}}._jsonKeys != nil {
		_oneOfMatches := 0
		{{- range $bi, $branch := $oneOf.Branches}}
		{
			_branchMatches := true
			{{- range $branch.RequiredKeys}}
			if !{{$recv}}._jsonKeys[{{printf "%q" .}}] {
				_branchMatches = false
			}
			{{- end}}
			{{- template "object_branch_closed_keys" (mkClosedKeysCtx $recv $branch)}}
			{{- range $branch.Checks}}
			if _branchMatches {
				if _raw, _ok := {{$recv}}._jsonRawProps[{{printf "%q" .JSONName}}]; _ok {
					{{- if .JSONType}}
					{{- /* The member's JSON type, with "integer" read the way the
					       property's draft reads it -- off the value from draft 6
					       on, so {"k":1.0} matches an integer branch. This scanned
					       the token under every draft. */}}
					_jt := rt.RawKind(_raw, {{if .StrictInteger}}true{{else}}false{{end}})
					{{- if eq .JSONType "number"}}
					if _jt != "number" && _jt != "integer" {
						_branchMatches = false
					}
					{{- else}}
					if _jt != {{printf "%q" .JSONType}} {
						_branchMatches = false
					}
					{{- end}}
					{{- end}}
					{{- if .AllowedValues}}
					{{- /* Compared by identity (see rt.MatchesConstRaw), not by
					       the member's bytes: 1.0 is the member 1, and an object
					       is its members in any order. */}}
					if _branchMatches {
						_valueMatches, _valueErr := rt.MatchesConstRaw(_raw, rt.ConstOf(false,
							{{- range .AllowedValues}}
							{{printf "%q" .}},
							{{- end}}
						))
						if _valueErr != nil || !_valueMatches {
							_branchMatches = false
						}
					}
					{{- end}}
				}
			}
			{{- end}}
			if _branchMatches {
