			if !evaluated {
				{{- if $uneval.IsForbidden}}
				return jsonValueErrorf("unevaluated property %s is not allowed", _schemagenQuote(_key))
				{{- else if $uneval.HasSchemaValuedUnevalProps}}
				{{- if $uneval.ValueIsNull}}
				{{- /* No Go type holds only null, so the raw bytes are what
				       decides -- the same reading uneval_items_check takes for
				       the same sub-schema. Both overflow maps hold
				       json.RawMessage, which is the value's own bytes. */}}
				if string(_member) != "null" {
					return jsonValueErrorf("unevaluated property %s: must be null", _schemagenQuote(_key))
				}
				{{- else if $uneval.ValueType}}
				var _uVal {{$uneval.ValueType}}
				if _uErr := {{if $uneval.ValueDecoder}}jsonDecodeHeld({{$recv}}._doc, _member, &_uVal, {{$uneval.ValueDecoder}}){{else}}json.Unmarshal(_member, &_uVal){{end}}; _uErr != nil {
					return jsonValueWrapf(_uErr, fmt.Sprintf("unevaluated property %s: ", _schemagenQuote(_key)))
				}
				{{- range $uneval.Validations}}
				{{- template "validation_rule_inline" .}}
				{{- end}}
				{{- end}}
				{{- end}}
			}
			return nil
		{{- template "least_key_close" $lk}}
		{{- end}}
	}
	{{- end}}
	{{- end}}
	return nil
}
{{- end}}

{{- /* item_validations emits the per-element checks for every slice the schema
       constrains through `items`, and every map it constrains through
       `additionalProperties`, whose element Go type carries no Validate of its
       own. The context is {Recv, Defs}: a receiver name and a
       []ItemValidationDef.

       A nil slice or map ranges zero times, so an absent optional property needs
       no presence guard; a *[]T does need one, since ranging over a dereferenced
       nil pointer panics. */}}
{{define "item_validations"}}
{{- $recv := .Recv}}
{{- range $iv := .Defs}}
{{- if $iv.IsPointer}}
if {{$recv}}.{{$iv.FieldName}} != nil {
{{- end}}
{{- template "item_level" (mkItemLevelCtx $recv $iv 0)}}
{{- if $iv.IsPointer}}
}
{{- end}}
{{- end}}
{{- end}}

{{- /* item_level emits one container level's loop and the checks that apply at
       that depth, then recurses into the level below it. A map level differs
       only in what the loop variable is -- a key rather than an index -- which
       itemPath already accounts for in the error format string. */}}
{{define "item_level"}}
{{- $recv := .Recv}}
{{- $iv := .Def}}
{{- $li := .Level}}
{{- $lv := index $iv.Levels $li}}
{{- $elem := itemElem $iv $li}}
{{- $path := itemPath $iv $li}}
{{- $errf := pathErrf $path}}
{{- $joinf := pathJoin $path}}
{{- $args := itemArgs $iv $li}}
{{- $container := itemRange $recv $iv $li}}
{{- /* A map level is refused for its least failing key rather than for
       whichever member Go's randomised map order reached first; see
       least_key_open. A slice level ranges in index order and needs nothing. */}}
{{- $lk := leastKey $lv.IndexVar $lv.ElemVar $container "_failed"}}
{{- if $lv.IsMap}}
{{- template "least_key_open" $lk}}
{{- else}}
for {{$lv.IndexVar}}, {{$lv.ElemVar}} := range {{$container}} {
{{- end}}
	{{- if $lv.ElemIsPointer}}
	if {{$lv.ElemVar}} == nil {
		{{if $lv.IsMap}}return nil{{else}}continue{{end}} // a JSON null left no value behind to check
	}
	{{- end}}
	{{- if $lv.CallValidate}}
	{{- /* Not the dereferenced form: *x.Validate() parses as *(x.Validate()).
	       A method call on a pointer needs no explicit indirection anyway. */}}
	if _err := {{$lv.ElemVar}}.Validate(); _err != nil {
		return {{$joinf}}(_err, "{{$path}}", {{$args}})
	}
	{{- end}}
	{{- range $lv.Rules}}
	{{- if eq .RuleType "minLength"}}
	if utf8.RuneCountInString(string({{$elem}})) < {{countExpr .Value}} {
		return {{$errf}}("{{$path}}: length %d is less than minimum {{fmtText .Value}}", {{$args}}, utf8.RuneCountInString(string({{$elem}})))
	}
	{{- end}}
	{{- if eq .RuleType "maxLength"}}
	if utf8.RuneCountInString(string({{$elem}})) > {{countExpr .Value}} {
		return {{$errf}}("{{$path}}: length %d exceeds maximum {{fmtText .Value}}", {{$args}}, utf8.RuneCountInString(string({{$elem}})))
	}
	{{- end}}
	{{- if eq .RuleType "pattern"}}
	if _matched, _mErr := {{patternVar .Value}}.matches(string({{$elem}})); _mErr != nil {
		return {{$errf}}("{{$path}}: %w", {{$args}}, _mErr)
	} else if !_matched {
		return {{$errf}}("{{$path}}: value %s does not match pattern %s", {{$args}}, _schemagenQuote(string({{$elem}})), {{printf "%q" .Value}})
	}
	{{- end}}
	{{- if eq .RuleType "minimum"}}
	{{- if .ExactCompare}}
	if {{numOperand . $elem}} < {{numBound .}} {
		return {{$errf}}("{{$path}}: value %v is less than minimum {{numBoundMsg .}}", {{$args}}, {{$elem}})
	}
	{{- else}}
	if float64({{$elem}}) < {{countExpr .Value}} {
		return {{$errf}}("{{$path}}: value %v is less than minimum {{fmtText .Value}}", {{$args}}, {{$elem}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "maximum"}}
	{{- if .ExactCompare}}
	if {{numOperand . $elem}} > {{numBound .}} {
		return {{$errf}}("{{$path}}: value %v exceeds maximum {{numBoundMsg .}}", {{$args}}, {{$elem}})
	}
	{{- else}}
	if float64({{$elem}}) > {{countExpr .Value}} {
		return {{$errf}}("{{$path}}: value %v exceeds maximum {{fmtText .Value}}", {{$args}}, {{$elem}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "exclusiveMinimum"}}
	{{- if .ExactCompare}}
	if {{numOperand . $elem}} <= {{numBound .}} {
		return {{$errf}}("{{$path}}: value %v must be greater than {{numBoundMsg .}}", {{$args}}, {{$elem}})
	}
	{{- else}}
	if float64({{$elem}}) <= {{countExpr .Value}} {
		return {{$errf}}("{{$path}}: value %v must be greater than {{fmtText .Value}}", {{$args}}, {{$elem}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "exclusiveMaximum"}}
	{{- if .ExactCompare}}
	if {{numOperand . $elem}} >= {{numBound .}} {
		return {{$errf}}("{{$path}}: value %v must be less than {{numBoundMsg .}}", {{$args}}, {{$elem}})
	}
	{{- else}}
	if float64({{$elem}}) >= {{countExpr .Value}} {
		return {{$errf}}("{{$path}}: value %v must be less than {{fmtText .Value}}", {{$args}}, {{$elem}})
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "multipleOf"}}
	{{- if .ExactCompare}}
	if !{{exactMultipleOf . $elem}} {
		return {{$errf}}("{{$path}}: value %v is not a multiple of {{numBoundMsg .}}", {{$args}}, {{$elem}})
	}
	{{- else}}
	{
		_q := float64({{$elem}}) / {{numLit .Value}}
		if math.Abs(_q - math.Round(_q)) > 1e-9 {
			return {{$errf}}("{{$path}}: value %v is not a multiple of {{fmtText .Value}}", {{$args}}, {{$elem}})
		}
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "minItems"}}
	if len({{$elem}}) < {{countExpr .Value}} {
		return {{$errf}}("{{$path}}: has %d items, minimum is {{fmtText .Value}}", {{$args}}, len({{$elem}}))
	}
	{{- end}}
	{{- if eq .RuleType "maxItems"}}
	if len({{$elem}}) > {{countExpr .Value}} {
		return {{$errf}}("{{$path}}: has %d items, maximum is {{fmtText .Value}}", {{$args}}, len({{$elem}}))
	}
	{{- end}}
	{{- if eq .RuleType "format"}}
	{{- /*
	An element's format, which reached nothing at all until now: elementRules
	dropped the keyword through its default arm, so
	{"items":{"type":"string","format":"ipv4"}} accepted an IPv6 address in
	every element while the identical subschema written as a property was
	checked. Same helper as every other position, chosen by StringBacked as
	usual -- the element is a netip.Addr where the format maps to one, and the
	JSON string where it does not.
	*/ -}}
	{{- template "string_format_check" (mkStringFormatCtxArgs (formatElemExpr $elem .StringBacked) $path $args .Value .StringBacked)}}
	{{- end}}
	{{- if eq .RuleType "content"}}
	{{- /*
	An element's content keywords, for the same reason and on the same terms:
	{"items":{"type":"string","contentEncoding":"base64"}} would otherwise be
	checked as a property and not as an element. The element is always the JSON
	string here -- elementRules keeps the rule only where the element's Go kind
	is "string" -- so there is no StringBacked question to ask.
	*/ -}}
	{{- template "string_content_check" (mkStringContentCtxArgs $elem $path $args .)}}
	{{- end}}
	{{- if eq .RuleType "const"}}
	{{- if .ExactCompare}}
	if {{exactConstViolated . $elem}} {
		return {{$errf}}("{{$path}}: value must be %s, got %s", {{$args}}, {{printf "%q" .Value}}, _schemagenClipText(fmt.Sprint({{$elem}})))
	}
	{{- else}}
	{
		_constGot, _constErr := json.Marshal({{$elem}})
		if _constErr != nil {
			return {{$errf}}("{{$path}}: failed to marshal for const check: %w", {{$args}}, _constErr)
		}
		if string(_constGot) != {{printf "%q" .Value}} {
			return {{$errf}}("{{$path}}: value must be %s, got %s", {{$args}}, {{printf "%q" .Value}}, _schemagenClipText(string(_constGot)))
		}
	}
	{{- end}}
	{{- end}}
	{{- if eq .RuleType "uniqueItems"}}
	{{- /*
	An element that is itself an array, judged the same way an array property
	and an array alias are judged: marshal each item and key a set by the JSON
	text, so 1 and 1.0 compare equal as the keyword requires. elementRules kept
	the keyword nowhere until now, so {"items":{"type":"array","items":
	{"type":"string"},"uniqueItems":true}} accepted [["a","a"]] while the
	minItems written beside it fired -- issue #179. The variable names are
	suffixed to keep them clear of the enclosing loops' _i/_e and of a nested
	level's own copy of this block.
	*/}}
	{
		_uqSeen := make(map[string]bool, len({{$elem}}))
		for _uqIdx, _uqItem := range {{$elem}} {
			_uqBytes, _uqErr := json.Marshal(_uqItem)
			if _uqErr != nil {
				return {{$errf}}("{{$path}}: uniqueItems check: marshal error at index %d: %w", {{$args}}, _uqIdx, _uqErr)
			}
			{{- if .RawElements}}
			// Raw elements, compared as JSON values rather than as the bytes
			// json.Marshal writes back unchanged. See _jsonCanonical.
			_uqKey, _uqErr := _jsonCanonical(_uqBytes)
			if _uqErr != nil {
				return {{$errf}}("{{$path}}: uniqueItems check: invalid JSON at index %d: %w", {{$args}}, _uqIdx, _uqErr)
			}
			if _uqSeen[_uqKey] {
				return {{$errf}}("{{$path}}: items are not unique (duplicate at index %d)", {{$args}}, _uqIdx)
			}
			_uqSeen[_uqKey] = true
			{{- else}}
			if _uqSeen[string(_uqBytes)] {
				return {{$errf}}("{{$path}}: items are not unique (duplicate at index %d)", {{$args}}, _uqIdx)
			}
			_uqSeen[string(_uqBytes)] = true
			{{- end}}
		}
	}
	{{- end}}
	{{- end}}
	{{- /* An element that is itself an array, and what `contains` says about
	       what it holds. The same check an array property gets, over this
	       level's element instead of a field, with the enclosing loop's indices
	       carried into the error path. */}}
	{{- if $lv.Contains}}
	{{- template "contains_check" (mkContainsCtxIn $elem (fmtCat $path ": contains") $args $lv.Contains $lv.MinContains $lv.MaxContains)}}
	{{- end}}
	{{- /* An element that is itself a tuple. The same checks an array property
	       gets, over this level's element instead of a field, with the enclosing
	       loop's indices carried into the error path. */}}
	{{- if $lv.HasTupleItems}}
	{{- template "tuple_items_check" (mkTupleCtxIn $elem (fmtCat $path ": items") $args $lv.TupleItems $lv.TupleTail)}}
	{{- end}}
	{{- if $lv.UnevalItems}}
	{{- template "uneval_items_check" (mkUnevalItemsCtxIn $elem (fmtCat $path ": unevaluatedItems") $args $lv.UnevalItems)}}
	{{- end}}
	{{- if lt (add $li 1) (len $iv.Levels)}}
	{{- template "item_level" (mkItemLevelCtx $recv $iv (add $li 1))}}
	{{- end}}
{{- if $lv.IsMap}}
	return nil
{{- template "least_key_close" $lk}}
{{- else}}
}
{{- end}}
{{- end}}

{{- /* validation_rule_inline emits a validation check on _uVal for a single rule.
       Used by schema-valued unevaluatedProperties to validate each overflow value.
       The variable _key (property name) is available for error messages. */}}
{{define "validation_rule_inline"}}
{{- if eq .RuleType "minLength"}}
				if utf8.RuneCountInString(_uVal) < {{countExpr .Value}} {
					return jsonValueErrorf("unevaluated property %s: length %d is less than minimum {{fmtText .Value}}", _schemagenQuote(_key), utf8.RuneCountInString(_uVal))
				}
{{- end}}
{{- if eq .RuleType "maxLength"}}
				if utf8.RuneCountInString(_uVal) > {{countExpr .Value}} {
					return jsonValueErrorf("unevaluated property %s: length %d exceeds maximum {{fmtText .Value}}", _schemagenQuote(_key), utf8.RuneCountInString(_uVal))
				}
{{- end}}
{{- if eq .RuleType "minimum"}}
{{- if .ExactCompare}}
				if {{numOperand . "_uVal"}} < {{numBound .}} {
					return jsonValueErrorf("unevaluated property %s: value %v is less than minimum {{numBoundMsg .}}", _schemagenQuote(_key), _uVal)
				}
{{- else}}
				if float64(_uVal) < {{countExpr .Value}} {
					return jsonValueErrorf("unevaluated property %s: value %v is less than minimum {{fmtText .Value}}", _schemagenQuote(_key), _uVal)
				}
{{- end}}
{{- end}}
{{- if eq .RuleType "maximum"}}
{{- if .ExactCompare}}
				if {{numOperand . "_uVal"}} > {{numBound .}} {
					return jsonValueErrorf("unevaluated property %s: value %v exceeds maximum {{numBoundMsg .}}", _schemagenQuote(_key), _uVal)
				}
{{- else}}
				if float64(_uVal) > {{countExpr .Value}} {
					return jsonValueErrorf("unevaluated property %s: value %v exceeds maximum {{fmtText .Value}}", _schemagenQuote(_key), _uVal)
				}
{{- end}}
{{- end}}
{{- if eq .RuleType "exclusiveMinimum"}}
{{- if .ExactCompare}}
				if {{numOperand . "_uVal"}} <= {{numBound .}} {
					return jsonValueErrorf("unevaluated property %s: value %v must be greater than {{numBoundMsg .}}", _schemagenQuote(_key), _uVal)
				}
{{- else}}
				if float64(_uVal) <= {{countExpr .Value}} {
					return jsonValueErrorf("unevaluated property %s: value %v must be greater than {{fmtText .Value}}", _schemagenQuote(_key), _uVal)
				}
{{- end}}
{{- end}}
{{- if eq .RuleType "exclusiveMaximum"}}
{{- if .ExactCompare}}
				if {{numOperand . "_uVal"}} >= {{numBound .}} {
					return jsonValueErrorf("unevaluated property %s: value %v must be less than {{numBoundMsg .}}", _schemagenQuote(_key), _uVal)
				}
{{- else}}
				if float64(_uVal) >= {{countExpr .Value}} {
					return jsonValueErrorf("unevaluated property %s: value %v must be less than {{fmtText .Value}}", _schemagenQuote(_key), _uVal)
				}
{{- end}}
{{- end}}
{{- if eq .RuleType "pattern"}}
				if _uMatched, _uMErr := {{patternVar .Value}}.matches(string(_uVal)); _uMErr != nil {
					return jsonValueErrorf("unevaluated property %s: %w", _schemagenQuote(_key), _uMErr)
				} else if !_uMatched {
					return jsonValueErrorf("unevaluated property %s: value does not match pattern %s", _schemagenQuote(_key), {{printf "%q" .Value}})
				}
{{- end}}
{{- if eq .RuleType "multipleOf"}}
{{- if .ExactCompare}}
				if !{{exactMultipleOf . "_uVal"}} {
					return jsonValueErrorf("unevaluated property %s: value %v is not a multiple of {{numBoundMsg .}}", _schemagenQuote(_key), _uVal)
				}
{{- else}}
				{
					_q := float64(_uVal) / {{numLit .Value}}
					if math.Abs(_q - math.Round(_q)) > 1e-9 {
						return jsonValueErrorf("unevaluated property %s: value %v is not a multiple of {{fmtText .Value}}", _schemagenQuote(_key), _uVal)
					}
				}
{{- end}}
{{- end}}
{{- end}}

{{/*
object_cond_branch renders the checks one side of an object-level if/then/else
puts on an object, given a context carrying the receiver name and the branch.

Each property is decoded on its own and judged by the same dyn_branch
expression the applicator evaluator uses, so what the branch demands does not
depend on the Go type the property was given -- or on whether the struct
declares a field for it at all.
*/}}
{{define "object_cond_branch"}}
{{- $recv := .Recv}}
{{- /* The keyword lands inside a Go format literal. "then" and "else" need no
       escaping; a dependentSchemas branch names its trigger, which is a
       property name and may carry a quote, a backslash or a percent sign. */}}
{{- $kw := jsonErrorName .Branch.Keyword}}
{{- range .Branch.RequiredKeys}}
			if _, _ok := {{$recv}}._jsonRawProps[{{printf "%q" .}}]; !_ok {
				return fmt.Errorf("{{$kw}}: required property %q is missing", {{printf "%q" .}})
			}
{{- end}}
{{- range .Branch.Properties}}
			if _raw, _ok := {{$recv}}._jsonRawProps[{{printf "%q" .JSONName}}]; _ok {
				_v, _err := jsonHeld({{$recv}}._doc, _raw)
				if _err != nil {
					return fmt.Errorf("{{$kw}}: property %q: cannot decode value: %w", {{printf "%q" .JSONName}}, _err)
				}
				_v = jsonTop(_v)
				{{- if dynChecksMatchPattern .Checks}}
				var _undecided error
				_branchOK := {{template "dyn_branch" .Checks}}
				if _undecided != nil {
					return fmt.Errorf("{{$kw}}: property %q: %w", {{printf "%q" .JSONName}}, _undecided)
				}
				if !_branchOK {
					return fmt.Errorf("{{$kw}}: property %q does not satisfy the {{$kw}} schema", {{printf "%q" .JSONName}})
				}
				{{- else}}
				if !({{template "dyn_branch" .Checks}}) {
					return fmt.Errorf("{{$kw}}: property %q does not satisfy the {{$kw}} schema", {{printf "%q" .JSONName}})
				}
				{{- end}}
			}
{{- end}}
{{- end}}

{{- /* contains_check emits the `contains` cardinality check for one array: it
       counts the elements matching the contains sub-schema and holds that count
       against minContains and maxContains.

       The context is {Expr, Path, Def, MinContains, MaxContains}. Expr is the Go
       expression naming the slice -- a receiver for an array alias, a field for
       an array property -- and Path is the prefix its errors are reported under.
       Sharing one definition is what lets an inline array *property* be checked
       at all: the property is never materialized as a named type, so it has no
       Validate of its own for the alias form of this check to hang off.

       Every test goes through json.Marshal rather than a type assertion, so the
       elements may be of any Go type the emitter produced -- []any, []int64,
       []string or a named element type alike. */}}
{{define "contains_check"}}
{{- $expr := .Expr}}
{{- $path := .Path}}
{{- $errf := pathErrf $path}}
{{- /* Args is what an enclosing loop contributes to the error path, on the same
       terms as tuple_items_check: an array that is another container's element
       reports under a path carrying that loop's verbs, and the variables that
       fill them go first in every Errorf below. A caller not inside such a loop
       passes "" and the emitted code is unchanged. */}}
{{- $args := argPrefix .Args}}
	// contains validation: count elements matching the contains sub-schema.
	{
		{{- /* contains: false is not a special case but the degenerate one: no
		       element ever matches, so the count stays at zero and the bounds
		       decide, exactly as they do for any other sub-schema. Returning
		       unconditionally instead would be wrong for a minContains of 0
		       beside a maxContains -- every array satisfies that -- and it
		       leaves the rest of Validate as unreachable code, which `go vet`
		       rejects in the generated file. */}}
		_containsCount := 0
		{{- if .Def.IsFalse}}
		// contains: false — no element can ever match, so the count stays at 0.
		{{- else if .Def.IsTrue}}
		_containsCount = len({{$expr}})
		{{- else if .Def.ConstJSON}}
		{{- if .Def.RawElements}}
		{{- /* The elements are the document's own bytes, so the match is decided
		       on the canonical text of each side rather than on the bytes: the
		       literal as the schema wrote it, every digit kept, against the
		       element reduced the same way. See ContainsDef.RawElements. */}}
		_cWant := _jsonCanonicalTexts([]string{ {{printf "%q" .Def.ConstJSON}} })[0]
		for _, _cElem := range {{$expr}} {
			_cBytes, _cErr := json.Marshal(_cElem)
			if _cErr != nil {
				continue
			}
			if _cCanon, _cCanonErr := _jsonCanonical(_cBytes); _cCanonErr == nil && _cCanon == _cWant {
				_containsCount++
			}
		}
		{{- else}}
		for _, _cElem := range {{$expr}} {
			_cBytes, _cErr := json.Marshal(_cElem)
			if _cErr == nil && string(_cBytes) == {{printf "%q" .Def.ConstJSON}} {
				_containsCount++
			}
		}
		{{- end}}
		{{- else if .Def.EnumJSON}}
		{{- if .Def.RawElements}}
		_cWant := _jsonCanonicalTexts([]string{
			{{- range .Def.EnumJSON}}
			{{printf "%q" .}},
			{{- end}}
		})
		for _, _cElem := range {{$expr}} {
			_cBytes, _cErr := json.Marshal(_cElem)
			if _cErr != nil {
				continue
			}
			_cCanon, _cCanonErr := _jsonCanonical(_cBytes)
			if _cCanonErr != nil {
				continue
			}
			for _, _cAllowed := range _cWant {
				if _cCanon == _cAllowed {
					_containsCount++
					break
				}
			}
		}
		{{- else}}
		for _, _cElem := range {{$expr}} {
			_cBytes, _cErr := json.Marshal(_cElem)
			if _cErr == nil {
				_cStr := string(_cBytes)
				{{- range .Def.EnumJSON}}
				if _cStr == {{printf "%q" .}} {
					_containsCount++
					continue
				}
				{{- end}}
			}
		}
		{{- end}}
		{{- else if .Def.TypeName}}
		{{- /*
		A sub-schema richer than the checks below can express. An element
		matches when it decodes into the type generated for that sub-schema and
		that type's own Validate passes; a failure at either step is not an
		error here, only an element that does not count. See ContainsDef.TypeName.
		*/}}
		for _, _cElem := range {{$expr}} {
			_cBytes, _cErr := json.Marshal(_cElem)
			if _cErr != nil {
				continue
			}
			var _cTyped {{.Def.TypeName}}
			if _cDErr := {{if .Def.StrictReadWrite}}_decodeIgnoringReadOnly{{else}}json.Unmarshal{{end}}(_cBytes, &_cTyped); _cDErr != nil {
				if _schemagenUndecided(_cDErr) {
					// An element that may or may not match leaves the count
					// unknown.
					return {{$errf}}("{{$path}}: %w", {{$args}}_cDErr)
				}
				continue
			}
			if _cVErr := _cTyped.Validate(); _cVErr != nil {
				if _schemagenUndecided(_cVErr) {
					return {{$errf}}("{{$path}}: %w", {{$args}}_cVErr)
				}
				continue
			}
			_containsCount++
		}
		{{- else if .Def.Checks}}
		for _, _cElem := range {{$expr}} {
			_cMatch := true
			{{- range .Def.Checks}}
			{{- if eq .CheckType "type"}}
			{{- if eq .Value "integer"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				var _cf float64
				if json.Unmarshal(_cBytes, &_cf) != nil || _cf != math.Trunc(_cf) {
					_cMatch = false
				}
			}
			{{- else if eq .Value "number"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				var _cf float64
				if json.Unmarshal(_cBytes, &_cf) != nil {
					_cMatch = false
				}
			}
			{{- else if eq .Value "string"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				if len(_cBytes) < 2 || _cBytes[0] != '"' {
					_cMatch = false
				}
			}
			{{- else if eq .Value "boolean"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				_cs := string(_cBytes)
				if _cs != "true" && _cs != "false" {
					_cMatch = false
				}
			}
			{{- else if eq .Value "null"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				if string(_cBytes) != "null" {
					_cMatch = false
				}
			}
			{{- else if eq .Value "array"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				if len(_cBytes) == 0 || _cBytes[0] != '[' {
					_cMatch = false
				}
			}
			{{- else if eq .Value "object"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				if len(_cBytes) == 0 || _cBytes[0] != '{' {
					_cMatch = false
				}
			}
			{{- end}}
			{{- /* Every keyword below judges one JSON type and says nothing about
			       any other: a numeric bound is satisfied by a string, a length
			       bound by a number, both by a null. So each arm reads the
			       element only when it is of that keyword's type, and otherwise
			       leaves _cMatch as it is. They used to count such an element as
			       a non-match -- {"contains":{"minimum":3}} refused ["a"] -- and
			       a null, which encoding/json decodes into a float64 as 0 and
			       into a string as "", was measured as that zero. */}}
			{{- else if eq .CheckType "minimum"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				if len(_cBytes) > 0 && (_cBytes[0] == '-' || _cBytes[0] >= '0' && _cBytes[0] <= '9') {
					{{- if $.Def.ExactNumbers}}
					var _cn jsonNumber
					if json.Unmarshal(_cBytes, &_cn) != nil || jsonNumberCmp(json.Number(_cn), {{jsonNumberLiteral .Value}}) < 0 {
						_cMatch = false
					}
					{{- else}}
					var _cf float64
					if json.Unmarshal(_cBytes, &_cf) != nil || _cf < {{countExpr .Value}} {
						_cMatch = false
					}
					{{- end}}
				}
			}
			{{- else if eq .CheckType "maximum"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				if len(_cBytes) > 0 && (_cBytes[0] == '-' || _cBytes[0] >= '0' && _cBytes[0] <= '9') {
					{{- if $.Def.ExactNumbers}}
					var _cn jsonNumber
					if json.Unmarshal(_cBytes, &_cn) != nil || jsonNumberCmp(json.Number(_cn), {{jsonNumberLiteral .Value}}) > 0 {
						_cMatch = false
					}
					{{- else}}
					var _cf float64
					if json.Unmarshal(_cBytes, &_cf) != nil || _cf > {{countExpr .Value}} {
						_cMatch = false
					}
					{{- end}}
				}
			}
			{{- else if eq .CheckType "exclusiveMinimum"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				if len(_cBytes) > 0 && (_cBytes[0] == '-' || _cBytes[0] >= '0' && _cBytes[0] <= '9') {
					{{- if $.Def.ExactNumbers}}
					var _cn jsonNumber
					if json.Unmarshal(_cBytes, &_cn) != nil || jsonNumberCmp(json.Number(_cn), {{jsonNumberLiteral .Value}}) <= 0 {
						_cMatch = false
					}
					{{- else}}
					var _cf float64
					if json.Unmarshal(_cBytes, &_cf) != nil || _cf <= {{countExpr .Value}} {
						_cMatch = false
					}
					{{- end}}
				}
			}
			{{- else if eq .CheckType "exclusiveMaximum"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				if len(_cBytes) > 0 && (_cBytes[0] == '-' || _cBytes[0] >= '0' && _cBytes[0] <= '9') {
					{{- if $.Def.ExactNumbers}}
					var _cn jsonNumber
					if json.Unmarshal(_cBytes, &_cn) != nil || jsonNumberCmp(json.Number(_cn), {{jsonNumberLiteral .Value}}) >= 0 {
						_cMatch = false
					}
					{{- else}}
					var _cf float64
					if json.Unmarshal(_cBytes, &_cf) != nil || _cf >= {{countExpr .Value}} {
						_cMatch = false
					}
					{{- end}}
				}
			}
			{{- else if eq .CheckType "multipleOf"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				if len(_cBytes) > 0 && (_cBytes[0] == '-' || _cBytes[0] >= '0' && _cBytes[0] <= '9') {
					{{- if $.Def.ExactNumbers}}
					var _cn jsonNumber
					if json.Unmarshal(_cBytes, &_cn) != nil || !jsonNumberIsMultipleOf(json.Number(_cn), {{jsonNumberLiteral .Value}}) {
						_cMatch = false
					}
					{{- else}}
					var _cf float64
					if json.Unmarshal(_cBytes, &_cf) != nil {
						_cMatch = false
					} else {
						_cq := _cf / {{numLit .Value}}
						if math.Abs(_cq - math.Round(_cq)) > 1e-9 {
							_cMatch = false
						}
					}
					{{- end}}
				}
			}
			{{- else if eq .CheckType "minLength"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				var _cs string
				if len(_cBytes) > 0 && _cBytes[0] == '"' && (json.Unmarshal(_cBytes, &_cs) != nil || len([]rune(_cs)) < {{countExpr .Value}}) {
					_cMatch = false
				}
			}
			{{- else if eq .CheckType "maxLength"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				var _cs string
				if len(_cBytes) > 0 && _cBytes[0] == '"' && (json.Unmarshal(_cBytes, &_cs) != nil || len([]rune(_cs)) > {{countExpr .Value}}) {
					_cMatch = false
				}
			}
			{{- else if eq .CheckType "pattern"}}
			if _cMatch {
				_cBytes, _ := json.Marshal(_cElem)
				var _cs string
				{{- /* A pattern constrains strings only, so an element that is not
				       one -- a number, a null, which encoding/json would decode
				       into a string as "" -- satisfies it and leaves _cMatch
				       as it is. It used to be counted as a non-match. */}}
				if len(_cBytes) > 0 && _cBytes[0] == '"' && json.Unmarshal(_cBytes, &_cs) == nil {
					if _cMatched, _cMErr := {{patternVar .Value}}.matches(_cs); _cMErr != nil {
						// An element that may or may not match leaves the count
						// unknown, so there is no verdict to give.
						return {{$errf}}("{{$path}}: %w", {{$args}}_cMErr)
					} else if !_cMatched {
						_cMatch = false
					}
				}
			}
			{{- end}}
			{{- end}}
			if _cMatch {
				_containsCount++
			}
		}
		{{- end}}
		{{- if and .MinContains (eq (countN .MinContains) 0)}}
		{{- /* minContains=0 means contains always passes for minContains check */}}
		{{- else if .MinContains}}
		if _containsCount < {{countExpr .MinContains}} {
			return {{$errf}}("{{$path}}: %d matching elements, minimum is {{countText .MinContains}}", {{$args}}_containsCount)
		}
		{{- else}}
		if _containsCount < 1 {
			return {{$errf}}("{{$path}}: no element matches the contains schema"{{if .Args}}, {{.Args}}{{end}})
		}
		{{- end}}
		{{- if .MaxContains}}
		if _containsCount > {{countExpr .MaxContains}} {
			return {{$errf}}("{{$path}}: %d matching elements, maximum is {{countText .MaxContains}}", {{$args}}_containsCount)
		}
		{{- end}}
	}
{{- end}}

{{- /* tuple_items_check emits the per-position checks of a tuple array: one
       arm per declared position, then one arm for everything past the prefix.

       The context is {Expr, Path, Args, Items, Tail, TailStart}. Expr is the Go
       expression naming the slice -- a receiver for an array alias, a field for
       an array property, an element variable for a tuple nested inside another
       array -- and Path the prefix its errors are reported under, with Args
       filling any verbs an enclosing loop put in that prefix.
       Sharing one definition is what lets an inline array *property* be checked
       at all: the property is never materialized as a named type, so it has no
       Validate of its own for the alias form of this check to hang off.

       Every arm reads the element as an `any`, which is what a tuple's slice
       always holds: no single Go element type can carry positions of different
       JSON types, so resolveType answers []any for any array whose positions
       prefixItems names. See isTupleArray. */}}
{{define "tuple_items_check"}}
	// Tuple items: validate each position against its schema type.
	for _idx, _elem := range {{.Expr}} {
		_ = _elem
		{{- if tupleHeld .Items .Tail}}
		// An element read lazily (see jsonLazyItemsOr) has its first level read
		// here, for the arms that ask its JSON type; a position of this
		// package's type decodes it from its span instead.
		_lz, _isLazy := _elem.(jsonLazy)
		if _isLazy {
			_elem = _lz.jsonLevel()
		}
		{{- end}}
		{{- $path := .Path}}
		{{- $args := .Args}}
		{{- range $i, $ti := .Items}}
		{{- template "tuple_item_case" (mkTupleCase (printf "_idx == %d" $i) $ti $path $args)}}
		{{- end}}
		{{- with .Tail}}
		{{- template "tuple_item_case" (mkTupleCase (printf "_idx >= %d" $.TailStart) . $path $args)}}
		{{- end}}
	}
{{- end}}

{{- /* tuple_item_case emits one arm of tuple_items_check: the guard naming the
       positions it governs, and the check those positions carry. The context is
       {Cond, Item, Path}. An item that constrains nothing emits nothing, which
       is what keeps a `true` position -- and the gaps in a tuple whose only
       content is its tail -- from producing an empty if. */}}
{{define "tuple_item_case"}}
{{- $path := .Path}}
{{- $errf := pathErrf $path}}
{{- $args := argPrefix .Args}}
{{- with .Item}}
{{- if .IsFalse}}
		if {{$.Cond}} {
			return {{$errf}}("{{$path}}[%d]: value is not allowed (schema is false)", {{$args}}_idx)
		}
{{- else if .TypeName}}
		{{- $wrapf := pathWrapf $path}}
		if {{$.Cond}} {
			var _typed {{.TypeName}}
			{{- if .Decoder}}
			var _uErr error
			if _isLazy {
				_uErr = jsonDecodeLazy(_lz, &_typed, {{.Decoder}})
			} else {
				_raw, _mErr := json.Marshal(_elem)
				if _mErr != nil {
					return {{$wrapf}}(_mErr, fmt.Sprintf("{{$path}}[%d]: ", {{$args}}_idx))
				}
				_uErr = jsonDecodeHeld(nil, _raw, &_typed, {{.Decoder}})
			}
			if _uErr != nil{{if .StrictReadWrite}} && !_isReadOnlyRefusal(_uErr){{end}} {
				return {{$wrapf}}(_uErr, fmt.Sprintf("{{$path}}[%d]: ", {{$args}}_idx))
			}
			{{- else}}
			_raw, _mErr := json.Marshal(_elem)
			if _mErr != nil {
				return {{$wrapf}}(_mErr, fmt.Sprintf("{{$path}}[%d]: ", {{$args}}_idx))
			}
			if _uErr := {{if .StrictReadWrite}}_decodeIgnoringReadOnly{{else}}json.Unmarshal{{end}}(_raw, &_typed); _uErr != nil {
				return {{$wrapf}}(_uErr, fmt.Sprintf("{{$path}}[%d]: ", {{$args}}_idx))
			}
			{{- end}}
			if _vErr := _typed.Validate(); _vErr != nil {
				return {{$wrapf}}(_vErr, fmt.Sprintf("{{$path}}[%d]: ", {{$args}}_idx))
			}
		}
{{- else if .JSONType}}
		if {{$.Cond}} {
			{{- if eq .JSONType "integer"}}
			_cv, _cvOk := _elem.(float64)
			if !_cvOk || _cv != math.Trunc(_cv) {
				return {{$errf}}("{{$path}}[%d]: expected integer, got %T", {{$args}}_idx, _elem)
			}
			{{- else if eq .JSONType "number"}}
			if _, _cvOk := _elem.(float64); !_cvOk {
				return {{$errf}}("{{$path}}[%d]: expected number, got %T", {{$args}}_idx, _elem)
			}
			{{- else if eq .JSONType "string"}}
			if _, _cvOk := _elem.(string); !_cvOk {
				return {{$errf}}("{{$path}}[%d]: expected string, got %T", {{$args}}_idx, _elem)
			}
			{{- else if eq .JSONType "boolean"}}
			if _, _cvOk := _elem.(bool); !_cvOk {
				return {{$errf}}("{{$path}}[%d]: expected boolean, got %T", {{$args}}_idx, _elem)
			}
			{{- else if eq .JSONType "null"}}
			if _elem != nil {
				return {{$errf}}("{{$path}}[%d]: expected null, got %T", {{$args}}_idx, _elem)
			}
			{{- else if eq .JSONType "array"}}
			if _, _cvOk := _elem.([]any); !_cvOk {
				return {{$errf}}("{{$path}}[%d]: expected array, got %T", {{$args}}_idx, _elem)
			}
			{{- else if eq .JSONType "object"}}
			if _, _cvOk := _elem.(map[string]any); !_cvOk {
				return {{$errf}}("{{$path}}[%d]: expected object, got %T", {{$args}}_idx, _elem)
			}
			{{- end}}
		}
{{- end}}
{{- end}}
{{- end}}

{{- /* uneval_items_check emits the static form of `unevaluatedItems`: every
       position past the ones the schema's own keywords evaluate must satisfy
       the sub-schema, or -- for unevaluatedItems: false -- must not exist.

       The context is {Expr, Path, Args, Def}, on the same terms as
       contains_check and tuple_items_check: one definition, and the caller says
       which slice it runs over and how its failures are named. That is what lets
       an inline array *property* be checked at all, since it never becomes a
       named type with a Validate of its own.

       Only the statically decidable shapes reach here. Where the evaluated set
       depends on which branches match the value -- unevaluatedItems beside an
       allOf, anyOf, oneOf or if -- the schema is routed to the runtime
       annotation evaluator instead and never produces an UnevaluatedItemsDef.
       See needsRuntimeAnnotations. */}}
{{define "uneval_items_check"}}
{{- $expr := .Expr}}
{{- $path := .Path}}
{{- $errf := pathErrf $path}}
{{- $args := argPrefix .Args}}
{{- $ctx := .}}
{{- with .Def}}
	// unevaluatedItems validation
	{
		evaluatedCount := {{.EvaluatedCount}}
		allEvaluated := {{if .AllEvaluated}}true{{else}}false{{end}}
		if !allEvaluated && len({{$expr}}) > evaluatedCount {
			{{- if .IsForbidden}}
			return {{$errf}}("{{$path}}: %d unevaluated items found (only %d items are evaluated)", {{$args}}len({{$expr}})-evaluatedCount, evaluatedCount)
			{{- else}}
			for _ui := evaluatedCount; _ui < len({{$expr}}); _ui++ {
				_uiElem := any({{$expr}}[_ui])
				_ = _uiElem
				{{- if .ValueType}}
				_uiBytes, _uiMarshalErr := json.Marshal(_uiElem)
				if _uiMarshalErr != nil {
					return {{$errf}}("{{$path}}[%d]: %w", {{$args}}_ui, _uiMarshalErr)
				}
				{{- if eq .ValueType "string"}}
				if len(_uiBytes) < 2 || _uiBytes[0] != '"' {
					return {{$errf}}("{{$path}}[%d]: must be a string", {{$args}}_ui)
				}
				{{- else if eq .ValueType "integer"}}
				var _uiNum float64
				if json.Unmarshal(_uiBytes, &_uiNum) != nil || _uiNum != math.Trunc(_uiNum) {
					return {{$errf}}("{{$path}}[%d]: must be an integer", {{$args}}_ui)
				}
				{{- else if eq .ValueType "number"}}
				var _uiNum float64
				if json.Unmarshal(_uiBytes, &_uiNum) != nil {
					return {{$errf}}("{{$path}}[%d]: must be a number", {{$args}}_ui)
				}
				{{- else if eq .ValueType "boolean"}}
				_uiString := string(_uiBytes)
				if _uiString != "true" && _uiString != "false" {
					return {{$errf}}("{{$path}}[%d]: must be a boolean", {{$args}}_ui)
				}
				{{- else if eq .ValueType "object"}}
				if len(_uiBytes) == 0 || _uiBytes[0] != '{' {
					return {{$errf}}("{{$path}}[%d]: must be an object", {{$args}}_ui)
				}
				{{- else if eq .ValueType "array"}}
				if len(_uiBytes) == 0 || _uiBytes[0] != '[' {
					return {{$errf}}("{{$path}}[%d]: must be an array", {{$args}}_ui)
				}
				{{- else if eq .ValueType "null"}}
				if string(_uiBytes) != "null" {
					return {{$errf}}("{{$path}}[%d]: must be null", {{$args}}_ui)
				}
				{{- end}}
				{{- end}}
				{{- template "uneval_item_checks" $ctx}}
			}
			{{- end}}
		}
	}
{{- end}}
{{- end}}

{{- /* uneval_item_checks emits the per-item checks a schema-valued
       `unevaluatedItems` states beside (or instead of) its `type`, over an
       element already bound to _uiElem as an `any`.

       It is one definition because there are two renderers of the keyword --
       uneval_items_check above, for an array that keeps a Go slice, and the
       block in inferred_alias.go.tmpl, for one that keeps []any -- and they had
       drifted: the inferred-alias copy carried `minimum` and `maximum` and
       nothing else, so `multipleOf` on an unevaluated item bound in one array
       shape and not in the other. The context is the UnevalItemsContext its two
       callers already build, for .Path, .Args and .Def.Checks.

       Which keywords can appear here is unevaluatedSubschemaKeywords, the list
       the leftover *property* check reads too. A sub-schema stating anything
       else never reaches either renderer -- generateTypeDef sends the whole
       schema to the runtime evaluator instead. That is what keeps the two
       keywords enforcing the same vocabulary rather than each its own.

       The string keywords read the element through json.Marshal rather than a
       type assertion, because the slice element may be a json.RawMessage or a
       named string type, neither of which a `.(string)` sees -- and a check that
       silently does not fire is the defect this whole family keeps producing.
       A value of any other JSON kind unmarshals into no string, and the keyword
       says nothing about it, so it passes. */}}
{{define "uneval_item_checks"}}
{{- $path := .Path}}
{{- $errf := pathErrf $path}}
{{- $args := argPrefix .Args}}
{{- range .Def.Checks}}
				{{- if eq .CheckType "minimum"}}
				if _uiNumVal, _uiOk := _uiElem.(float64); _uiOk && _uiNumVal < {{countExpr .Value}} {
					return {{$errf}}("{{$path}}[%d]: must be >= {{fmtText .Value}}", {{$args}}_ui)
				}
				{{- else if eq .CheckType "maximum"}}
				if _uiNumVal, _uiOk := _uiElem.(float64); _uiOk && _uiNumVal > {{countExpr .Value}} {
					return {{$errf}}("{{$path}}[%d]: must be <= {{fmtText .Value}}", {{$args}}_ui)
				}
				{{- else if eq .CheckType "exclusiveMinimum"}}
				if _uiNumVal, _uiOk := _uiElem.(float64); _uiOk && _uiNumVal <= {{countExpr .Value}} {
					return {{$errf}}("{{$path}}[%d]: must be > {{fmtText .Value}}", {{$args}}_ui)
				}
				{{- else if eq .CheckType "exclusiveMaximum"}}
				if _uiNumVal, _uiOk := _uiElem.(float64); _uiOk && _uiNumVal >= {{countExpr .Value}} {
					return {{$errf}}("{{$path}}[%d]: must be < {{fmtText .Value}}", {{$args}}_ui)
				}
				{{- else if eq .CheckType "multipleOf"}}
				if _uiNumVal, _uiOk := _uiElem.(float64); _uiOk {
					_uiQuot := _uiNumVal / {{numLit .Value}}
					if math.Abs(_uiQuot-math.Round(_uiQuot)) > 1e-9 {
						return {{$errf}}("{{$path}}[%d]: must be a multiple of {{fmtText .Value}}", {{$args}}_ui)
					}
				}
				{{- else if eq .CheckType "minLength"}}
				{
					_uiStrBytes, _ := json.Marshal(_uiElem)
					var _uiStrVal string
					if json.Unmarshal(_uiStrBytes, &_uiStrVal) == nil && utf8.RuneCountInString(_uiStrVal) < {{countExpr .Value}} {
						return {{$errf}}("{{$path}}[%d]: length %d is less than minimum {{fmtText .Value}}", {{$args}}_ui, utf8.RuneCountInString(_uiStrVal))
					}
				}
				{{- else if eq .CheckType "maxLength"}}
				{
					_uiStrBytes, _ := json.Marshal(_uiElem)
					var _uiStrVal string
					if json.Unmarshal(_uiStrBytes, &_uiStrVal) == nil && utf8.RuneCountInString(_uiStrVal) > {{countExpr .Value}} {
						return {{$errf}}("{{$path}}[%d]: length %d exceeds maximum {{fmtText .Value}}", {{$args}}_ui, utf8.RuneCountInString(_uiStrVal))
					}
				}
				{{- else if eq .CheckType "pattern"}}
				{
					_uiStrBytes, _ := json.Marshal(_uiElem)
					var _uiStrVal string
					{{- /* A string only: a null decodes into a Go string as "",
					       and a pattern says nothing about a null. */}}
					if len(_uiStrBytes) > 0 && _uiStrBytes[0] == '"' && json.Unmarshal(_uiStrBytes, &_uiStrVal) == nil {
						if _uiMatched, _uiMErr := {{patternVar .Value}}.matches(_uiStrVal); _uiMErr != nil {
							return {{$errf}}("{{$path}}[%d]: %w", {{$args}}_ui, _uiMErr)
						} else if !_uiMatched {
							return {{$errf}}("{{$path}}[%d]: value does not match pattern %s", {{$args}}_ui, {{printf "%q" .Value}})
						}
					}
				}
				{{- end}}
{{- end}}
{{- end}}


