		{{- if or (gt (len $uneval.EvaluatedNames) 0) $uneval.HasConditionalEvals}}
		evaluatedNames := map[string]bool{
			{{- range $uneval.EvaluatedNames}}
			{{printf "%q" .}}: true,
			{{- end}}
		}
		{{- end}}
		{{- if gt (len $uneval.EvaluatedPatterns) 0}}
		evaluatedPatterns := []*ecma262.Regexp{
			{{- range $uneval.EvaluatedPatterns}}
			ecma262.MustCompile({{ecmaPattern .}}, ecmaflags.Unicode),
			{{- end}}
		}
		{{- end}}
		{{- /* Runtime conditional branches: add properties to evaluated set dynamically. */}}
		{{- range $uneval.ConditionalEvals}}
		{{- if eq .Kind "dependentSchema"}}
		// dependentSchemas: {{.TriggerKey}} — only evaluated when trigger key is present.
		if {{$recv}}._jsonKeys[{{printf "%q" .TriggerKey}}] {
			{{- range .Branch.Names}}
			evaluatedNames[{{printf "%q" .}}] = true
			{{- end}}
		}
		{{- else if eq .Kind "ifThenElse"}}
		// if/then/else: evaluate if-condition at runtime, add then or else properties.
		{
			_ifMatch := true
			{{- range .IfBranch.RequiredKeys}}
			if !{{$recv}}._jsonKeys[{{printf "%q" .}}] {
				_ifMatch = false
			}
			{{- end}}
			{{- range .IfBranch.ConstChecks}}
			if _ifMatch {
				if _rv, _ok := {{$recv}}._jsonRawProps[{{printf "%q" .PropertyName}}]; !_ok || string(_rv) != {{printf "%q" .JSONValue}} {
					_ifMatch = false
				}
			}
			{{- end}}
			if _ifMatch {
				{{- if .ThenBranch}}
				{{- range .ThenBranch.Names}}
				evaluatedNames[{{printf "%q" .}}] = true
				{{- end}}
				{{- end}}
			} else {
				{{- if .ElseBranch}}
				{{- range .ElseBranch.Names}}
				evaluatedNames[{{printf "%q" .}}] = true
				{{- end}}
				{{- end}}
			}
		}
		{{- else if eq .Kind "anyOf"}}
		// anyOf: add evaluated properties from matching branches.
		{{- range $bi, $branch := .Branches}}
		{
			_branchMatch := true
			{{- range $branch.RequiredKeys}}
			if !{{$recv}}._jsonKeys[{{printf "%q" .}}] {
				_branchMatch = false
			}
			{{- end}}
			{{- range $branch.ConstChecks}}
			if _branchMatch {
				if _rv, _ok := {{$recv}}._jsonRawProps[{{printf "%q" .PropertyName}}]; !_ok || string(_rv) != {{printf "%q" .JSONValue}} {
					_branchMatch = false
				}
			}
			{{- end}}
			if _branchMatch {
				{{- range $branch.Names}}
				evaluatedNames[{{printf "%q" .}}] = true
				{{- end}}
			}
		}
		{{- end}}
		{{- else if eq .Kind "oneOf"}}
		// oneOf: add evaluated properties from the single matching branch.
		{
			_oneOfMatchCount := 0
			_oneOfMatchIdx := -1
			{{- range $bi, $branch := .Branches}}
			{
				_branchMatch := true
				{{- range $branch.RequiredKeys}}
				if !{{$recv}}._jsonKeys[{{printf "%q" .}}] {
					_branchMatch = false
				}
				{{- end}}
				{{- range $branch.ConstChecks}}
				if _branchMatch {
					if _rv, _ok := {{$recv}}._jsonRawProps[{{printf "%q" .PropertyName}}]; !_ok || string(_rv) != {{printf "%q" .JSONValue}} {
						_branchMatch = false
					}
				}
				{{- end}}
				if _branchMatch {
					_oneOfMatchCount++
					_oneOfMatchIdx = {{$bi}}
				}
			}
			{{- end}}
			// Presence-dependent: skip the exactly-one-branch hard-fail for
			// hand-constructed values (nil _jsonKeys), consistent with the
			// required-property policy.
			if {{$recv}}._jsonKeys != nil && _oneOfMatchCount != 1 {
				return fmt.Errorf("oneOf: expected exactly 1 matching branch, got %d", _oneOfMatchCount)
			}
			_ = _oneOfMatchIdx
			{{- range $bi, $branch := .Branches}}
			{{- if or $branch.Names $branch.Patterns $branch.AllEvaluated}}
			if _oneOfMatchIdx == {{$bi}} {
				{{- range $branch.Names}}
				evaluatedNames[{{printf "%q" .}}] = true
				{{- end}}
				{{- if $branch.AllEvaluated}}
				// Matching branch evaluates all properties.
				for _k := range {{$recv}}._jsonKeys {
					evaluatedNames[_k] = true
				}
				{{- end}}
				{{- range $branch.Patterns}}
				{
					_re := ecma262.MustCompile({{ecmaPattern .}}, ecmaflags.Unicode)
					for _k := range {{$recv}}._jsonKeys {
						if _re.MatchString(_k) {
							evaluatedNames[_k] = true
						}
					}
				}
				{{- end}}
			}
			{{- end}}
			{{- end}}
		}
		{{- end}}
		{{- end}}
		for k, v := range {{$recv}}.AdditionalProperties {
			evaluated := false
			_ = v
			{{- if or (gt (len $uneval.EvaluatedNames) 0) $uneval.HasConditionalEvals}}
			if evaluatedNames[k] {
				evaluated = true
			}
			{{- end}}
			{{- if gt (len $uneval.EvaluatedPatterns) 0}}
			if !evaluated {
				for _, re := range evaluatedPatterns {
					if re.MatchString(k) {
						evaluated = true
						break
					}
				}
			}
			{{- end}}
			if !evaluated {
				{{- if $uneval.IsForbidden}}
				return fmt.Errorf("unevaluated property %q is not allowed", k)
				{{- else if $uneval.HasSchemaValuedUnevalProps}}
				{{- if $uneval.ValueType}}
				var _uVal {{$uneval.ValueType}}
				if _uErr := json.Unmarshal(v, &_uVal); _uErr != nil {
					return fmt.Errorf("unevaluated property %q: %w", k, _uErr)
				}
				{{- range $uneval.Validations}}
				{{- template "validation_rule_inline" .}}
				{{- end}}
				{{- end}}
				{{- end}}
			}
		}
		{{- if $struct.HasPatternProperties}}
		for k, v := range {{$recv}}.PatternProperties {
			evaluated := false
			_ = v
			{{- if or (gt (len $uneval.EvaluatedNames) 0) $uneval.HasConditionalEvals}}
			if evaluatedNames[k] {
				evaluated = true
			}
			{{- end}}
			{{- if gt (len $uneval.EvaluatedPatterns) 0}}
			if !evaluated {
				for _, re := range evaluatedPatterns {
					if re.MatchString(k) {
						evaluated = true
						break
					}
				}
			}
			{{- end}}
			if !evaluated {
				{{- if $uneval.IsForbidden}}
				return fmt.Errorf("unevaluated property %q is not allowed", k)
				{{- else if $uneval.HasSchemaValuedUnevalProps}}
				{{- if $uneval.ValueType}}
				var _uVal {{$uneval.ValueType}}
				if _uErr := json.Unmarshal(v, &_uVal); _uErr != nil {
					return fmt.Errorf("unevaluated property %q: %w", k, _uErr)
				}
				{{- range $uneval.Validations}}
				{{- template "validation_rule_inline" .}}
				{{- end}}
				{{- end}}
				{{- end}}
			}
		}
		{{- end}}
	}
	{{- end}}
	{{- end}}
	return nil
}
{{- end}}

{{- /* item_validations emits the per-element checks for every slice the schema
       constrains through `items` but whose element Go type carries no Validate
       of its own. The context is {Recv, Defs}: a receiver name and a
       []ItemValidationDef.

       A nil slice ranges zero times, so an absent optional property needs no
       presence guard; a *[]T does need one, since ranging over a dereferenced
       nil pointer panics. */}}
{{define "item_validations"}}
{{- $recv := .Recv}}
{{- range $iv := .Defs}}
{{- if $iv.IsPointer}}
if {{$recv}}.{{$iv.FieldName}} != nil {
{{- end}}
{{- template "item_level" (mkItemLevelCtx $recv $iv 0)}}
{{- if $iv.IsPointer}}
}
{{- end}}
{{- end}}
{{- end}}

{{- /* item_level emits one array dimension's loop and the checks that apply at
       that depth, then recurses into the dimension below it. */}}
{{define "item_level"}}
{{- $recv := .Recv}}
{{- $iv := .Def}}
{{- $li := .Level}}
{{- $lv := index $iv.Levels $li}}
{{- $elem := itemElem $iv $li}}
{{- $path := itemPath $iv $li}}
{{- $args := itemArgs $iv $li}}
for {{$lv.IndexVar}}, {{$lv.ElemVar}} := range {{itemRange $recv $iv $li}} {
	{{- if $lv.ElemIsPointer}}
	if {{$lv.ElemVar}} == nil {
		continue // a JSON null left no value behind to check
	}
	{{- end}}
	{{- if $lv.CallValidate}}
	{{- /* Not the dereferenced form: *x.Validate() parses as *(x.Validate()).
	       A method call on a pointer needs no explicit indirection anyway. */}}
	if _err := {{$lv.ElemVar}}.Validate(); _err != nil {
		return fmt.Errorf("{{$path}}.%w", {{$args}}, _err)
	}
	{{- end}}
	{{- range $lv.Rules}}
	{{- if eq .RuleType "minLength"}}
	if utf8.RuneCountInString(string({{$elem}})) < {{.Value}} {
		return fmt.Errorf("{{$path}}: length %d is less than minimum {{.Value}}", {{$args}}, utf8.RuneCountInString(string({{$elem}})))
	}
	{{- end}}
	{{- if eq .RuleType "maxLength"}}
	if utf8.RuneCountInString(string({{$elem}})) > {{.Value}} {
		return fmt.Errorf("{{$path}}: length %d exceeds maximum {{.Value}}", {{$args}}, utf8.RuneCountInString(string({{$elem}})))
	}
	{{- end}}
	{{- if eq .RuleType "pattern"}}
	if _matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, string({{$elem}})); !_matched {
		return fmt.Errorf("{{$path}}: value %q does not match pattern %s", {{$args}}, {{$elem}}, {{printf "%q" .Value}})
	}
	{{- end}}
	{{- if eq .RuleType "minimum"}}
	if float64({{$elem}}) < {{.Value}} {
		return fmt.Errorf("{{$path}}: value %v is less than minimum {{.Value}}", {{$args}}, {{$elem}})
	}
	{{- end}}
	{{- if eq .RuleType "maximum"}}
	if float64({{$elem}}) > {{.Value}} {
		return fmt.Errorf("{{$path}}: value %v exceeds maximum {{.Value}}", {{$args}}, {{$elem}})
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMinimum"}}
	if float64({{$elem}}) <= {{.Value}} {
		return fmt.Errorf("{{$path}}: value %v must be greater than {{.Value}}", {{$args}}, {{$elem}})
	}
	{{- end}}
	{{- if eq .RuleType "exclusiveMaximum"}}
	if float64({{$elem}}) >= {{.Value}} {
		return fmt.Errorf("{{$path}}: value %v must be less than {{.Value}}", {{$args}}, {{$elem}})
	}
	{{- end}}
	{{- if eq .RuleType "multipleOf"}}
	{
		_q := float64({{$elem}}) / {{.Value}}
		if math.Abs(_q - math.Round(_q)) > 1e-9 {
			return fmt.Errorf("{{$path}}: value %v is not a multiple of {{.Value}}", {{$args}}, {{$elem}})
		}
	}
	{{- end}}
	{{- if eq .RuleType "minItems"}}
	if len({{$elem}}) < {{.Value}} {
		return fmt.Errorf("{{$path}}: has %d items, minimum is {{.Value}}", {{$args}}, len({{$elem}}))
	}
	{{- end}}
	{{- if eq .RuleType "maxItems"}}
	if len({{$elem}}) > {{.Value}} {
		return fmt.Errorf("{{$path}}: has %d items, maximum is {{.Value}}", {{$args}}, len({{$elem}}))
	}
	{{- end}}
	{{- if eq .RuleType "const"}}
	{
		_constGot, _constErr := json.Marshal({{$elem}})
		if _constErr != nil {
			return fmt.Errorf("{{$path}}: failed to marshal for const check: %w", {{$args}}, _constErr)
		}
		if string(_constGot) != {{printf "%q" .Value}} {
			return fmt.Errorf("{{$path}}: value must be %s, got %s", {{$args}}, {{printf "%q" .Value}}, string(_constGot))
		}
	}
	{{- end}}
	{{- end}}
	{{- if lt (add $li 1) (len $iv.Levels)}}
	{{- template "item_level" (mkItemLevelCtx $recv $iv (add $li 1))}}
	{{- end}}
}
{{- end}}

{{- /* validation_rule_inline emits a validation check on _uVal for a single rule.
       Used by schema-valued unevaluatedProperties to validate each overflow value.
       The variable k (property name) is available for error messages. */}}
{{define "validation_rule_inline"}}
{{- if eq .RuleType "minLength"}}
				if utf8.RuneCountInString(_uVal) < {{.Value}} {
					return fmt.Errorf("unevaluated property %q: length %d is less than minimum {{.Value}}", k, utf8.RuneCountInString(_uVal))
				}
{{- end}}
{{- if eq .RuleType "maxLength"}}
				if utf8.RuneCountInString(_uVal) > {{.Value}} {
					return fmt.Errorf("unevaluated property %q: length %d exceeds maximum {{.Value}}", k, utf8.RuneCountInString(_uVal))
				}
{{- end}}
{{- if eq .RuleType "minimum"}}
				if float64(_uVal) < {{.Value}} {
					return fmt.Errorf("unevaluated property %q: value %v is less than minimum {{.Value}}", k, _uVal)
				}
{{- end}}
{{- if eq .RuleType "maximum"}}
				if float64(_uVal) > {{.Value}} {
					return fmt.Errorf("unevaluated property %q: value %v exceeds maximum {{.Value}}", k, _uVal)
				}
{{- end}}
{{- if eq .RuleType "exclusiveMinimum"}}
				if float64(_uVal) <= {{.Value}} {
					return fmt.Errorf("unevaluated property %q: value %v must be greater than {{.Value}}", k, _uVal)
				}
{{- end}}
{{- if eq .RuleType "exclusiveMaximum"}}
				if float64(_uVal) >= {{.Value}} {
					return fmt.Errorf("unevaluated property %q: value %v must be less than {{.Value}}", k, _uVal)
				}
{{- end}}
{{- if eq .RuleType "pattern"}}
				{
					if matched, _ := ecma262.MatchString({{ecmaPattern .Value}}, ecmaflags.Unicode, _uVal); !matched {
						return fmt.Errorf("unevaluated property %q: value does not match pattern %s", k, {{printf "%q" .Value}})
					}
				}
{{- end}}
{{- if eq .RuleType "multipleOf"}}
				{
					_q := float64(_uVal) / {{.Value}}
					if math.Abs(_q - math.Round(_q)) > 1e-9 {
						return fmt.Errorf("unevaluated property %q: value %v is not a multiple of {{.Value}}", k, _uVal)
					}
				}
{{- end}}
{{- end}}

{{/*
object_cond_branch renders the checks one side of an object-level if/then/else
puts on an object, given a context carrying the receiver name and the branch.

Each property is decoded on its own and judged by the same dyn_branch
expression the applicator evaluator uses, so what the branch demands does not
depend on the Go type the property was given -- or on whether the struct
declares a field for it at all.
*/}}
{{define "object_cond_branch"}}
{{- $recv := .Recv}}
{{- $kw := .Branch.Keyword}}
{{- range .Branch.RequiredKeys}}
			if _, _ok := {{$recv}}._jsonRawProps[{{printf "%q" .}}]; !_ok {
				return fmt.Errorf("{{$kw}}: required property %q is missing", {{printf "%q" .}})
			}
{{- end}}
{{- range .Branch.Properties}}
			if _raw, _ok := {{$recv}}._jsonRawProps[{{printf "%q" .JSONName}}]; _ok {
				var _v any
				if _err := json.Unmarshal(_raw, &_v); _err != nil {
					return fmt.Errorf("{{$kw}}: property %q: cannot decode value: %w", {{printf "%q" .JSONName}}, _err)
				}
				if !({{template "dyn_branch" .Checks}}) {
					return fmt.Errorf("{{$kw}}: property %q does not satisfy the {{$kw}} schema", {{printf "%q" .JSONName}})
				}
			}
{{- end}}
{{- end}}
