{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemagen.test/boundary-anchor/main",
  "type": "object",
  "properties": {
    "first": { "$ref": "firstBox" },
    "second": { "$ref": "secondBox" }
  },
  "$defs": {
    "genericBox": {
      "$id": "genericBox",
      "type": "object",
      "properties": { "value": { "$dynamicRef": "#itemType" } },
      "required": ["value"],
      "$defs": { "defaultItemType": { "$dynamicAnchor": "itemType" } }
    },
    "firstBox": { "$id": "firstBox", "$ref": "genericBox" },
    "secondBox": { "$id": "secondBox", "$ref": "genericBox" },
    "stray": { "$id": "strayItemType", "$dynamicAnchor": "itemType", "type": "number" }
  }
}
