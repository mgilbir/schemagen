{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Issue #205 at `else`, the other side of the same conditional group.",
  "type": "object",
  "properties": {
    "t": {
      "type": "integer"
    }
  },
  "if": {
    "properties": {
      "t": {
        "const": 1
      }
    },
    "required": [
      "t"
    ]
  },
  "else": {
    "properties": {
      "p": {
        "type": "string",
        "format": "email"
      }
    },
    "required": [
      "p"
    ]
  }
}
