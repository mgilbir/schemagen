    "beside": {"type": "string", "$ref": "#/$defs/never"},
    "list": {"type": "array", "items": {"$ref": "#/$defs/never"}},
    "map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/never"}},
    "tuple": {"type": "array", "prefixItems": [{"$ref": "#/$defs/never"}]},
    "always": {"$ref": "#/$defs/always"},
    "alwaysAllOf": {"allOf": [{"$ref": "#/$defs/always"}]},
    "alwaysList": {"type": "array", "items": {"$ref": "#/$defs/always"}}
