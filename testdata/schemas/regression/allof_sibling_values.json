    "numberSpelling": {"type": "number", "enum": [1.0, 2], "allOf": [{"enum": [1, 3]}]},
    "agrees": {"type": "string", "enum": ["a", "b"], "allOf": [{"enum": ["b", "a"]}]},
    "silentBranch": {"type": "string", "enum": ["a", "b"], "allOf": [{"minLength": 1}]},
    "mapValues": {
      "type": "object",
      "additionalProperties": {"type": "string", "enum": ["a", "b"], "allOf": [{"enum": ["b"]}]}
    },
    "listItems": {
