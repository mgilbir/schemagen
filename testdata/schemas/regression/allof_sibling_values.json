    "constInBranch": {"type": "string", "enum": ["p", "q"], "allOf": [{"const": "q"}]},
    "constOnProperty": {"type": "string", "const": "q", "allOf": [{"enum": ["p", "q"]}]},
    "chain": {"type": "string", "enum": ["a", "b", "c"], "allOf": [{"enum": ["a", "b"]}, {"enum": ["b", "c"]}]},
    "laterBranchNarrows": {"type": "string", "enum": ["a", "b"], "allOf": [{"enum": ["a", "b"]}, {"enum": ["b"]}]},
    "nestedChain": {"type": "string", "enum": ["a", "b", "c"], "allOf": [{"allOf": [{"enum": ["b", "c"]}, {"enum": ["c"]}]}]},
